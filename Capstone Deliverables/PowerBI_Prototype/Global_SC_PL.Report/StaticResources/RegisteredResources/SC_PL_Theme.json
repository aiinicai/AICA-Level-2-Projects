{
  "name": "Global SC P&L - Template Teal",
  "dataColors": [
    "#008F94",
    "#C00000",
    "#6E6E6E",
    "#75CDC7",
    "#0B5D62",
    "#E0A100",
    "#1E8E3E",
    "#8A94A0"
  ],
  "foreground": "#333333",
  "foregroundNeutralSecondary": "#6B7280",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F7FA",
  "backgroundNeutral": "#DDF3F1",
  "tableAccent": "#008F94",
  "good": "#1E8E3E",
  "neutral": "#E0A100",
  "bad": "#C62828",
  "maximum": "#008F94",
  "center": "#DDF3F1",
  "minimum": "#C62828",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#333333"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#008F94"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#333333"
    },
    "callout": {
      "fontFace": "Segoe UI Bold",
      "fontSize": 24,
      "color": "#333333"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D0D7DE"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "foreground": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#008F94"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "textSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#008F94"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#008F94"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#333333"
              }
            }
          }
        ]
      }
    }
  }
}