			    & "<text x='231' y='46' font-size='10.5' font-weight='600' fill='%236B7280'>YTD</text><text x='231' y='73' font-size='22' font-weight='700' fill='%23333333'>"
			    & _c0yvt
			    & "</text><text x='231' y='97' font-size='10.5' fill='%236B7280'>vs Bud</text><text x='279' y='97' font-size='11' font-weight='700' fill='"
			    & _c0ybc
