			VAR _c2ybc = IF ( ISBLANK ( _c2yb ), "%236B7280", IF ( _c2yb * 1 >= 0, "%231E8E3E", "%23C62828" ) )
			VAR _c2yl = [PPV% | YTD vs LY]
