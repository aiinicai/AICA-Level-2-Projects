			    & _c0mbc
			    & "'>"
			    & _c0mbt
			    & "</text><text x='14' y='117' font-size='10.5' fill='%236B7280'>vs LY</text><text x='62' y='117' font-size='11' font-weight='700' fill='"
			    & _c0mlc
