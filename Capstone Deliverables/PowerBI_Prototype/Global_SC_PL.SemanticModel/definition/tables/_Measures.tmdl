			    & "<text x='16' y='25' font-size='13.5' font-weight='700' fill='%23333333'>Factory (under)/over recovery</text><text x='438' y='24' text-anchor='end' font-size='10.5' font-weight='600' fill='%236B7280'>"
			    & _c1unit
