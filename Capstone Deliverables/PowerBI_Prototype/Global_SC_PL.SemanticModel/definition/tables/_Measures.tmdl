		formatStringDefinition = IF ( SELECTEDVALUE ( PL_Layout[Format] ) = "%", "0.0%", "#,0" )

	measure 'P&L vs Bud %' =
			VAR _p = [Reporting Period]
			VAR _per = SELECTEDVALUE ( 'Period Mode'[Period], "Monthly" )
			VAR _a = CALCULATE (
			        [P&L Row Value],
			        'CG Scenario'[Comparison] = "Actual",
			        'CG Period'[Period] = _per,
			        FILTER ( ALL ( Dim_Date ), Dim_Date[Period] = _p )
			    )
			VAR _b = CALCULATE (
			        [P&L Row Value],
			        'CG Scenario'[Comparison] = "Budget",
			        'CG Period'[Period] = _per,
			        FILTER ( ALL ( Dim_Date ), Dim_Date[Period] = _p )
			    )
			RETURN
			    IF (
			        ISBLANK ( _a ) || ISBLANK ( _b ), BLANK (),
			        IF ( SELECTEDVALUE ( PL_Layout[Format] ) = "%", ( _a - _b ) * 100, DIVIDE ( _a - _b, ABS ( _b ) ) )
			    )
		displayFolder: 5 Detailed P&L
		lineageTag: 584710f9-85e3-479c-bbbc-2bf0f3d4bb52

		formatStringDefinition = IF ( SELECTEDVALUE ( PL_Layout[Format] ) = "%", "+0.00"" pp"";-0.00"" pp""", "+0.0%;-0.0%;0.0%" )

	measure 'P&L vs LY %' =
