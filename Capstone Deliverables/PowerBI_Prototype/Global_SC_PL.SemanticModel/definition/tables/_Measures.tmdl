			VAR _c0mbc = IF ( ISBLANK ( _c0mb ), "%236B7280", IF ( _c0mb * -1 >= 0, "%231E8E3E", "%23C62828" ) )
			VAR _c0ml = [FcPP | vs LY]
			VAR _c0mlt = IF ( ISBLANK ( _c0ml ), "n.a", IF ( _c0ml >= 0, "▲ ", "▼ " ) & SUBSTITUTE ( FORMAT ( _c0ml, "+0.0%;-0.0%;0.0%" ), "%", "%25" ) )
			VAR _c0mlc = IF ( ISBLANK ( _c0ml ), "%236B7280", IF ( _c0ml * -1 >= 0, "%231E8E3E", "%23C62828" ) )
			VAR _c0yb = [FcPP | YTD vs Bud]
			VAR _c0ybt = IF ( ISBLANK ( _c0yb ), "n.a", IF ( _c0yb >= 0, "▲ ", "▼ " ) & SUBSTITUTE ( FORMAT ( _c0yb, "+0.0%;-0.0%;0.0%" ), "%", "%25" ) )
			VAR _c0ybc = IF ( ISBLANK ( _c0yb ), "%236B7280", IF ( _c0yb * -1 >= 0, "%231E8E3E", "%23C62828" ) )
			VAR _c0yl = [FcPP | YTD vs LY]
