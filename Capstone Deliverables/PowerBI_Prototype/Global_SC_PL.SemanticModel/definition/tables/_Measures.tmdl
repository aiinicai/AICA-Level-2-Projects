	measure 'Alert GP Margin' =
			VAR _a = [Gross Margin %]
			VAR _b = CALCULATE ( [Gross Margin %], 'CG Scenario'[Comparison] = "Budget" )
			VAR _ly = CALCULATE ( [Gross Margin %], 'CG Scenario'[Comparison] = "LY" )
			RETURN
			    IF ( ISBLANK ( _a ), BLANK (),
			        IF ( ( NOT ISBLANK ( _b ) && _a - _b < -0.01 ) || ( NOT ISBLANK ( _ly ) && _a - _ly < -0.01 ), "Red", "Green" ) )
		displayFolder: 7 Alerts & OpCo
		lineageTag: 4f2614b8-ee3b-43a9-b996-bf5595409597

	measure 'Alert EBITDA' = IF ( ISBLANK ( [Net Turnover SC] ), BLANK (), IF ( [EBITDA] < 0, "Red", "Green" ) )
		displayFolder: 7 Alerts & OpCo
		lineageTag: f85feb0c-9d17-443d-a0ea-d721640008b2

	measure 'Alert Freight' =
			VAR _a = [Freight Cost per Pair]
			VAR _ly = CALCULATE ( [Freight Cost per Pair], 'CG Scenario'[Comparison] = "LY" )
			RETURN IF ( ISBLANK ( _a ), BLANK (), IF ( DIVIDE ( _a - _ly, _ly ) > 0.10, "Amber", "Green" ) )
		displayFolder: 7 Alerts & OpCo
		lineageTag: bf731b06-2603-4a35-9f10-51edbc085e21

	measure 'Alert PPV' =
			VAR _a = [PPV]
			VAR _b = CALCULATE ( [PPV], 'CG Scenario'[Comparison] = "Budget" )
			RETURN IF ( ISBLANK ( _b ), BLANK (), IF ( DIVIDE ( _a - _b, ABS ( _b ) ) < -0.05, "Amber", "Green" ) )
		displayFolder: 7 Alerts & OpCo
		lineageTag: cb079fcc-91c2-4c24-b99f-ac0e84955c39

	measure 'Alert Recovery' =
			VAR _a = [Recoveries of Factory]
			VAR _b = CALCULATE ( [Recoveries of Factory], 'CG Scenario'[Comparison] = "Budget" )
			RETURN IF ( ISBLANK ( _b ), BLANK (), IF ( ABS ( DIVIDE ( _a - _b, _b ) ) > 0.10, "Red", "Green" ) )
