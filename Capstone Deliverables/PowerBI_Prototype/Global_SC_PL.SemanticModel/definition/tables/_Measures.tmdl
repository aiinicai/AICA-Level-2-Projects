			        'CG Period'[Period] = "Monthly",
			        FILTER ( ALL ( Dim_Date ), Dim_Date[Period] = _p )
			    )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Summary Cards
		lineageTag: d605f9fc-3644-400c-b85e-fe7e3f938cee

