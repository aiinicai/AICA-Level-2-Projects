{
  "name": "imprest-settlement-app",
  "version": "1.0.0",
  "description": "Imprest & Settlement workflow app with real login, sessions, persisted data, and task assignment.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/ImprestApp.exe"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^2.0.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "full-icu": "^1.6.0"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/pdfkit/js/data/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  }
}
