# Client data must never be committed
input/*
!input/.gitkeep
OUTPUT_WORKPAPERS/
output/
*.duckdb

# Per-machine settings (may contain client user IDs)
je_config.json

# Python / build artefacts
__pycache__/
*.pyc
build/
dist/
*.exe
.venv/
venv/

# Office temp files
~$*
.claude/

# Word documents for personal use (never uploaded)
*.docx
Word documents (not uploaded)/
*.pdf

# Vendor secrets - NEVER upload (anyone with the private key can create licences)
vendor/
# Customer user file (password hashes, licence keys) and built releases
users.json
release/

# Sample Excel copies are kept locally / in the release; CSV copies go to Git
sample_data/**/*.xlsx
