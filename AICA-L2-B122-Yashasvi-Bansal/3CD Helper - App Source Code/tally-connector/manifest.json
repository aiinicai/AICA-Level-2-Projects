{
  "manifest_version": 3,
  "name": "3CD Helper \u2013 Tally Connector",
  "short_name": "3CD Tally",
  "version": "1.0.4",
  "description": "Brings Day Book and loan data from TallyPrime (running on this computer) into 3CD Helper, and fills the GSTIN on the GST portal's taxpayer search. Reads only; never changes Tally.",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "3CD Helper \u2013 Tally Connector",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://clause44-3cd-helper.lovable.app/*",
        "https://preview--clause44-3cd-helper.lovable.app/*",
        "https://id-preview--91f452ce-dbc9-4bb3-8511-12c6d09e2db0.lovable.app/*",
        "https://91f452ce-dbc9-4bb3-8511-12c6d09e2db0.lovableproject.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://services.gst.gov.in/services/searchtp*"
      ],
      "js": [
        "gst.js"
      ],
      "run_at": "document_idle"
    }
  ]
}