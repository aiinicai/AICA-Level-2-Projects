/* ─── Monthly ─────────────────────────────────────────── */
function renderMonthly() {
  if (!assets.length) return;
  const fy = assets[0].fy;
  const { start } = fyDates(fy);
  const MONTH_LABELS = Array.from({length:12}, (_,i) => {
    const d = new Date(start.getFullYear(), start.getMonth()+i, 1);
    return d.toLocaleString('en-IN',{month:'short',year:'2-digit'});
  });
  const GRP_COLORS = ['#eff6ff','#f0fdf4','#fefce8','#fdf4ff','#fff7ed','#f0fdfa'];
  const GRP_BORDER = ['#2563eb','#16a34a','#ca8a04','#9333ea','#ea580c','#0d9488'];
  const groups = {};
  assets.forEach(a => { (groups[a.group]=groups[a.group]||[]).push(a); });

  const monthTotals = new Array(12).fill(0);
  let grandTotal = 0;
  // Pre-calc all
  const allCalcs = {};
  assets.forEach(a => { allCalcs[a.id] = calcDepreciation(a); });
  assets.forEach(a => { const d=allCalcs[a.id]; for(let m=0;m<12;m++) monthTotals[m]+=(d.monthlyDep[m]||0); grandTotal+=d.annualDep; });

  let html = `<div class="table-wrap"><table><thead>
    <tr style="background:linear-gradient(135deg,#0f1f3d,#1a3260)">
      <th style="color:#fff">Asset ID</th>
      <th style="color:#fff">Asset Name</th>`;
  MONTH_LABELS.forEach(m => html += `<th class="right" style="color:#bfdbfe">${m}</th>`);
  html += `<th class="right" style="color:#6ee7b7">Total FY</th></tr></thead><tbody>`;

  let grpIdx=0;
  Object.entries(groups).forEach(([grp, gassets]) => {
    const bg=GRP_COLORS[grpIdx%GRP_COLORS.length], brd=GRP_BORDER[grpIdx%GRP_BORDER.length]; grpIdx++;
    const gTotal = gassets.reduce((s,a)=>s+allCalcs[a.id].annualDep,0);
    const gMonths = Array.from({length:12},(_,m)=>gassets.reduce((s,a)=>s+(allCalcs[a.id].monthlyDep[m]||0),0));
    html += `<tr style="background:${brd};color:#fff">
      <td colspan="2" style="font-weight:700;padding:8px 13px;font-size:12px">📁 ${grp}</td>`;
    gMonths.forEach(v => html += `<td class="num" style="color:#fde68a;font-weight:600">${v>0?INR(v):'—'}</td>`);
    html += `<td class="num" style="color:#6ee7b7;font-weight:700">${INR(gTotal)}</td></tr>`;
    gassets.forEach((a,ri) => {
      const d=allCalcs[a.id], rowT=d.annualDep;
      html += `<tr style="background:${ri%2===0?bg:'#fff'};border-left:3px solid ${brd}">
        <td><code style="font-size:11px;color:#64748b">${a.id}</code></td>
        <td style="font-size:12px">${a.name}</td>`;
      for(let m=0;m<12;m++){
        const dep=d.monthlyDep[m]||0;
        html += dep>0
          ? `<td class="num" style="font-size:12px">${INR(dep)}</td>`
          : `<td class="num" style="color:#cbd5e1;font-size:11px">—</td>`;
      }
      html += `<td class="num" style="color:#16a34a;font-weight:700">${rowT>0?INR(rowT):'—'}</td></tr>`;
    });
  });
  html += `</tbody><tfoot><tr style="background:linear-gradient(135deg,#0f1f3d,#1a3260);color:#fff">
    <td colspan="2" style="font-weight:700">MONTHLY TOTAL</td>`;
  monthTotals.forEach(t => html += `<td class="num" style="color:#fca5a5">${t>0?INR(t):'—'}</td>`);
  html += `<td class="num" style="color:#6ee7b7;font-size:15px">${INR(grandTotal)}</td></tr></tfoot></table></div>`;
  document.getElementById('monthly-table').innerHTML = html;
}

