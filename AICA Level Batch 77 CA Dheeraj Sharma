    html += `<div class="asset-card" style="border-color:${borderColor};background:${bgColor};flex-direction:column;align-items:stretch;gap:8px;">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;">
        <div class="asset-info">
          <strong>${a.name || '—'}</strong>
          <small>${a.id} | ${a.group || '—'} | FY ${a.fy || '—'} | PTU: ${a.ptu || '❌ MISSING'}</small>
