// Apply Schedule II values to the form
function applyScheduleII(method) {
  const grp = document.getElementById('f_group').value;
  const data = SCHEDULE_II[grp];
  if (!data) return;

  // Set method
  document.getElementById('f_method').value = method;
  toggleMethodFields();

  if (method === 'SLM') {
    document.getElementById('f_life').value = data.slmLife;
    document.getElementById('f_rate').value = '';
  } else {
    document.getElementById('f_rate').value = data.wdvRate;
    document.getElementById('f_life').value = '';
  }

  // Set salvage %
  document.getElementById('f_salvage_pct').value = data.salvagePct;
  syncSalvagePctToAmt();

  showToast('✅ Schedule II values applied — ' + method + ' | Life: ' + data.slmLife + ' yrs | WDV: ' + data.wdvRate + '% | Salvage: ' + data.salvagePct + '%', 'success');
}

// Sync salvage % → ₹ amount (uses cost field)
function syncSalvagePctToAmt() {
  const pct  = parseFloat(document.getElementById('f_salvage_pct').value) || 0;
  const cost = parseFloat(document.getElementById('f_cost').value)        || 0;
  document.getElementById('f_salvage').value = cost > 0 ? (cost * pct / 100).toFixed(2) : 0;
}

// Sync ₹ amount → salvage % (reverse)
function syncSalvageAmtToPct() {
  const amt  = parseFloat(document.getElementById('f_salvage').value) || 0;
  const cost = parseFloat(document.getElementById('f_cost').value)    || 0;
  document.getElementById('f_salvage_pct').value = cost > 0 ? (amt / cost * 100).toFixed(2) : 0;
}

