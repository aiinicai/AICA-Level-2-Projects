<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Depreciation Calculator – D S M K & Associates, Chartered Accountants</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css"/>
<style>
/* ─── Variables ─────────────────────────────────────── */
:root {
  /* ── Homepage indigo/gold palette ── */
  --navy:         #3C3489;
  --navy2:        #534AB7;
  --blue:         #3C3489;
  --blue-light:   #EEEDFE;
  --teal:         #4f46e5;
  --teal-light:   #e0e7ff;
  --amber:        #C8A96E;
  --amber-light:  #FAF3E0;
  --red:          #dc2626;
  --red-light:    #fee2e2;
  --green:        #16a34a;
  --green-light:  #dcfce7;
  --gray-50:      #F7F6FC;
  --gray-100:     #EEEDFE;
  --gray-200:     #E8E6F5;
  --gray-300:     #d1cef0;
  --gray-500:     #6B6882;
  --gray-700:     #1A1733;
  --gray-900:     #1A1733;
  --white:        #FFFFFF;
  --gold:         #C8A96E;
  --gold-light:   #EDD9A3;
  --shadow:       0 4px 24px rgba(60,52,137,.10);
  --shadow-lg:    0 8px 40px rgba(60,52,137,.16);
  --radius:       12px;
  --radius-sm:    8px;
}

* { margin:0; padding:0; box-sizing:border-box; }

body {
  font-family:'DM Sans',sans-serif;
  background: var(--gray-50);
  color: var(--gray-900);
  min-height:100vh;
  font-size:14px;
}

/* ─── Header ─────────────────────────────────────────── */
header {
  background: linear-gradient(135deg,#1E1A50 0%,#3C3489 45%,#534AB7 75%,#7F77DD 100%);
  color:#fff;
  padding:0 0 0 0;
  position:sticky; top:0; z-index:100;
  box-shadow: var(--shadow-lg);
}
.header-inner {
  max-width:1400px; margin:auto;
  padding:18px 32px;
  display:flex; align-items:center; justify-content:space-between;
  flex-wrap:wrap; gap:12px;
}
.brand { display:flex; align-items:center; gap:14px; }
.brand-icon {
  width:42px; height:42px; border-radius:10px;
  background:linear-gradient(135deg,var(--gold),#EDD9A3);
  display:flex;align-items:center;justify-content:center;
  font-size:20px;
}
.brand-text h1 {
  font-family:'Cormorant Garamond',serif;
  font-size:22px; font-weight:700; letter-spacing:-.3px;
}
.brand-text p { font-size:11px; color:#94a3b8; margin-top:1px; }
.header-actions { display:flex; gap:10px; }
.btn { display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border-radius:var(--radius-sm);
  font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;cursor:pointer;border:none;transition:all .2s; }
.btn-outline { background:transparent;border:1.5px solid rgba(255,255,255,.3);color:#fff; }
.btn-outline:hover { background:rgba(255,255,255,.1); }
.btn-primary { background:linear-gradient(135deg,#C8A96E,#DDB96A);color:#1A1733;font-weight:600; }
.btn-primary:hover { background:#C8A96E;box-shadow:0 4px 14px rgba(200,169,110,0.4); }
.btn-success { background:var(--navy);color:#fff; }
.btn-success:hover { background:var(--navy2); }
.btn-danger { background:transparent;border:1.5px solid var(--red);color:var(--red); font-size:12px; padding:6px 12px; }
.btn-danger:hover { background:var(--red-light); }
.btn-sm { padding:6px 12px;font-size:12px; }

/* ─── Layout ─────────────────────────────────────────── */
main { max-width:1400px; margin:auto; padding:28px 32px; }
.tabs { display:flex; gap:4px; border-bottom:2px solid var(--gray-200); margin-bottom:24px; }
.tab {
  padding:10px 20px; cursor:pointer; font-weight:500; font-size:13px;
  color:var(--gray-500); border-bottom:2px solid transparent; margin-bottom:-2px;
  transition:all .2s; border-radius:var(--radius-sm) var(--radius-sm) 0 0;
}
.tab.active { color:var(--navy); border-bottom-color:var(--navy); background:var(--white); font-weight:600; }
.tab:hover:not(.active) { color:var(--navy2); background:var(--gray-100); }
.tab-content { display:none; }
.tab-content.active { display:block; }

/* ─── Cards ──────────────────────────────────────────── */
.card {
  background:var(--white); border-radius:var(--radius);
  box-shadow:var(--shadow); padding:24px; margin-bottom:20px;
}
.card-header {
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:18px; flex-wrap:wrap; gap:10px;
}
.card-title {
  font-family:'Cormorant Garamond',serif;
  font-size:18px; color:var(--navy); font-weight:700;
  display:flex; align-items:center; gap:10px;
}
.pill {
  display:inline-block; padding:3px 10px; border-radius:20px;
  font-size:11px; font-weight:600; font-family:'DM Mono',monospace;
}
.pill-blue { background:var(--blue-light); color:var(--navy); }
.pill-green { background:var(--green-light); color:var(--green); }
.pill-amber { background:var(--amber-light); color:#92692a; }
.pill-red { background:var(--red-light); color:var(--red); }
.pill-teal { background:var(--blue-light); color:var(--navy2); }

/* ─── Form Grid ──────────────────────────────────────── */
.form-grid {
  display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px;
}
.form-group { display:flex; flex-direction:column; gap:5px; }
.form-group.wide { grid-column:span 2; }
label { font-size:12px; font-weight:600; color:var(--gray-700); letter-spacing:.3px; }
label .req { color:var(--red); }
input, select, textarea {
  width:100%; padding:9px 12px; border:1.5px solid var(--gray-200);
  border-radius:var(--radius-sm); font-family:'DM Sans',sans-serif; font-size:13px;
  color:var(--gray-900); background:var(--gray-50); transition:border .15s;
}
input:focus, select:focus { outline:none; border-color:var(--gold); background:#fff; box-shadow:0 0 0 3px rgba(200,169,110,0.15); }
input[type=number] { font-family:'DM Mono',monospace; }
.input-prefix { position:relative; }
.input-prefix span {
  position:absolute; left:11px; top:50%; transform:translateY(-50%);
  color:var(--gray-500); font-size:13px; pointer-events:none;
}
.input-prefix input { padding-left:22px; }

/* ─── Tables ──────────────────────────────────────────── */
.table-wrap { overflow-x:auto; border-radius:var(--radius-sm); border:1px solid var(--gray-200); }
table { width:100%; border-collapse:collapse; font-size:13px; }
thead tr { background:var(--navy); color:#fff; }
thead th {
  padding:10px 13px; text-align:left; font-weight:600; font-size:12px;
  letter-spacing:.3px; white-space:nowrap;
}
thead th.right { text-align:right; }
tbody tr:nth-child(even) { background:var(--gray-50); }
tbody tr:hover { background:var(--blue-light); }
tbody td {
  padding:9px 13px; border-bottom:1px solid var(--gray-200);
  vertical-align:middle; white-space:nowrap;
}
tbody td.num { text-align:right; font-family:'DM Mono',monospace; font-size:12px; }
tbody td.bold { font-weight:600; }
tfoot tr { background:var(--navy2); color:#fff; }
tfoot td { padding:10px 13px; font-weight:600; font-family:'DM Mono',monospace; font-size:12px; }
tfoot td.num { text-align:right; }

/* ─── Asset List Cards ────────────────────────────────── */
.asset-list { display:grid; gap:12px; }
.asset-card {
  background:var(--gray-50); border:1.5px solid var(--gray-200);
  border-radius:var(--radius-sm); padding:14px 18px;
  display:flex; align-items:center; justify-content:space-between; gap:12px;
  transition:border .2s;
}
.asset-card:hover { border-color:var(--navy2); }
.asset-info { display:flex; flex-direction:column; gap:3px; }
.asset-info strong { font-size:14px; color:var(--navy); }
.asset-info small { font-size:11px; color:var(--gray-500); font-family:'DM Mono',monospace; }
.asset-meta { display:flex; gap:8px; flex-wrap:wrap; }
.asset-actions { display:flex; gap:8px; align-items:center; }

/* ─── Journal Entries ─────────────────────────────────── */
.je-entry {
  background:var(--gray-50); border-left:3px solid var(--navy);
  border-radius:0 var(--radius-sm) var(--radius-sm) 0;
  padding:14px 18px; margin-bottom:10px;
}
.je-date { font-size:11px; color:var(--gray-500); font-weight:600; margin-bottom:8px; }
.je-line { display:flex; justify-content:space-between; padding:3px 0; font-size:13px; }
.je-dr { color:var(--navy); font-weight:500; }
.je-cr { color:var(--gray-500); padding-left:32px; font-style:italic; }
.je-amt { font-family:'DM Mono',monospace; font-weight:600; font-size:12px; }
.je-dr .je-amt { color:var(--navy); }
.je-cr .je-amt { color:var(--teal); }
.je-narration { font-size:11px; color:var(--gray-500); margin-top:6px; font-style:italic; border-top:1px solid var(--gray-200); padding-top:6px; }

/* ─── Summary KPI ─────────────────────────────────────── */
.kpi-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:14px; margin-bottom:20px; }
.kpi {
  background:var(--white); border-radius:var(--radius-sm); padding:16px;
  border-left:4px solid var(--navy); box-shadow:var(--shadow);
}
.kpi.green { border-left-color:var(--green); }
.kpi.amber { border-left-color:var(--gold); }
.kpi.red { border-left-color:var(--red); }
.kpi.teal { border-left-color:var(--navy2); }
.kpi-label { font-size:11px; font-weight:600; color:var(--gray-500); letter-spacing:.4px; text-transform:uppercase; }
.kpi-value { font-size:22px; font-family:'DM Mono',monospace; color:var(--navy); margin-top:4px; font-weight:500; }
.kpi-sub { font-size:10px; color:var(--gray-500); margin-top:2px; }

/* ─── Misc ────────────────────────────────────────────── */
.empty-state {
  text-align:center; padding:60px 20px; color:var(--gray-500);
}
.empty-state .icon { font-size:48px; margin-bottom:12px; }
.empty-state p { font-size:14px; }
.divider { height:1px; background:var(--gray-200); margin:20px 0; }
.section-label {
  font-size:11px; font-weight:700; color:var(--gray-500); letter-spacing:.8px;
  text-transform:uppercase; margin-bottom:12px;
  display:flex;align-items:center;gap:8px;
}
.section-label::after { content:''; flex:1; height:1px; background:var(--gray-200); }
.badge { display:inline-block; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:600; font-family:'DM Mono',monospace; }
.badge-wdv { background:#fef3c7;color:#92400e; }
.badge-slm { background:#dbeafe;color:#1e40af; }
.alert { padding:12px 16px; border-radius:var(--radius-sm); margin-bottom:16px; font-size:13px; }
.alert-info { background:var(--blue-light); color:var(--navy); border-left:3px solid var(--blue); }
.alert-success { background:var(--green-light); color:var(--green); border-left:3px solid var(--green); }
select option { font-size:13px; }
.group-header { background:linear-gradient(90deg,var(--navy),var(--navy2)); color:#fff; }
@media(max-width:700px){
  main{padding:16px;} .header-inner{padding:14px 16px;}
  .form-grid{grid-template-columns:1fr;} .form-group.wide{grid-column:span 1;}
}
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <div class="brand">
      <div class="brand-icon">📉</div>
      <div class="brand-text">
        <h1>D S M K & Associates, Chartered Accountants</h1>
        <p>DEPRECIATION CALCULATOR &nbsp;·&nbsp; COMPANIES ACT 2013 &amp; INCOME TAX ACT &nbsp;·&nbsp; WDV &amp; SLM</p>
      </div>
    </div>
    <div class="header-actions">
      <a href="index.html" class="btn btn-outline btn-sm" style="text-decoration:none">← Home</a>
      <button class="btn btn-outline btn-sm" onclick="loadSampleData()">📁 Sample Data</button>
      <button class="btn btn-outline btn-sm" onclick="triggerImport()">⬆ Import CSV</button>
      <input type="file" id="csv-import-input" accept=".csv" style="display:none" onchange="importCSV(event)"/>
      <button class="btn btn-primary btn-sm" onclick="exportPDF()">📄 Export PDF</button>
      <div style="position:relative;display:inline-block">
        <button class="btn btn-success btn-sm" onclick="toggleExportMenu()">⬇ Export CSV ▾</button>
        <div id="export-menu" style="display:none;position:absolute;right:0;top:110%;background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-sm);box-shadow:var(--shadow-lg);z-index:200;min-width:200px;overflow:hidden;">
          <div onclick="exportCSV('assets');toggleExportMenu()" style="padding:10px 16px;cursor:pointer;font-size:13px;border-bottom:1px solid var(--gray-200);color:var(--navy)" onmouseover="this.style.background='var(--gray-50)'" onmouseout="this.style.background=''">📋 Asset Master (Re-importable)</div>
          <div onclick="exportCSV('schedule');toggleExportMenu()" style="padding:10px 16px;cursor:pointer;font-size:13px;border-bottom:1px solid var(--gray-200);color:var(--navy)" onmouseover="this.style.background='var(--gray-50)'" onmouseout="this.style.background=''">📊 Depreciation Schedule</div>
          <div onclick="exportCSV('monthly');toggleExportMenu()" style="padding:10px 16px;cursor:pointer;font-size:13px;border-bottom:1px solid var(--gray-200);color:var(--navy)" onmouseover="this.style.background='var(--gray-50)'" onmouseout="this.style.background=''">📅 Monthly Summary</div>
          <div onclick="exportCSV('group');toggleExportMenu()" style="padding:10px 16px;cursor:pointer;font-size:13px;border-bottom:1px solid var(--gray-200);color:var(--navy)" onmouseover="this.style.background='var(--gray-50)'" onmouseout="this.style.background=''">🗂 Group Summary</div>
          <div onclick="exportCSV('journal');toggleExportMenu()" style="padding:10px 16px;cursor:pointer;font-size:13px;color:var(--navy)" onmouseover="this.style.background='var(--gray-50)'" onmouseout="this.style.background=''">📒 Journal Entries</div>
        </div>
      </div>
    </div>
  </div>
</header>

<main>
  <div class="tabs">
    <div class="tab" onclick="switchTab('settings')" style="border-left:3px solid var(--gold);background:var(--amber-light);color:#92692a;font-weight:600" id="tab-btn-settings">⚙️ FY Settings</div>
    <div class="tab active" onclick="switchTab('add')" id="tab-btn-add">➕ Add Asset</div>
    <div class="tab" onclick="switchTab('schedule')" id="tab-btn-schedule">📋 Depreciation Schedule</div>
    <div class="tab" onclick="switchTab('monthly')" id="tab-btn-monthly">📅 Monthly Summary</div>
    <div class="tab" onclick="switchTab('group')" id="tab-btn-group">🗂 Group Summary</div>
    <div class="tab" onclick="switchTab('journal')" id="tab-btn-journal">📒 Journal Entries</div>
    <div class="tab" onclick="switchTab('schedule2')" id="tab-btn-schedule2" style="color:var(--gold);font-weight:600">📜 Schedule II</div>
    <div class="tab" onclick="switchTab('yearly')" id="tab-btn-yearly">📆 Yearly Summary</div>
  </div>

  <!-- TAB 0: FY SETTINGS -->
  <div class="tab-content" id="tab-settings">
    <div class="card">
      <div class="card-header">
        <div class="card-title">⚙️ Financial Year & Depreciation Settings</div>
        <div class="pill pill-teal">Global Configuration</div>
      </div>
      <div class="alert alert-info" style="margin-bottom:20px">
        Set the Financial Year and other global settings here. These apply to <strong>all assets</strong> when generating the report.
        After changing, click <strong>⚡ Apply &amp; Generate Report</strong>.
      </div>
      <div class="form-grid" style="grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px">

        <!-- FY Picker -->
        <div class="form-group">
          <label>📅 Financial Year <span class="req">*</span></label>
          <select id="g_fy" onchange="updateFYPreview()" style="font-size:14px;font-weight:600;color:var(--navy)">
            <option value="2020-21">FY 2020-21 (Apr 2020 – Mar 2021)</option>
            <option value="2021-22">FY 2021-22 (Apr 2021 – Mar 2022)</option>
            <option value="2022-23">FY 2022-23 (Apr 2022 – Mar 2023)</option>
            <option value="2023-24">FY 2023-24 (Apr 2023 – Mar 2024)</option>
            <option value="2024-25">FY 2024-25 (Apr 2024 – Mar 2025)</option>
            <option value="2025-26" selected>FY 2025-26 (Apr 2025 – Mar 2026)</option>
            <option value="2026-27">FY 2026-27 (Apr 2026 – Mar 2027)</option>
            <option value="2027-28">FY 2027-28 (Apr 2027 – Mar 2028)</option>
            <option value="2028-29">FY 2028-29 (Apr 2028 – Mar 2029)</option>
            <option value="2029-30">FY 2029-30 (Apr 2029 – Mar 2030)</option>
          </select>
        </div>

        <!-- Company Name -->
        <div class="form-group">
          <label>🏢 Company / Entity Name</label>
          <input id="g_company" placeholder="e.g. ABC Pvt. Ltd." value=""/>
        </div>

        <!-- Depreciation Convention -->
        <div class="form-group">
          <label>📐 Depreciation Convention</label>
          <select id="g_conv">
            <option value="days" selected>Day-basis (Actual days / Days in FY)</option>
            <option value="months">Month-basis (Full month from PTU month)</option>
          </select>
        </div>

        <!-- Currency -->
        <div class="form-group">
          <label>💰 Currency Symbol</label>
          <select id="g_currency">
            <option value="₹" selected>₹ Indian Rupee (INR)</option>
            <option value="$">$ US Dollar (USD)</option>
            <option value="€">€ Euro (EUR)</option>
            <option value="£">£ British Pound (GBP)</option>
          </select>
        </div>

        <!-- Rounding -->
        <div class="form-group">
          <label>🔢 Round Depreciation To</label>
          <select id="g_round">
            <option value="2" selected>2 decimal places (₹0.00)</option>
            <option value="0">Nearest rupee (₹0)</option>
            <option value="1">1 decimal place (₹0.0)</option>
          </select>
        </div>

        <!-- Report Title -->
        <div class="form-group">
          <label>📄 Report Title (for PDF)</label>
          <input id="g_report_title" placeholder="e.g. Fixed Asset Register – FY 2025-26" value=""/>
        </div>
      </div>

      <!-- FY Preview Card -->
      <div id="fy-preview-card" style="margin-top:24px;background:linear-gradient(135deg,#1E1A50,#3C3489,#534AB7);color:#fff;border-radius:12px;padding:20px 24px">
        <div style="font-size:11px;color:#94a3b8;text-transform:uppercase;letter-spacing:.6px;margin-bottom:12px">Selected FY Preview</div>
        <div style="display:flex;gap:20px;flex-wrap:wrap">
          <div><div style="font-size:10px;color:#94a3b8">Financial Year</div><div style="font-size:20px;font-weight:700" id="prev-fy">FY 2025-26</div></div>
          <div><div style="font-size:10px;color:#94a3b8">Start Date</div><div style="font-size:14px;font-weight:600;color:#bfdbfe" id="prev-start">01 April 2025</div></div>
          <div><div style="font-size:10px;color:#94a3b8">End Date</div><div style="font-size:14px;font-weight:600;color:#bfdbfe" id="prev-end">31 March 2026</div></div>
          <div><div style="font-size:10px;color:#94a3b8">Days in FY</div><div style="font-size:14px;font-weight:600;color:#fde68a" id="prev-days">365</div></div>
          <div><div style="font-size:10px;color:#94a3b8">Assets Loaded</div><div style="font-size:14px;font-weight:600;color:#6ee7b7" id="prev-assets">0</div></div>
          <div><div style="font-size:10px;color:#94a3b8">Current Status</div><div style="font-size:12px;font-weight:600;color:#fca5a5" id="prev-status">No report generated</div></div>
        </div>
      </div>

      <!-- Asset FY Override -->
      <div style="margin-top:20px">
        <div class="section-label">Bulk FY Override — Apply selected FY to all loaded assets</div>
        <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
          <button class="btn btn-primary btn-sm" onclick="applyFYToAllAssets()" style="background:var(--teal)">
            🔄 Apply FY to All Assets
          </button>
          <span style="font-size:12px;color:var(--gray-500)">Updates the FY field on all <span id="bulk-count">0</span> loaded assets to the selected FY above.</span>
        </div>
      </div>

      <!-- Action buttons -->
      <div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap;align-items:center;padding-top:20px;border-top:1px solid var(--gray-200)">
        <button class="btn btn-primary" onclick="applySettingsAndGenerate()" style="background:linear-gradient(135deg,#3C3489,#534AB7);color:#fff;font-size:14px;padding:12px 28px">
          ⚡ Apply &amp; Generate Report
        </button>
        <button class="btn btn-outline btn-sm" style="border-color:var(--gray-300);color:var(--gray-700)" onclick="switchTab('add')">
          ← Back to Asset Entry
        </button>
        <span style="font-size:12px;color:var(--gray-500)">Settings are applied to all assets when generating the report.</span>
      </div>
    </div>
  </div>

  <!-- TAB 1: ADD ASSET -->
  <div class="tab-content active" id="tab-add">
    <div class="card">
      <div class="card-header">
        <div class="card-title">🏭 Asset Entry Form</div>
        <div class="pill pill-blue">Indian GAAP | Companies Act 2013</div>
      </div>
      <div class="alert alert-info">Enter all mandatory fields (<span style="color:var(--red)">*</span>). For existing assets, provide Opening Gross Block and Opening Accumulated Depreciation.</div>
      <div class="form-grid">
        <div class="form-group">
          <label>Asset ID <span class="req">*</span></label>
          <input id="f_id" placeholder="e.g. A001" />
        </div>
        <div class="form-group wide">
          <label>Asset Name <span class="req">*</span></label>
          <input id="f_name" placeholder="e.g. CNC Lathe Machine" />
        </div>
        <div class="form-group">
          <label>Asset Group <span class="req">*</span></label>
          <select id="f_group" onchange="onGroupChange()">
            <option value="">— Select Group —</option>
            <optgroup label="── Buildings">
              <option value="Buildings – Factory / Industrial">Buildings – Factory / Industrial</option>
