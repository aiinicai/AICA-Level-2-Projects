}

/* ─── Asset List with inline diagnostics ─────────────── */
function renderAssetList() {
  document.getElementById('asset-count').textContent = assets.length + ' Asset' + (assets.length !== 1 ? 's' : '');
  const wrap = document.getElementById('asset-list-wrap');
  if (!assets.length) {
    wrap.innerHTML = '<div class="empty-state"><div class="icon">🏗️</div><p>No assets added yet.</p></div>';
    return;
  }

  // Count issues
  let issueCount = 0;
  assets.forEach(a => { if (diagnoseAsset(a).length) issueCount++; });

  let html = '';
  if (issueCount > 0) {
    html += `<div class="alert" style="background:#fef3c7;border-left:3px solid #d97706;color:#92400e;margin-bottom:14px;font-size:13px;">
      ⚠️ <strong>${issueCount} asset(s) have data issues</strong> and will show ₹0 depreciation. Fix the highlighted fields below, then click ⚡ Generate Report again.
      <br><small>Most common causes: WDV Rate = 0, SLM Life = 0, Put-to-Use date missing or wrong format (use YYYY-MM-DD).</small>
    </div>`;
  }

  html += '<div class="asset-list">';
  assets.forEach(a => {
    let d = { annualDep: 0, daysActive: 0 };
    const issues = diagnoseAsset(a);
    try { d = calcDepreciation(a); } catch(e) {}

    const hasIssue = issues.length > 0 || d.annualDep === 0;
    const borderColor = hasIssue ? 'var(--red)' : 'var(--gray-200)';
