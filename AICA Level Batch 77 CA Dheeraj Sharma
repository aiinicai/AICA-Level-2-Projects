          <span class="pill ${d.annualDep>0?'pill-green':'pill-red'}" style="${d.annualDep===0?'background:#fee2e2;color:#dc2626':''}">
            Dep: ₹${d.annualDep.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})}
