          <button class="btn btn-danger btn-sm" onclick="removeAsset('${a.id}')">🗑</button>
        </div>
      </div>
      ${issues.length ? `<div style="font-size:11px;color:#dc2626;background:#fee2e2;padding:6px 10px;border-radius:5px;">
        ❌ Issues: ${issues.join(' | ')}
        &nbsp;<button onclick="openEditModal('${a.id}')" style="background:none;border:none;color:#1d4ed8;cursor:pointer;font-size:11px;text-decoration:underline;">Fix now →</button>
      </div>` : ''}
      <div style="font-size:11px;color:var(--gray-500);display:flex;gap:16px;flex-wrap:wrap;">
        <span>Cost: ₹${(+a.cost||0).toLocaleString('en-IN')}</span>
