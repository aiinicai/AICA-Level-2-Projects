/* ═══════════════════════════════════════════════════════
   TOAST NOTIFICATIONS
═══════════════════════════════════════════════════════ */
function showToast(msg, type) {
  const existing = document.getElementById('toast-notif');
  if (existing) existing.remove();
  const colors = { success: '#16a34a', error: '#dc2626', warning: '#d97706' };
  const icons  = { success: '✅', error: '❌', warning: '⚠️' };
  const toast = document.createElement('div');
  toast.id = 'toast-notif';
  toast.style.cssText = `position:fixed;bottom:24px;right:24px;z-index:9999;
    background:${colors[type]||colors.success};color:#fff;padding:13px 20px;
    border-radius:10px;font-size:13px;max-width:360px;line-height:1.5;
    box-shadow:0 8px 30px rgba(0,0,0,.25);display:flex;align-items:flex-start;gap:10px;
    animation:slideIn .3s ease;`;
  toast.innerHTML = `<span style="font-size:16px">${icons[type]||'✅'}</span><span>${msg}</span>`;
  document.body.appendChild(toast);
  const style = document.createElement('style');
  style.textContent = '@keyframes slideIn{from{transform:translateX(110%);opacity:0}to{transform:translateX(0);opacity:1}}';
  document.head.appendChild(style);
  setTimeout(() => { toast.style.opacity='0'; toast.style.transition='opacity .4s'; setTimeout(()=>toast.remove(),400); }, 4000);
}

