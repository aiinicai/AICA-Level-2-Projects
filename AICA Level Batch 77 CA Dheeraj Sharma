/* ═══════════════════════════════════════════════════════
   CSV DOWNLOAD HELPER — fixed, works in all browsers
═══════════════════════════════════════════════════════ */
function downloadCSVFile(filename, rows) {
  // BOM for Excel to correctly read UTF-8 (₹ symbol etc.)
  const BOM = '\uFEFF';
  const csvContent = BOM + rows.map(row =>
    row.map(val => {
      const s = (val === null || val === undefined) ? '' : String(val);
      // Wrap in quotes if contains comma, quote, or newline
      if (s.includes(',') || s.includes('"') || s.includes('\n')) {
        return '"' + s.replace(/"/g, '""') + '"';
      }
      return s;
    }).join(',')
  ).join('\r\n');

  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });

  // IE fallback
  if (window.navigator && window.navigator.msSaveBlob) {
    window.navigator.msSaveBlob(blob, filename);
    return;
  }

  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.setAttribute('href', url);
  link.setAttribute('download', filename);
  link.style.display = 'none';
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  // Revoke after small delay to ensure download starts
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

/* ═══════════════════════════════════════════════════════
   EXPORT CSV — exactly matches on-screen report
═══════════════════════════════════════════════════════ */
function exportCSV(type) {
  if (!assets.length) { showToast('No assets to export. Add assets first.', 'error'); return; }
  const fy = assets[0].fy;
  const { start } = fyDates(fy);
  const calcs = assets.map(a => ({ a, d: calcDepreciation(a) }));
  const groupsObj = buildGroupsObj(calcs);

  if (type === 'assets') {
    const rows = [['id','name','group','method','fy','purchase','ptu','cost','salvage','rate','life','ogb','oad','remarks']];
    assets.forEach(a => rows.push([a.id,a.name,a.group,a.method,a.fy,a.purchase,a.ptu,
      a.cost,a.salvage,a.rate,a.life,a.ogb,a.oad,a.remarks||'']));
    downloadCSVFile('Asset_Master_'+fy+'.csv', rows);
    showToast('Asset Master exported — re-importable format.','success');

  } else if (type === 'schedule') {
    const rows = [['Asset ID','Asset Name','Group','Method','Rate/Life','Days Active',
      'Total Days','Opening Gross Block','Opening Acc Dep','Opening WDV',
      'Additions in FY','Dep Base','Annual Dep','Closing Acc Dep','Closing WDV']];
    Object.entries(groupsObj).forEach(([grp,g]) => {
      rows.push(['--- '+grp+' ('+g.assets.length+' assets) ---','','','','','','','','','','','','','','']);
      g.assets.forEach(({a,d}) => rows.push([
        a.id,a.name,a.group,
        a.method+(a.method==='WDV'?' '+a.rate+'%':' '+a.life+'yr'),
        a.method==='WDV'?a.rate+'%':a.life+' yrs',
        d.daysActive,d.totalDays,
        d.openingGrossBlock.toFixed(2),d.openingAD.toFixed(2),d.openingWDV.toFixed(2),
        d.additionsInFY.toFixed(2),d.depBase.toFixed(2),
        d.annualDep.toFixed(2),d.closingAD.toFixed(2),d.closingWDV.toFixed(2)
      ]));
      rows.push(['GROUP SUBTOTAL: '+grp,'','','','','','',
        g.ogb.toFixed(2),g.oad.toFixed(2),g.owdv.toFixed(2),
        g.add.toFixed(2),'',g.dep.toFixed(2),g.cad.toFixed(2),g.cwdv.toFixed(2)]);
      rows.push([]);
    });
    const tot = totals(groupsObj);
    rows.push(['GRAND TOTAL','','','','','','',
      tot.ogb.toFixed(2),tot.oad.toFixed(2),tot.owdv.toFixed(2),
      tot.add.toFixed(2),'',tot.dep.toFixed(2),tot.cad.toFixed(2),tot.cwdv.toFixed(2)]);
    downloadCSVFile('Depreciation_Schedule_'+fy+'.csv', rows);
    showToast('Depreciation Schedule exported — matches on-screen.','success');

  } else if (type === 'monthly') {
    const ML = Array.from({length:12},(_,i)=>new Date(start.getFullYear(),start.getMonth()+i,1)
      .toLocaleString('en-IN',{month:'short',year:'2-digit'}));
    const rows = [['Asset ID','Asset Name','Group',...ML,'Total FY']];
    const mTotals=new Array(12).fill(0); let grand=0;
    Object.entries(groupsObj).forEach(([grp,g]) => {
      rows.push(['--- '+grp+' ---','','',...new Array(12).fill(''),'']);
      const gm=new Array(12).fill(0);
      g.assets.forEach(({a,d}) => {
        const vals=Array.from({length:12},(_,m)=>d.monthlyDep[m]||0);
        const rowT=vals.reduce((s,v)=>s+v,0);
        vals.forEach((v,m)=>{gm[m]+=v;mTotals[m]+=v;}); grand+=rowT;
        rows.push([a.id,a.name,a.group,...vals.map(v=>v>0?v.toFixed(2):'0.00'),rowT.toFixed(2)]);
      });
      rows.push(['GROUP TOTAL: '+grp,'','',...gm.map(v=>v.toFixed(2)),gm.reduce((s,v)=>s+v,0).toFixed(2)]);
      rows.push([]);
    });
    rows.push(['GRAND TOTAL','','',...mTotals.map(v=>v.toFixed(2)),grand.toFixed(2)]);
    downloadCSVFile('Monthly_Depreciation_'+fy+'.csv', rows);
    showToast('Monthly Summary exported — matches on-screen.','success');

  } else if (type === 'group') {
    const rows = [['Asset Group','No of Assets','Opening Gross Block','Additions in FY',
      'Opening Acc Dep','Opening WDV','Depreciation for FY','Closing Acc Dep','Closing WDV']];
    const tot={count:0,ogb:0,add:0,oad:0,owdv:0,dep:0,cad:0,cwdv:0};
    Object.entries(groupsObj).forEach(([grp,g]) => {
      rows.push([grp,g.assets.length,g.ogb.toFixed(2),g.add.toFixed(2),
        g.oad.toFixed(2),g.owdv.toFixed(2),g.dep.toFixed(2),g.cad.toFixed(2),g.cwdv.toFixed(2)]);
      tot.count+=g.assets.length;tot.ogb+=g.ogb;tot.add+=g.add;tot.oad+=g.oad;
      tot.owdv+=g.owdv;tot.dep+=g.dep;tot.cad+=g.cad;tot.cwdv+=g.cwdv;
    });
    rows.push(['GRAND TOTAL',tot.count,tot.ogb.toFixed(2),tot.add.toFixed(2),
      tot.oad.toFixed(2),tot.owdv.toFixed(2),tot.dep.toFixed(2),tot.cad.toFixed(2),tot.cwdv.toFixed(2)]);
    downloadCSVFile('Group_Summary_'+fy+'.csv', rows);
    showToast('Group Summary exported.','success');

  } else if (type === 'journal') {
    const rows = [['Entry No','Section','Month/Period','Date','Group','Particulars','Dr/Cr','Amount (Rs)','Narration']];
    const MF=Array.from({length:12},(_,i)=>new Date(start.getFullYear(),start.getMonth()+i,1)
      .toLocaleString('en-IN',{month:'long',year:'numeric'}));
    let jeNo=1;
    for(let mi=0;mi<12;mi++){
      const mDate=new Date(start.getFullYear(),start.getMonth()+mi+1,0).toLocaleDateString('en-IN');
      const mTotal=calcs.reduce((s,{d})=>s+(d.monthlyDep[mi]||0),0);
      if(mTotal===0) continue;
      let first=true;
      Object.entries(groupsObj).forEach(([grp,g])=>{
        const grpDep=g.assets.reduce((s,{d})=>s+(d.monthlyDep[mi]||0),0);
        if(grpDep===0) return;
        rows.push([first?'JE-M'+String(jeNo).padStart(2,'0'):'','A-Monthly',MF[mi],mDate,
          grp,'Depreciation – '+grp+' A/c','Dr',grpDep.toFixed(2),'Monthly dep '+MF[mi]+' — '+grp]);
        first=false;
      });
      rows.push(['','A-Monthly',MF[mi],mDate,'ALL','To Accumulated Depreciation A/c','Cr',mTotal.toFixed(2),'']);
      rows.push([]); jeNo++;
    }
    const yearEnd=new Date(start.getFullYear()+1,2,31).toLocaleDateString('en-IN');
    const yTotal=calcs.reduce((s,{d})=>s+d.annualDep,0);
    rows.push(['--- SECTION B: Yearly Group-wise ---']);
    let firstB=true;
    Object.entries(groupsObj).forEach(([grp,g])=>{
      if(g.dep===0) return;
      rows.push([firstB?'JE-Y01':'','B-Yearly','Year End FY '+fy,yearEnd,
        grp,'Depreciation – '+grp+' A/c','Dr',g.dep.toFixed(2),'Annual FY '+fy+' — '+grp]);
      firstB=false;
    });
    rows.push(['','B-Yearly','Year End FY '+fy,yearEnd,'ALL','To Accumulated Depreciation A/c','Cr',yTotal.toFixed(2),'Annual dep FY '+fy]);
    downloadCSVFile('Journal_Entries_'+fy+'.csv', rows);
    showToast('Journal Entries exported — group-wise monthly & yearly.','success');
  }
}

// Shared helper — build groups object from calcs array
function buildGroupsObj(calcs) {
  const g = {};
  calcs.forEach(({a,d}) => {
    if(!g[a.group]) g[a.group]={assets:[],ogb:0,add:0,oad:0,owdv:0,dep:0,cad:0,cwdv:0};
    const grp=g[a.group];
    grp.assets.push({a,d});
    grp.ogb+=d.openingGrossBlock; grp.add+=d.additionsInFY;
    grp.oad+=d.openingAD; grp.owdv+=d.openingWDV;
    grp.dep+=d.annualDep; grp.cad+=d.closingAD; grp.cwdv+=d.closingWDV;
  });
  return g;
}
function totals(groupsObj) {
  return Object.values(groupsObj).reduce((t,g)=>({
    ogb:t.ogb+g.ogb,add:t.add+g.add,oad:t.oad+g.oad,owdv:t.owdv+g.owdv,
    dep:t.dep+g.dep,cad:t.cad+g.cad,cwdv:t.cwdv+g.cwdv
  }),{ogb:0,add:0,oad:0,owdv:0,dep:0,cad:0,cwdv:0});
}

