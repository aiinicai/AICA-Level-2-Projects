/* ═══════════════════════════════════════════════════════
   GENERATE REPORT — called manually or after import
═══════════════════════════════════════════════════════ */
function generateReport() {
  if (!assets.length) {
    showToast('No assets found. Please add assets or import a CSV first.', 'error');
    return;
  }

  // Always render asset list first (shows diagnostic warnings)
  renderAssetList();

  // Soft-validate: warn but don't block (show issues inline on the card)
  const btn = document.getElementById('gen-btn');
  const orig = btn.innerHTML;
  btn.innerHTML = '⏳ Calculating…';
  btn.disabled = true;

  setTimeout(() => {
    try {
      renderAll();
      showToast('✅ Report generated for ' + assets.length + ' asset(s)! Assets with ₹0 depreciation have issues — check the red warnings on the Asset Register.', 'success');
      switchTab('schedule');
    } catch(err) {
      showToast('Error generating report: ' + err.message, 'error');
      console.error(err);
    } finally {
      btn.innerHTML = orig;
      btn.disabled = false;
    }
  }, 60);
}

/* ═══════════════════════════════════════════════════════
   DIAGNOSE ASSET — returns array of issue strings or []
═══════════════════════════════════════════════════════ */
function diagnoseAsset(a) {
  const issues = [];
  if (!a.ptu)                          issues.push('Put-to-Use date missing');
  else if (!parseDate(a.ptu))          issues.push('Put-to-Use date invalid: "' + a.ptu + '"');
  if (!+a.cost && !+a.ogb)            issues.push('Cost & Opening Gross Block both zero');
  if (!a.method)                       issues.push('Depreciation method missing');
  if (a.method === 'WDV' && !+a.rate) issues.push('WDV Rate is 0% — enter rate e.g. 15');
  if (a.method === 'SLM' && !+a.life) issues.push('SLM Useful Life is 0 — enter years e.g. 10');
  if (!a.fy)                           issues.push('Financial Year missing');

  // Check if PTU is after FY end
  if (a.ptu && a.fy) {
    const ptu = parseDate(a.ptu);
    const { end } = fyDates(a.fy);
    if (ptu && ptu > end) issues.push('PTU (' + a.ptu + ') is after FY end — asset not active this FY');
  }
  return issues;
}

/* ═══════════════════════════════════════════════════════
