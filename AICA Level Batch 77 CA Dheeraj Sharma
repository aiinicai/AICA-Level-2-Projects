<script>
/* ═══════════════════════════════════════════════════════
   DATA STORE
═══════════════════════════════════════════════════════ */
let assets = [];

/* ═══════════════════════════════════════════════════════
   UTILITY FUNCTIONS
═══════════════════════════════════════════════════════ */
const INR = v => '₹' + Number(v||0).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2});
const fmt = (v,d=2) => Number(v||0).toFixed(d);

// FY boundaries — supports "2024-25" or "2024-2025"
function fyDates(fy) {
  if (!fy || typeof fy !== 'string') return { start: new Date(2025,3,1), end: new Date(2026,2,31) };
  const parts = fy.trim().split('-');
  const startY = parseInt(parts[0], 10);
  if (isNaN(startY)) return { start: new Date(2025,3,1), end: new Date(2026,2,31) };
  return {
    start: new Date(startY,     3, 1),   // 1 Apr
    end:   new Date(startY + 1, 2, 31)   // 31 Mar
  };
}

// Total days in a financial year (365 or 366 for leap)
function daysInFY(fy) {
  const { start, end } = fyDates(fy);
  return Math.round((end - start) / 86400000) + 1;
}

// Parse date safely from various formats: YYYY-MM-DD, DD-MM-YYYY, DD/MM/YYYY
function parseDate(str) {
  if (!str) return null;
  str = String(str).trim();
  // ISO format YYYY-MM-DD
  if (/^\d{4}-\d{2}-\d{2}$/.test(str)) {
    const [y,m,d] = str.split('-').map(Number);
    return new Date(y, m-1, d);
  }
  // DD-MM-YYYY or DD/MM/YYYY
  if (/^\d{2}[-\/]\d{2}[-\/]\d{4}$/.test(str)) {
    const parts = str.split(/[-\/]/);
    return new Date(+parts[2], +parts[1]-1, +parts[0]);
  }
  // Try native parse as fallback
  const d = new Date(str);
  return isNaN(d.getTime()) ? null : d;
}

// Clamp date between two bounds
function clamp(d, lo, hi) {
  if (d < lo) return new Date(lo);
  if (d > hi) return new Date(hi);
  return new Date(d);
}

// Days between two dates (inclusive of start, exclusive of end — standard)
function daysBetween(a, b) {
  return Math.max(0, Math.round((b - a) / 86400000));
}

/* ═══════════════════════════════════════════════════════
   CORE DEPRECIATION ENGINE — Day-wise calculation
   Per Companies Act 2013 & Income Tax Act practice:
   • SLM : Annual dep = (Cost − Salvage) / Life
           Pro-rata  = Annual dep × (days used in FY / days in FY)
   • WDV : Annual dep = Opening WDV × Rate%
           Pro-rata  = Annual dep × (days used in FY / days in FY)
   Days used = from max(PTU, FY start) to FY end (inclusive)
═══════════════════════════════════════════════════════ */
function calcDepreciation(asset) {
  const fy      = (asset.fy || '2025-26').trim();
  const { start, end } = fyDates(fy);
  const totalDays = daysInFY(fy);           // 365 or 366

  const ptu     = parseDate(asset.ptu);
  const ogb     = +asset.ogb   || 0;
  const oad     = +asset.oad   || 0;
  const cost    = +asset.cost  || 0;
  const salvage = +asset.salvage || 0;

  /* ── Gross Block & Opening WDV ────────────────────────
     Case A — Existing asset (ogb > 0):
       Gross Block    = ogb  (historic capitalised cost)
       Additions      = 0    (not added this FY)
       Opening WDV    = ogb − oad
     Case B — New asset purchased this FY (ptu within FY):
       Gross Block    = cost
       Additions      = cost
       Opening WDV    = 0
     Case C — Asset bought prior FY but ogb not given (ogb=0):
       Treat cost as gross block, oad as accumulated dep
       Opening WDV    = cost − oad
  ─────────────────────────────────────────────────────── */
  let grossBlock, additionsInFY, openingWDV, openingGrossBlock;

  const ptuInFY = ptu && ptu >= start && ptu <= end;
  const ptuBeforeFY = ptu && ptu < start;

  if (ogb > 0) {
    // Existing asset — historic block provided
    grossBlock       = ogb;
    openingGrossBlock = ogb;   // existed at start of FY
    additionsInFY    = 0;
    openingWDV       = ogb - oad;
  } else if (ptuInFY) {
    // Brand-new asset capitalised this FY
    grossBlock        = cost;
    openingGrossBlock = 0;     // did NOT exist at start of FY → Opening = 0
    additionsInFY     = cost;
    openingWDV        = 0;
  } else {
    // Prior-FY asset, no OGB provided — derive from cost & oad
    grossBlock        = cost;
    openingGrossBlock = cost;  // existed before FY → Opening = cost
    additionsInFY     = 0;
    openingWDV        = cost - oad;
  }

  // closingGrossBlock = what it was at start of FY + anything added this FY
  // For new assets: openingGrossBlock=0, additionsInFY=cost → closing = cost ✅
  // For existing:   openingGrossBlock=ogb, additionsInFY=0  → closing = ogb ✅
  // (grossBlock is the internal calc base; do NOT use it here — it equals cost for new assets,
  //  which would double-count since additionsInFY already equals cost)
  const closingGrossBlock = openingGrossBlock + additionsInFY;

  /* ── Days Active in this FY ───────────────────────────
     From the later of PTU or FY-start  →  FY-end
     If PTU is after FY-end → 0 days (asset not yet in use)
  ─────────────────────────────────────────────────────── */
  let daysActive = 0;
  if (ptu && ptu <= end) {
    const effectiveFrom = ptu < start ? start : ptu;
    // +1 because both start and end day are counted
    daysActive = daysBetween(effectiveFrom, end) + 1;
  }
  daysActive = Math.max(0, Math.min(daysActive, totalDays));

  /* ── Depreciation Base & Annual Full-year Dep ─────────
     "Full-year" means what would be charged for 365/366 days
     Pro-rata then applies daysActive/totalDays
  ─────────────────────────────────────────────────────── */
  let fullYearDep = 0;
  let depBase     = 0;

  if (asset.method === 'WDV') {
    const rate  = (+asset.rate || 0) / 100;
    depBase     = openingWDV + additionsInFY;        // WDV base
    fullYearDep = depBase * rate;                    // full-year charge
  } else {
    // SLM
    const life  = +asset.life || 1;
    depBase     = closingGrossBlock - salvage;       // depreciable amount
    fullYearDep = depBase / life;                    // full-year charge
  }

  // Pro-rate by actual days
  const annualDep = daysActive > 0
    ? Math.max(0, fullYearDep * (daysActive / totalDays))
    : 0;

  const closingAD  = oad + annualDep;
  const closingWDV = closingGrossBlock - closingAD;

  /* ── Per-month depreciation (day-accurate) ────────────
     For each calendar month in the FY:
       days_in_month = days this asset was active in that month
       monthDep = fullYearDep × (days_in_month / totalDays)
  ─────────────────────────────────────────────────────── */
  const monthlyDep  = {};   // key: 0–11 (0=Apr, 11=Mar for standard FY)
  const monthlyDays = {};   // for transparency

  for (let m = 0; m < 12; m++) {
    // Actual calendar month
    const mStart = new Date(start.getFullYear(), start.getMonth() + m, 1);
    const mEnd   = new Date(start.getFullYear(), start.getMonth() + m + 1, 0); // last day

    if (!ptu || ptu > mEnd || mStart > end) {
      monthlyDep[m]  = 0;
      monthlyDays[m] = 0;
      continue;
    }

    const activeFrom = ptu < mStart ? mStart : ptu;
    const activeTo   = mEnd < end ? mEnd : end;

    if (activeFrom > activeTo) {
      monthlyDep[m]  = 0;
      monthlyDays[m] = 0;
    } else {
      const days = daysBetween(activeFrom, activeTo) + 1;
      monthlyDays[m] = days;
      monthlyDep[m]  = fullYearDep * (days / totalDays);
    }
  }

  return {
    openingGrossBlock,           // ₹0 for new assets, ogb for existing, cost for prior-FY
    additionsInFY,               // cost for new assets, 0 for existing/prior
    closingGrossBlock,           // openingGrossBlock + additionsInFY
    openingAD         : oad,
    openingWDV,
    depBase,
    daysActive,
    totalDays,
    fullYearDep,
    annualDep,
    closingAD,
    closingWDV,
    monthlyDep,
    monthlyDays,
  };
}

/* ═══════════════════════════════════════════════════════
   ADD / REMOVE ASSET
═══════════════════════════════════════════════════════ */
function addAsset() {
  const get = id => document.getElementById(id).value.trim();
  const id = get('f_id'), name = get('f_name'), group = get('f_group');
  const method = get('f_method');
  const fy = get('f_fy'), ptu = get('f_ptu'), purchase = get('f_purchase');
  const cost = +get('f_cost');

  if (!id||!name||!group||!method||!ptu||!purchase||!cost) {
    alert('Please fill all mandatory fields (marked with *).');
    return;
  }
  if (method === 'WDV' && !+get('f_rate')) { alert('Enter WDV Rate % for WDV method.'); return; }
  if (method === 'SLM' && !+get('f_life')) { alert('Enter Useful Life for SLM method.'); return; }
  if (assets.find(a => a.id === id)) { alert('Asset ID already exists. Use a unique ID.'); return; }

  assets.push({
    id, name, group, method, fy, ptu, purchase,
    cost, salvage: +get('f_salvage')||0,
    rate: +get('f_rate')||0, life: +get('f_life')||0,
    ogb: +get('f_ogb')||0, oad: +get('f_oad')||0,
    remarks: get('f_remarks'),
  });

  clearForm();
  renderAll();
  switchTab('schedule');
}

function removeAsset(id) {
  assets = assets.filter(a => a.id !== id);
  renderAll();
}

function clearAll() {
  if (confirm('Remove all assets?')) { assets = []; renderAll(); }
}

function clearForm() {
  ['f_id','f_name','f_group','f_method','f_ptu','f_purchase','f_rate','f_life',
   'f_cost','f_salvage','f_ogb','f_oad','f_remarks'].forEach(id => {
    const el = document.getElementById(id);
    if (el.tagName === 'SELECT') el.selectedIndex = 0;
    else el.value = ['f_salvage','f_ogb','f_oad'].includes(id) ? '0' : '';
  });
  document.getElementById('f_fy').value = '2025-26';
}

