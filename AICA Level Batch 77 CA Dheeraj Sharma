/* ═══════════════════════════════════════════════════════
   SMART COLUMN MAPPER — auto-detects column names
═══════════════════════════════════════════════════════ */
const COLUMN_ALIASES = {
  id:       ['id','asset_id','assetid','asset id','sl no','sno','sl.no','s.no','sr no','sr.no','asset no','asset_no'],
  name:     ['name','asset_name','assetname','asset name','description','particulars','item','asset description'],
  group:    ['group','asset_group','assetgroup','category','class','type','asset_group','asset category','asset_type'],
  method:   ['method','dep_method','depreciation_method','depmethod','dep method','depreciation method','dep_type'],
  fy:       ['fy','financial_year','financialyear','financial year','year','fin_year','f.y.','f.y'],
  purchase: ['purchase','purchase_date','date_of_purchase','purchase date','dop','date of purchase','date_purchase','purchasedate'],
  ptu:      ['ptu','put_to_use','put to use','ptu_date','use_date','date_of_use','put_to_use_date','put to use date','date of use','commissioning_date'],
  cost:     ['cost','asset_cost','gross_value','gross value','original_cost','purchase_price','price','amount','capitalized_cost','gross_block_cost','total_cost'],
  salvage:  ['salvage','salvage_value','scrap_value','residual_value','residual','scrap','sv'],
  rate:     ['rate','dep_rate','depreciation_rate','wdv_rate','rate_percent','rate%','deprate','dep rate','wdv rate','rate (%)','rate(%)'],
  life:     ['life','useful_life','life_years','years','slm_life','useful life','life (years)','life(years)','asset_life'],
  ogb:      ['ogb','opening_gross_block','gross_block','opening_cost','opening gross block','op. gross block','op gross block','opening_gb'],
  oad:      ['oad','opening_accumulated_dep','acc_dep','accumulated_dep','opening_dep','opening acc dep','opening accumulated dep','op. acc dep','accumulated_depreciation','accum_dep'],
  remarks:  ['remarks','notes','comment','comments','description','location','place','remark'],
};

function detectColumn(headers, field) {
  const aliases = COLUMN_ALIASES[field] || [field];
  for (const alias of aliases) {
    const idx = headers.findIndex(h => h.toLowerCase().replace(/\s+/g,'') === alias.replace(/\s+/g,''));
    if (idx !== -1) return idx;
  }
  return -1;
}

function buildColumnMap(headers) {
  const map = {};
  const normalized = headers.map(h => h.trim());
  for (const field of Object.keys(COLUMN_ALIASES)) {
    map[field] = detectColumn(normalized, field);
  }
  return map;
}

function getVal(vals, idx, fallback = '') {
  if (idx === -1 || idx >= vals.length) return fallback;
  return (vals[idx] || '').toString().trim();
}

function cleanNumber(str) {
  // Remove ₹, commas, spaces, % signs
  const cleaned = String(str || '').replace(/[₹,\s%]/g, '').trim();
  const n = parseFloat(cleaned);
  return isNaN(n) ? 0 : n;
}

/* ═══════════════════════════════════════════════════════
   IMPORT CSV — flexible, with diagnostic output
═══════════════════════════════════════════════════════ */
function triggerImport() {
  document.getElementById('csv-import-input').value = '';
  document.getElementById('csv-import-input').click();
}

function importCSV(event) {
  const file = event.target.files[0];
  if (!file) return;
  if (!file.name.toLowerCase().endsWith('.csv')) {
    showToast('Please select a valid .csv file.', 'error'); return;
  }

  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const text = e.target.result.replace(/^\uFEFF/, ''); // strip BOM
      const lines = text.split(/\r?\n/).filter(l => l.trim());
      if (lines.length < 2) { showToast('CSV file is empty or has only headers.', 'error'); return; }

      const rawHeaders = parseCSVRow(lines[0]);
      const colMap = buildColumnMap(rawHeaders);

      // Check required columns detected
      const required = ['id','name','group','method','fy','purchase','ptu','cost'];
      const notFound = required.filter(f => colMap[f] === -1);
      if (notFound.length) {
        const resultDiv = document.getElementById('import-result');
        resultDiv.style.display = 'block';
        resultDiv.innerHTML = `<div class="alert" style="background:var(--red-light);border-left:3px solid var(--red);padding:14px;">
          <strong>❌ Required columns not found:</strong> ${notFound.join(', ')}<br><br>
          <strong>Your CSV headers:</strong> ${rawHeaders.join(', ')}<br><br>
          Please rename your columns to match any of the accepted names shown in the table above, then try again.
        </div>`;
        switchTab('add');
        return;
      }

      // Show detected mapping
      const detectedInfo = Object.entries(colMap)
        .filter(([,idx]) => idx !== -1)
        .map(([field, idx]) => `<span class="badge badge-slm">${field}</span> → <em>${rawHeaders[idx]}</em>`)
        .join(' &nbsp; ');

      const imported = [];
      const warnings = [];
      const skipped  = [];

      for (let i = 1; i < lines.length; i++) {
        const line = lines[i].trim();
        if (!line) continue;

        const vals = parseCSVRow(line);
        const r = {
          id:       getVal(vals, colMap.id),
          name:     getVal(vals, colMap.name),
          group:    getVal(vals, colMap.group),
          method:   getVal(vals, colMap.method).toUpperCase(),
          fy:       getVal(vals, colMap.fy),
          purchase: getVal(vals, colMap.purchase),
          ptu:      getVal(vals, colMap.ptu),
          cost:     cleanNumber(getVal(vals, colMap.cost)),
          salvage:  cleanNumber(getVal(vals, colMap.salvage)),
          rate:     cleanNumber(getVal(vals, colMap.rate)),
          life:     cleanNumber(getVal(vals, colMap.life)),
          ogb:      cleanNumber(getVal(vals, colMap.ogb)),
          oad:      cleanNumber(getVal(vals, colMap.oad)),
          remarks:  getVal(vals, colMap.remarks),
        };

        // Skip completely blank rows
        if (!r.id && !r.name && !r.cost) continue;

        // Skip header-repeat rows
        if (r.id.toLowerCase() === 'id' || r.id.toLowerCase() === 'asset id' || r.id.toLowerCase() === 'total') continue;

        const rowWarns = [];

        // Validate / auto-fix method
        if (!['WDV','SLM'].includes(r.method)) {
          rowWarns.push('Method "' + r.method + '" not recognised — defaulted to WDV');
          r.method = 'WDV';
        }

        // Auto-fix FY format: "2025-2026" → "2025-26", "202526" → "2025-26"
        if (r.fy && /^\d{8}$/.test(r.fy.replace('-',''))) {
          r.fy = r.fy.slice(0,4) + '-' + r.fy.slice(6,8);
        }
        if (!r.fy || r.fy.length < 4) {
          r.fy = '2025-26';
          rowWarns.push('FY not found — defaulted to 2025-26');
        }

        // Auto-fix dates (try multiple formats)
        r.purchase = normaliseDateStr(r.purchase) || r.ptu || '';
        r.ptu      = normaliseDateStr(r.ptu) || r.purchase || '';

        if (!r.ptu) rowWarns.push('Put-to-Use date missing — asset will show 0 depreciation until fixed');

        // Warn on missing rate/life but don't skip
        if (r.method === 'WDV' && !r.rate) rowWarns.push('WDV Rate is 0 — depreciation will be ₹0. Fix in asset register.');
        if (r.method === 'SLM' && !r.life) rowWarns.push('SLM Life is 0 — depreciation will be ₹0. Fix in asset register.');
        if (!r.cost)  rowWarns.push('Cost is 0 — check if cost column was mapped correctly.');
        if (!r.name)  rowWarns.push('Asset name is blank.');
        if (!r.id) {
          r.id = 'IMP-' + String(i).padStart(3,'0');
          rowWarns.push('ID was blank — auto-assigned ' + r.id);
        }

        // Duplicate check
        if (assets.find(a => a.id === r.id) || imported.find(a => a.id === r.id)) {
          skipped.push({ row: i+1, id: r.id, reason: 'Duplicate Asset ID' });
          continue;
        }

        if (rowWarns.length) warnings.push({ row: i+1, id: r.id, warns: rowWarns });
        imported.push(r);
      }

      if (!imported.length && !skipped.length) {
        showToast('No valid asset rows found in CSV.', 'error'); return;
      }

      assets = assets.concat(imported);
      renderAssetList();

      // ── Build diagnostic result panel ──────────────────
      const resultDiv = document.getElementById('import-result');
      let html = '';

      // Summary banner
      const hasIssues = warnings.length || skipped.length;
      html += `<div class="alert ${hasIssues ? 'alert-info' : 'alert-success'}" style="margin-bottom:12px">
        <strong>📥 Import Result:</strong> &nbsp;
        ✅ <strong>${imported.length}</strong> asset(s) imported &nbsp;|&nbsp;
        ⚠️ <strong>${warnings.length}</strong> with warnings &nbsp;|&nbsp;
        ❌ <strong>${skipped.length}</strong> skipped (duplicates)<br>
        <small style="color:var(--gray-500);margin-top:4px;display:block"><strong>Columns detected:</strong> ${detectedInfo}</small>
      </div>`;

      // Warning table
      if (warnings.length) {
        html += `<div style="margin-bottom:12px"><div class="section-label">⚠️ Assets Imported With Warnings — Fix before generating report</div>
        <div class="table-wrap"><table style="font-size:12px">
          <thead><tr><th>Row</th><th>Asset ID</th><th>Warnings</th><th>Action</th></tr></thead><tbody>`;
        warnings.forEach(w => {
          html += `<tr>
            <td>${w.row}</td>
            <td><code>${w.id}</code></td>
            <td style="color:var(--amber)">${w.warns.join('<br>')}</td>
            <td><button class="btn btn-sm" style="padding:4px 10px;border:1px solid var(--blue);color:var(--blue);background:transparent;font-size:11px" onclick="editAssetInline('${w.id}')">✏️ Fix</button></td>
          </tr>`;
        });
        html += `</tbody></table></div></div>`;
      }

      if (skipped.length) {
        html += `<div class="alert" style="background:var(--red-light);border-left:3px solid var(--red);padding:10px;margin-bottom:12px;font-size:12px">
          <strong>❌ Skipped:</strong> ${skipped.map(s => `Row ${s.row} (${s.id}): ${s.reason}`).join(' | ')}
        </div>`;
      }

      // Diagnostic preview table — first 10 imported rows
      html += `<div style="margin-bottom:14px"><div class="section-label">📋 Imported Data Preview (first 10 rows) — verify values before generating</div>
      <div class="table-wrap"><table style="font-size:12px">
        <thead><tr>
          <th>ID</th><th>Name</th><th>Group</th><th>Method</th><th>FY</th><th>PTU Date</th>
          <th class="right">Cost (₹)</th><th class="right">Rate/Life</th>
          <th class="right">OGB (₹)</th><th class="right">OAD (₹)</th><th>Status</th>
        </tr></thead><tbody>`;
      imported.slice(0, 10).forEach(a => {
        const hasW = warnings.find(w => w.id === a.id);
        const ok = !hasW && a.cost > 0 && (a.method === 'WDV' ? a.rate > 0 : a.life > 0) && a.ptu;
        const status = ok
          ? '<span style="color:var(--green)">✅ Ready</span>'
          : '<span style="color:var(--amber)">⚠️ Check</span>';
        html += `<tr style="${hasW ? 'background:var(--amber-light)' : ''}">
          <td><code>${a.id}</code></td>
          <td>${a.name || '<em style="color:var(--red)">blank</em>'}</td>
          <td>${a.group}</td>
          <td><span class="badge badge-${a.method.toLowerCase()}">${a.method}</span></td>
          <td>${a.fy}</td>
          <td>${a.ptu || '<em style="color:var(--red)">missing</em>'}</td>
          <td class="num">${a.cost > 0 ? INR(a.cost) : '<span style="color:var(--red)">₹0 !</span>'}</td>
          <td class="num">${a.method === 'WDV' ? (a.rate || '<span style="color:var(--red)">0%!</span>') + '%' : (a.life || '<span style="color:var(--red)">0!</span>') + ' yrs'}</td>
          <td class="num">${a.ogb > 0 ? INR(a.ogb) : '—'}</td>
          <td class="num">${a.oad > 0 ? INR(a.oad) : '—'}</td>
          <td>${status}</td>
        </tr>`;
      });
      if (imported.length > 10) {
        html += `<tr><td colspan="11" style="text-align:center;color:var(--gray-500);font-style:italic">… and ${imported.length - 10} more asset(s)</td></tr>`;
      }
      html += `</tbody></table></div></div>`;

      // Generate report CTA
      html += `<div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:14px;background:var(--gray-50);border-radius:var(--radius-sm);border:1.5px solid var(--gray-200)">
        <button class="btn btn-primary" onclick="generateReport()" style="background:linear-gradient(135deg,#16a34a,#0d9488);font-size:14px;padding:12px 28px;">
          ⚡ Generate Full Report →
        </button>
        <div style="font-size:12px;color:var(--gray-600);line-height:1.6">
          <strong>Before clicking:</strong> Fix any ⚠️ assets using the Fix button above.<br>
          Assets with ₹0 cost or 0% rate will show ₹0 depreciation.
        </div>
      </div>`;

      resultDiv.innerHTML = html;
      resultDiv.style.display = 'block';
      switchTab('add');

      showToast('✅ ' + imported.length + ' asset(s) imported.' + (warnings.length ? ' ' + warnings.length + ' need attention.' : ' Click ⚡ Generate Report!'),
        warnings.length ? 'warning' : 'success');

    } catch(err) {
      showToast('Error reading CSV: ' + err.message, 'error');
      console.error(err);
    }
  };
  reader.onerror = () => showToast('Failed to read file. Please try again.', 'error');
  reader.readAsText(file, 'UTF-8');
}

// Normalise any date string to YYYY-MM-DD (for consistent parseDate)
function normaliseDateStr(str) {
  if (!str) return '';
  str = str.trim();
  // Already ISO
  if (/^\d{4}-\d{2}-\d{2}$/.test(str)) return str;
  // DD-MM-YYYY or DD/MM/YYYY
  const m1 = str.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{4})$/);
  if (m1) return `${m1[3]}-${m1[2].padStart(2,'0')}-${m1[1].padStart(2,'0')}`;
  // MM-DD-YYYY
  const m2 = str.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{4})$/);
  if (m2) return `${m2[3]}-${m2[1].padStart(2,'0')}-${m2[2].padStart(2,'0')}`;
  // Excel serial number (e.g. 45000)
  if (/^\d{5}$/.test(str)) {
    const d = new Date(Date.UTC(1899,11,30) + parseInt(str)*86400000);
    return d.toISOString().slice(0,10);
  }
  // Try native parse
  const d = new Date(str);
  if (!isNaN(d.getTime())) return d.toISOString().slice(0,10);
  return '';
}

