# Server
PORT=4000
NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-string

# Database (SQLite file). Keep this file on local disk of the server PC, not a network share.
DATABASE_URL="file:./data/cadocs.db"

# Storage root folders (can also be overridden at runtime via Settings screen -> stored in DB;
# these are only the bootstrap defaults used before the DB has settings rows).
TEMPLATE_FOLDER=./storage/templates
GENERATED_FOLDER=./storage/generated
BACKUP_FOLDER=./storage/backups

# PDF engine: path to LibreOffice's soffice executable (must be installed on the server PC)
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
# Must point at the soffice.exe FILE, not the folder it's in. This is the
# standard install location on Windows - adjust only if you installed
# LibreOffice somewhere else.
SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Default Template Management password (only used on first run to seed AdminUser;
# change immediately from Settings screen after first login).
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
