{
  "id": "/",
  "name": "ABC Private Limited - Travel & Expense",
  "short_name": "ABC Travel",
  "description": "Pre-travel approval, booking, expense statements with bills, approvals and reimbursement for ABC Private Limited.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f3d6e",
  "theme_color": "#0f3d6e",
  "lang": "en-IN",
  "categories": ["business", "finance", "productivity", "travel"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New Travel Request", "short_name": "New Request", "url": "/#/new", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My Approvals", "short_name": "Approvals", "url": "/#/approvals", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My Trips & Claims", "short_name": "My Trips", "url": "/#/requests", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": [
    { "src": "/icons/screenshot-wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Travel analytics dashboard" },
    { "src": "/icons/screenshot-narrow.png", "sizes": "540x1080", "type": "image/png", "form_factor": "narrow", "label": "Travel request on mobile" }
  ]
}
