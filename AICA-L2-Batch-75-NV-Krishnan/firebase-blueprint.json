{
  "entities": {
    "Service": {
      "title": "Statutory Service",
      "description": "Top-level statutory compliance service folder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "retentionPeriodYears": { "type": "number" },
        "statutoryAct": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "title", "retentionPeriodYears", "statutoryAct"]
    },
    "Client": {
      "title": "Client Entity",
      "description": "Client organization or individual entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "entityType": { "type": "string", "enum": ["company", "llp", "partnership", "proprietorship", "individual"] },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "entityType"]
    },
    "Engagement": {
      "title": "Service Engagement Sub-Folder",
      "description": "Engagement sub-folder under a service for a specific client",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceId": { "type": "string" },
        "clientId": { "type": "string" },
        "financialYear": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "consentStatus": { "type": "string" },
        "contractEndDate": { "type": "string" },
        "erasureDueDate": { "type": "string" }
      },
      "required": ["id", "serviceId", "clientId", "financialYear", "title"]
    },
    "User": {
      "title": "Portal User",
      "description": "User profile with role-based access",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["full_admin", "team_member", "client"] },
        "linkedClientId": { "type": "string" },
        "isActive": { "type": "boolean" },
        "displayName": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "EngagementDocument": {
      "title": "Engagement Document",
      "description": "Document file associated with an engagement folder with role-based visibility",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "fileName": { "type": "string" },
        "storagePath": { "type": "string" },
        "url": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "uploadedByUid": { "type": "string" },
        "uploadedByName": { "type": "string" },
        "uploadedByRole": { "type": "string", "enum": ["full_admin", "team_member", "client"] },
        "fileType": { "type": "string" },
        "fileSize": { "type": "number" }
      },
      "required": ["id", "name", "uploadedByRole"]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Statutory services reference catalog"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Client directory"
    },
    "/engagements/{engagementId}": {
      "schema": "Engagement",
      "description": "Client engagement folders"
    },
    "/engagements/{engagementId}/documents/{docId}": {
      "schema": "EngagementDocument",
      "description": "Uploaded documents and internal working papers"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    }
  }
}
