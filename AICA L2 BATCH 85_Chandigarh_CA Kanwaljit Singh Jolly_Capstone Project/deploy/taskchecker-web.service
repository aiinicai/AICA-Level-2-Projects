[Unit]
Description=Task Checker web API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=taskchecker
Group=taskchecker
WorkingDirectory=/opt/taskchecker
EnvironmentFile=/etc/taskchecker/taskchecker.env
ExecStart=/opt/taskchecker/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --timeout 120 app_standalone:app
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp /var/log/taskchecker

[Install]
WantedBy=multi-user.target
