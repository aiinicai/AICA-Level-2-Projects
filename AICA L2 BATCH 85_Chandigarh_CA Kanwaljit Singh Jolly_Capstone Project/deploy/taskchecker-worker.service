[Unit]
Description=Task Checker Codex validation worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=taskchecker
Group=taskchecker
WorkingDirectory=/opt/taskchecker
EnvironmentFile=/etc/taskchecker/taskchecker.env
ExecStart=/opt/taskchecker/.venv/bin/python worker.py
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp /var/log/taskchecker
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
