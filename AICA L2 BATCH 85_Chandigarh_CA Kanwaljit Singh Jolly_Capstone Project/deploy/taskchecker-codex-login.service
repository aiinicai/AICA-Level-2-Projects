[Unit]
Description=Task Checker Codex device-login worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=taskchecker
Group=taskchecker
WorkingDirectory=/opt/taskchecker
EnvironmentFile=/etc/taskchecker/taskchecker.env
ExecStart=/opt/taskchecker/.venv/bin/python codex_login_worker.py
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp /var/log/taskchecker

[Install]
WantedBy=multi-user.target
