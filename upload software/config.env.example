# ============================================================
# AccuSheet Pro — Configuration File
# ============================================================
# Place this file next to AccuSheet Pro.exe  (or in the same
# folder as the installer after installation).
#
# REQUIRED: Your Google Gemini API Key
# Get one free at: https://aistudio.google.com/apikey
# ============================================================

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: override the default server port (default: 3000)
# PORT=3000
