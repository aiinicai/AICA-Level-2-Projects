{
  "name": "accusheet-pro",
  "productName": "AccuSheet Pro",
  "private": true,
  "version": "1.0.0",
  "description": "Non-Corporate Balance Sheet & Working Papers — Desktop App for Chartered Accountants",
  "author": "AccuSheet Pro",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node node_modules/vite/bin/vite.js build && node node_modules/esbuild/bin/esbuild server.ts --bundle --platform=node --format=cjs --external:vite --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "lint": "tsc --noEmit",
    "electron:dev": "npm run build && node node_modules/electron/cli.js .",
    "electron:build": "npm run build && node node_modules/electron-builder/cli.js --win --x64",
    "electron:build:dir": "npm run build && node node_modules/electron-builder/cli.js --win --x64 --dir"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/express": "^4.17.21",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "build": {
    "appId": "com.accusheet.pro",
    "productName": "AccuSheet Pro",
    "copyright": "Copyright © 2024 AccuSheet Pro",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**",
      "dist/**",
      "node_modules/**",
      "!node_modules/.bin/**",
      "!node_modules/**/test/**",
      "!node_modules/**/*.md",
      "!node_modules/**/*.map",
      "!**/*.ts",
      "!src/**",
      "!electron/**/*.map"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "config.env.example",
        "to": "config.env.example"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "sign": null,
      "signingHashAlgorithms": null,
      "certificateFile": null,
      "certificatePassword": null,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "en_US"
      ],
      "license": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AccuSheet Pro"
    },
    "compression": "maximum"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
