{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "Chartered accountant office compliance task assigned to staff or admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "assignedTo": {
          "type": "string",
          "maxLength": 100
        },
        "deadline": {
          "type": "string",
          "maxLength": 20
        },
        "isUrgent": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        },
        "completedAt": {
          "type": "string",
          "maxLength": 50
        },
        "completedBy": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "id",
        "title",
        "completed",
        "createdAt"
      ]
    },
    "OfficeSettings": {
      "title": "OfficeSettings",
      "description": "General settings and presets for CA firm operations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "officeDistrict": {
          "type": "string",
          "maxLength": 100
        },
        "officeState": {
          "type": "string",
          "maxLength": 50
        },
        "defaultNicCode": {
          "type": "string",
          "maxLength": 150
        },
        "staffMembers": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "id"
      ]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Compliance tasks and staff to-do items for the firm"
    },
    "/officeSettings/{settingId}": {
      "schema": "OfficeSettings",
      "description": "Global office settings and presets"
    }
  }
}
