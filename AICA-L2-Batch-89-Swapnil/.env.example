# Copy to .env (or just run `python cli.py init-db`, which creates .env with fresh keys).
# NEVER commit .env.

# Flask session signing key: any long random string
SECRET_KEY=change-me-to-a-long-random-string

# Fernet key for encrypting PAN at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Optional. Default: SQLite at instance/mca.db (relative paths resolve to the project folder).
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mca

# 1 = cookies only over HTTPS (browsers also accept them on http://localhost). Set 0 for plain-http LAN use.
SESSION_COOKIE_SECURE=1

# Optional SMTP for the reminder digest (Phase 4)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
