{
  "framework": "Companies Act 2013, Schedule III, Division I (non-Ind AS)",
  "lines": {
    "EQ.SC":   {"label": "Share capital", "statement": "BS", "section": "Shareholders' funds", "side": "L", "order": 110},
    "EQ.RS":   {"label": "Reserves and surplus", "statement": "BS", "section": "Shareholders' funds", "side": "L", "order": 120},
    "NCL.LTB": {"label": "Long-term borrowings", "statement": "BS", "section": "Non-current liabilities", "side": "L", "order": 210},
    "NCL.DTL": {"label": "Deferred tax liabilities (net)", "statement": "BS", "section": "Non-current liabilities", "side": "L", "order": 220},
    "NCL.OLL": {"label": "Other long-term liabilities", "statement": "BS", "section": "Non-current liabilities", "side": "L", "order": 230},
    "NCL.LTP": {"label": "Long-term provisions", "statement": "BS", "section": "Non-current liabilities", "side": "L", "order": 240},
    "CL.STB":  {"label": "Short-term borrowings", "statement": "BS", "section": "Current liabilities", "side": "L", "order": 310},
    "CL.TP":   {"label": "Trade payables", "statement": "BS", "section": "Current liabilities", "side": "L", "order": 320},
    "CL.OCL":  {"label": "Other current liabilities", "statement": "BS", "section": "Current liabilities", "side": "L", "order": 330},
    "CL.STP":  {"label": "Short-term provisions", "statement": "BS", "section": "Current liabilities", "side": "L", "order": 340},
    "NCA.PPE":  {"label": "Property, plant and equipment", "statement": "BS", "section": "Non-current assets", "side": "A", "order": 410},
    "NCA.INTG": {"label": "Intangible assets", "statement": "BS", "section": "Non-current assets", "side": "A", "order": 420},
    "NCA.CWIP": {"label": "Capital work-in-progress", "statement": "BS", "section": "Non-current assets", "side": "A", "order": 430},
    "NCA.NCI":  {"label": "Non-current investments", "statement": "BS", "section": "Non-current assets", "side": "A", "order": 440},
    "NCA.DTA":  {"label": "Deferred tax assets (net)", "statement": "BS", "section": "Non-current assets", "side": "A", "order": 450},
    "NCA.LTLA": {"label": "Long-term loans and advances", "statement": "BS", "section": "Non-current assets", "side": "A", "order": 460},
    "NCA.ONCA": {"label": "Other non-current assets", "statement": "BS", "section": "Non-current assets", "side": "A", "order": 470},
    "CA.CI":   {"label": "Current investments", "statement": "BS", "section": "Current assets", "side": "A", "order": 510},
    "CA.INV":  {"label": "Inventories", "statement": "BS", "section": "Current assets", "side": "A", "order": 520},
    "CA.TR":   {"label": "Trade receivables", "statement": "BS", "section": "Current assets", "side": "A", "order": 530},
    "CA.CBB":  {"label": "Cash and bank balances", "statement": "BS", "section": "Current assets", "side": "A", "order": 540},
    "CA.STLA": {"label": "Short-term loans and advances", "statement": "BS", "section": "Current assets", "side": "A", "order": 550},
    "CA.OCA":  {"label": "Other current assets", "statement": "BS", "section": "Current assets", "side": "A", "order": 560},
    "REV.OPS": {"label": "Revenue from operations", "statement": "PL", "section": "Income", "side": "L", "order": 610},
    "REV.OI":  {"label": "Other income", "statement": "PL", "section": "Income", "side": "L", "order": 620},
    "EXP.COM": {"label": "Cost of materials consumed", "statement": "PL", "section": "Expenses", "side": "A", "order": 710},
    "EXP.PST": {"label": "Purchases of stock-in-trade", "statement": "PL", "section": "Expenses", "side": "A", "order": 720},
    "EXP.CHI": {"label": "Changes in inventories of finished goods, work-in-progress and stock-in-trade", "statement": "PL", "section": "Expenses", "side": "A", "order": 730},
    "EXP.EMP": {"label": "Employee benefit expense", "statement": "PL", "section": "Expenses", "side": "A", "order": 740},
    "EXP.FIN": {"label": "Finance costs", "statement": "PL", "section": "Expenses", "side": "A", "order": 750},
    "EXP.DEP": {"label": "Depreciation and amortisation expense", "statement": "PL", "section": "Expenses", "side": "A", "order": 760},
    "EXP.OTH": {"label": "Other expenses", "statement": "PL", "section": "Expenses", "side": "A", "order": 770},
    "TAX.CUR": {"label": "Current tax", "statement": "PL", "section": "Tax expense", "side": "A", "order": 810},
    "TAX.DEF": {"label": "Deferred tax", "statement": "PL", "section": "Tax expense", "side": "A", "order": 820}
  },
  "rules": [
    {"id": "R-SC", "groups": ["Capital Account"], "line": "EQ.SC", "sub": "Equity share capital",
     "cases": [{"name": "preference", "line": "EQ.SC", "sub": "Preference share capital", "review": "Check redemption terms: redeemable preference shares are a liability (AS 31 / Sch III)"}]},
    {"id": "R-RS", "groups": ["Reserves & Surplus"], "line": "EQ.RS", "sub": "Other reserves",
     "cases": [
       {"name": "general reserve", "line": "EQ.RS", "sub": "General reserve"},
       {"name": "securities premium|share premium", "line": "EQ.RS", "sub": "Securities premium"},
       {"name": "capital reserve", "line": "EQ.RS", "sub": "Capital reserve"},
       {"name": "revaluation", "line": "EQ.RS", "sub": "Revaluation reserve"}]},
    {"id": "R-PLAC", "groups": ["Primary"],
     "cases": [{"name": "profit.*loss", "line": "EQ.RS", "sub": "Surplus in statement of profit and loss (brought forward)"}]},
    {"id": "R-SL", "groups": ["Secured Loans"], "line": "NCL.LTB", "sub": "Term loans from banks (secured)",
     "review": "Long-term vs short-term cannot be told from Tally. Instalments due within 12 months (current maturities) belong in other current liabilities; add the repayment schedule.",
     "cases": [{"name": "overdraft|cash credit|\\bcc\\b|working capital|wcdl", "line": "CL.STB", "sub": "Cash credit / working capital loans (secured)"}]},
    {"id": "R-UL", "groups": ["Unsecured Loans"], "line": "NCL.LTB", "sub": "Other unsecured loans",
     "review": "Confirm long-term vs short-term and repayment terms.",
     "cases": [{"name": "director|promoter|shareholder|relative|related|holding|subsidiary|associate", "line": "NCL.LTB",
                "sub": "Loans from directors / related parties (unsecured)",
                "review": "Related-party loan: needs related-party disclosure (AS 18), Sec 73/Rule 2(1)(c)(viii) declaration from director, and repayment terms. Confirm long-term."}]},
    {"id": "R-OD", "groups": ["Bank OD A/c"], "line": "CL.STB", "sub": "Bank overdraft (secured)"},
    {"id": "R-LL", "groups": ["Loans (Liability)"], "line": "NCL.LTB", "sub": "Other loans",
     "review": "Ledger sits directly under Loans (Liability); confirm secured/unsecured and tenor."},
    {"id": "R-SCR", "groups": ["Sundry Creditors"], "line": "CL.TP", "sub": "Trade payables",
     "normal": "Cr",
     "wrong_sign": {"line": "CA.STLA", "sub": "Advances to suppliers (debit balance in creditor)",
                    "review": "Debit balance in a creditor is an advance, shown as an asset; Schedule III does not allow netting against other parties."}},
    {"id": "R-DT", "groups": ["Duties & Taxes"], "line": "CL.OCL", "sub": "Statutory dues payable",
     "net": {"key_regex": "(CGST|SGST|UTGST|IGST)",
             "credit": {"line": "CL.OCL", "sub": "Statutory dues: GST payable (net of input tax credit)"},
             "debit": {"line": "CA.OCA", "sub": "Balances with government authorities (GST input credit)",
                       "review": "Net GST input credit is an asset; confirm it is recoverable and matches GSTR-3B."}},
     "cases": [{"name": "tds|tcs", "line": "CL.OCL", "sub": "Statutory dues: TDS / TCS payable"},
               {"name": "\bpf\b|provident|\besi\b|professional tax", "line": "CL.OCL", "sub": "Statutory dues: PF / ESI / professional tax"}]},
    {"id": "R-PROV", "groups": ["Provisions"], "line": "CL.STP", "sub": "Other provisions",
     "cases": [
       {"name": "^outstanding|^accrued|payable|\\bdue\\b", "line": "CL.OCL", "sub": "Outstanding expenses",
        "review": "Expenses already incurred and payable are not 'provisions' (AS 29); shown under other current liabilities."},
       {"name": "income tax|taxation|\\btax\\b", "line": "CL.STP", "sub": "Provision for tax"},
       {"name": "gratuity|leave|bonus|employee", "line": "CL.STP", "sub": "Provision for employee benefits"}]},
    {"id": "R-CL", "groups": ["Current Liabilities"], "line": "CL.OCL", "sub": "Other payables",
     "review": "Ledger sits directly under Current Liabilities; confirm its nature."},
    {"id": "R-SUSP", "groups": ["Suspense A/c"], "line": "CL.OCL", "sub": "Suspense balances",
     "review": "Suspense balances must be cleared and classified before finalisation."},
    {"id": "R-BR", "groups": ["Branch / Divisions"], "line": "CL.OCL", "sub": "Inter-branch balances",
     "review": "Inter-branch balances should eliminate on combination; confirm."},
    {"id": "R-FA", "groups": ["Fixed Assets"], "line": "NCA.PPE", "sub": "Other property, plant and equipment",
     "cases": [
       {"name": "capital work|cwip|work.in.progress", "line": "NCA.CWIP", "sub": "Capital work-in-progress"},
       {"name": "software|licen[cs]e|goodwill|patent|trademark|copyright|intangible", "line": "NCA.INTG", "sub": "Intangible assets"},
       {"name": "\\bland\\b", "line": "NCA.PPE", "sub": "Land"},
       {"name": "building|premises|factory shed", "line": "NCA.PPE", "sub": "Buildings"},
       {"name": "plant|machin", "line": "NCA.PPE", "sub": "Plant and equipment"},
       {"name": "furniture", "line": "NCA.PPE", "sub": "Furniture and fixtures"},
       {"name": "computer", "line": "NCA.PPE", "sub": "Computers"},
       {"name": "vehicle|\\bcar\\b|truck|scooter", "line": "NCA.PPE", "sub": "Vehicles"},
       {"name": "office equip", "line": "NCA.PPE", "sub": "Office equipment"}]},
    {"id": "R-INV", "groups": ["Investments"], "line": "NCA.NCI", "sub": "Non-current investments",
     "review": "Confirm current vs non-current, and quoted vs unquoted (Sch III note).",
     "cases": [{"name": "fixed deposit|\\bfd\\b|term deposit|deposit", "line": "CA.CBB", "sub": "Other bank balances (bank deposits)",
                "review": "A bank deposit is not an 'investment' under Schedule III. Confirm maturity: over 12 months is an other non-current asset; up to 3 months is a cash equivalent."}]},
    {"id": "R-STK", "groups": ["Stock-in-Hand"], "line": "CA.INV", "sub": "Other inventories", "inventory_pl_line": "EXP.CHI",
     "cases": [
       {"name": "^opening stock$", "line": "CA.INV", "sub": "Stock in hand (as shown in the trial balance)", "inventory_pl_line": "EXP.CHI",
        "review": "Tally's trial balance shows stock as one 'Opening Stock' line and does not include the closing stock. Confirm the closing stock value for the year; split it into raw materials, work-in-progress and finished goods."},
       {"name": "raw material|\\brm\\b", "line": "CA.INV", "sub": "Raw materials", "inventory_pl_line": "EXP.COM"},
       {"name": "finished|\\bfg\\b", "line": "CA.INV", "sub": "Finished goods", "inventory_pl_line": "EXP.CHI"},
       {"name": "work.in|wip|semi", "line": "CA.INV", "sub": "Work-in-progress", "inventory_pl_line": "EXP.CHI"},
       {"name": "stores|spares|consumable|packing", "line": "CA.INV", "sub": "Stores and spares", "inventory_pl_line": "EXP.COM"},
       {"name": "traded|trading|stock.in.trade", "line": "CA.INV", "sub": "Stock-in-trade", "inventory_pl_line": "EXP.CHI"}]},
    {"id": "R-SD", "groups": ["Sundry Debtors"], "line": "CA.TR", "sub": "Trade receivables", "normal": "Dr",
     "wrong_sign": {"line": "CL.OCL", "sub": "Advances from customers (credit balance in debtor)",
                    "review": "Credit balance in a debtor is an advance received, shown as a liability; Schedule III does not allow netting against other parties."}},
    {"id": "R-CASH", "groups": ["Cash-in-Hand"], "line": "CA.CBB", "sub": "Cash on hand"},
    {"id": "R-BANK", "groups": ["Bank Accounts"], "line": "CA.CBB", "sub": "Balances with banks (current accounts)", "normal": "Dr",
     "cases": [{"name": "fixed deposit|\\bfd\\b|deposit", "line": "CA.CBB", "sub": "Other bank balances (bank deposits)"}],
     "wrong_sign": {"line": "CL.STB", "sub": "Bank overdraft (credit balance in bank ledger)",
                    "review": "Credit balance in a bank ledger: confirm overdraft vs unpresented cheques."}},
    {"id": "R-DEPA", "groups": ["Deposits (Asset)"], "line": "NCA.LTLA", "sub": "Security deposits",
     "review": "Confirm long-term vs short-term."},
    {"id": "R-LA", "groups": ["Loans & Advances (Asset)"], "line": "CA.STLA", "sub": "Advances recoverable in cash or kind",
     "cases": [{"name": "director|promoter|related|employee|staff|holding|subsidiary", "line": "CA.STLA",
                "sub": "Loans and advances to related parties / employees",
                "review": "Related-party loans/advances need Schedule III disclosure (loans to promoters/directors/KMP) and AS 18 disclosure."}]},
    {"id": "R-CA", "groups": ["Current Assets"], "line": "CA.OCA", "sub": "Other current assets",
     "review": "Ledger sits directly under Current Assets; confirm its nature."},
    {"id": "R-MISC", "groups": ["Misc. Expenses (ASSET)"], "line": "CA.OCA", "sub": "Unamortised expenses",
     "review": "AS 26: preliminary and similar expenses must be written off as incurred; confirm."},

    {"id": "R-SALES", "groups": ["Sales Accounts"], "line": "REV.OPS", "sub": "Sale of products",
     "cases": [{"name": "service|job work income|labour income", "line": "REV.OPS", "sub": "Sale of services"}]},
    {"id": "R-DI", "groups": ["Direct Incomes"], "line": "REV.OPS", "sub": "Other operating revenues"},
    {"id": "R-II", "groups": ["Indirect Incomes"], "line": "REV.OI", "sub": "Other non-operating income",
     "cases": [
       {"name": "interest", "line": "REV.OI", "sub": "Interest income"},
       {"name": "dividend", "line": "REV.OI", "sub": "Dividend income"},
       {"name": "profit on sale|gain|capital gain", "line": "REV.OI", "sub": "Net gain on sale of assets / investments"},
       {"name": "exchange|forex", "line": "REV.OI", "sub": "Net gain on foreign currency transactions"},
       {"name": "rent", "line": "REV.OI", "sub": "Rental income"}]},
    {"id": "R-PUR", "groups": ["Purchase Accounts"], "line": "EXP.COM", "sub": "Purchases of raw materials",
     "cases": [{"name": "stock.in.trade|trading goods|traded", "line": "EXP.PST", "sub": "Purchases of stock-in-trade"}]},
    {"id": "R-DE", "groups": ["Direct Expenses"], "line": "EXP.OTH", "sub": "Other direct expenses",
     "cases": [
       {"name": "freight inward|carriage inward|inward freight|import duty|customs", "line": "EXP.COM", "sub": "Freight and direct costs of materials"},
       {"name": "wages|labour|salary|salaries", "line": "EXP.EMP", "sub": "Factory wages"},
       {"name": "power|fuel|electric", "line": "EXP.OTH", "sub": "Power and fuel"},
       {"name": "job work|processing|machining", "line": "EXP.OTH", "sub": "Job work charges"}]},
    {"id": "R-IE", "groups": ["Indirect Expenses"], "line": "EXP.OTH", "sub": "Miscellaneous expenses",
     "cases": [
       {"name": "depreciation|amortis", "line": "EXP.DEP", "sub": "Depreciation and amortisation"},
       {"name": "income tax|advance tax", "line": "TAX.CUR", "sub": "Current tax",
        "review": "Income tax is booked under indirect expenses; reclassify to tax expense."},
       {"name": "interest (on|paid)|interest expense|loan processing|finance charge", "line": "EXP.FIN", "sub": "Interest expense"},
       {"name": "director.?s? (remuneration|salary|sitting)|managerial|remuneration", "line": "EXP.EMP", "sub": "Directors' remuneration",
        "review": "Key managerial personnel: related-party disclosure (AS 18) and Sec 197 / Sch V limits."},
       {"name": "salar|wages|bonus|gratuity|provident|\\bpf\\b|\\besi\\b|staff welfare|employee", "line": "EXP.EMP", "sub": "Salaries, wages and staff welfare"},
       {"name": "audit fee|auditor", "line": "EXP.OTH", "sub": "Payment to auditors",
        "review": "Schedule III requires the split: audit fee, tax audit, other services, reimbursements."},
       {"name": "\\brent\\b", "line": "EXP.OTH", "sub": "Rent"},
       {"name": "repairs?.*machin|machin.*repairs?", "line": "EXP.OTH", "sub": "Repairs to machinery"},
       {"name": "repairs?.*(building|premises)|(building|premises).*repairs?", "line": "EXP.OTH", "sub": "Repairs to buildings"},
       {"name": "repairs|maintenance", "line": "EXP.OTH", "sub": "Repairs and maintenance (others)"},
       {"name": "insurance", "line": "EXP.OTH", "sub": "Insurance"},
       {"name": "legal|professional|consult", "line": "EXP.OTH", "sub": "Legal and professional fees"},
       {"name": "advert|sales promotion|commission|discount allowed|freight outward|carriage outward|selling|distribution", "line": "EXP.OTH", "sub": "Selling and distribution expenses"},
       {"name": "travel|conveyance", "line": "EXP.OTH", "sub": "Travelling and conveyance"},
       {"name": "telephone|communication|internet", "line": "EXP.OTH", "sub": "Communication expenses"},
       {"name": "printing|stationery", "line": "EXP.OTH", "sub": "Printing and stationery"},
       {"name": "rates and taxes|licen[cs]e fee|roc fee|filing fee", "line": "EXP.OTH", "sub": "Rates and taxes"},
       {"name": "bank charges", "line": "EXP.OTH", "sub": "Bank charges"},
       {"name": "bad debt", "line": "EXP.OTH", "sub": "Bad debts written off"},
       {"name": "csr|donation", "line": "EXP.OTH", "sub": "Donations / CSR",
        "review": "CSR obligation under Sec 135 may apply; confirm."}]}
  ]
}
