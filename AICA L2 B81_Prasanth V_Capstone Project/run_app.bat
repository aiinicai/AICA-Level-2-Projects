@echo off
title Asset Tagging & Label Management System
cls

echo =====================================================================
echo    ASSET TAGGING ^& LABEL MANAGEMENT SYSTEM (ENTERPRISE v1.0)
echo =====================================================================
echo.

:: ?????????????????????????????????????????????????????????????????????
:: STEP 1: Verify Python is installed
:: ?????????????????????????????????????????????????????????????????????
echo [STEP 1/4] Checking Python installation...
python --version >nul 2>&1
if errorlevel 1 (
    echo.
    echo  *** ERROR: Python is NOT installed or not found in PATH ***
    echo.
    echo  Please install Python 3.10+ from:
    echo  https://www.python.org/downloads/
    echo.
    echo  IMPORTANT: During install, check "Add Python to PATH"
    echo.
    pause
    exit /b 1
)
for /f "tokens=*" %%v in ('python --version 2^>^&1') do echo [OK] Found: %%v
echo.

:: ?????????????????????????????????????????????????????????????????????
:: STEP 2: Upgrade pip to latest
:: ?????????????????????????????????????????????????????????????????????
echo [STEP 2/4] Upgrading pip...
python -m pip install --upgrade pip --quiet --no-warn-script-location
echo [OK] pip is up to date.
echo.

:: ?????????????????????????????????????????????????????????????????????
:: STEP 3: Install ALL required packages
:: (Safe to re-run - skips already installed ones)
:: ?????????????????????????????????????????????????????????????????????
echo [STEP 3/4] Installing all required packages...
echo            (First run may take 2-3 minutes - please wait)
echo.

python -m pip install ^
    "fastapi>=0.115.0" ^
    "uvicorn[standard]>=0.30.0" ^
    "sqlalchemy>=2.0.0" ^
    "pydantic>=2.8.0" ^
    "pydantic[email]>=2.8.0" ^
    "email-validator>=2.0.0" ^
    "python-jose[cryptography]>=3.3.0" ^
    "passlib[bcrypt]>=1.7.4" ^
    "bcrypt>=4.0.0" ^
    "openpyxl>=3.1.0" ^
    "python-multipart>=0.0.9" ^
    "reportlab>=4.2.0" ^
    "pillow>=10.0.0" ^
    "qrcode[pil]>=7.4.2" ^
    "python-barcode>=0.15.1" ^
    "python-docx>=1.1.0" ^
    "httpx>=0.27.0" ^
    "pytest>=8.0.0" ^
    "pywin32>=306" ^
    --no-warn-script-location

if errorlevel 1 (
    echo.
    echo  *** ERROR: Package installation failed ***
    echo  Check your internet connection and try again.
    echo.
    pause
    exit /b 1
)
echo.
echo [OK] All packages installed successfully.
echo.

:: ?????????????????????????????????????????????????????????????????????
:: STEP 4: Run automated test suite
:: ?????????????????????????????????????????????????????????????????????
echo [STEP 4/4] Running automated acceptance tests...
echo            (This verifies the app is working correctly)
echo.

python -m pytest "%~dp0tests\test_system.py" -v --tb=short --no-header -q

if errorlevel 1 (
    echo.
    echo  [WARN] Some tests had issues - launching app anyway.
    echo         See test output above for details.
) else (
    echo.
    echo  [OK] ALL TESTS PASSED!
)
echo.

:: ?????????????????????????????????????????????????????????????????????
:: LAUNCH APP
:: ?????????????????????????????????????????????????????????????????????
echo =====================================================================
echo  Starting server... Browser will open at http://localhost:8000
echo =====================================================================
echo.

python "%~dp0launcher.py"

echo.
echo  Server stopped. Press any key to close.
pause
