# LeaseIQ Pro - optional settings.
# Copy this file to ".env" and fill in ONLY what you need. The application runs without it:
# everything except the AI reading of a lease PDF / Word file works with no key at all.

# AI extraction (optional): create your own free key at https://aistudio.google.com/apikey and paste it here.
AI_PROVIDER=gemini
AI_API_KEY=your_free_tier_api_key_here

# Optional: which Gemini model(s) to use, in order of preference (comma separated). Leave commented to use the built-in list.
# AI_MODEL=gemini-flash-latest,gemini-3.5-flash

# Optional: database location (default: leaseiq.db in this folder).
# LEASEIQ_DB_URL=sqlite:///leaseiq.db

# Optional: set to 1 if the AI cannot connect on your network (forces IPv4).
# AI_FORCE_IPV4=1
