{
  "name": "Sample Advisory Lead and Meeting Tracker",
  "short_name": "MF Tracker",
  "description": "Leads, meetings, follow ups plus investor network for Sample Advisory Private Limited",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F6F8FA",
  "theme_color": "#0E5E54",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today's actions", "url": "./#today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Meeting tracker", "url": "./#meetings", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
