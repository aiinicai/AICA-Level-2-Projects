{
  "name": "dealflow-lead-tracker",
  "productName": "Sample Advisory Lead and Meeting Tracker",
  "version": "1.1.1",
  "description": "Lead, meeting and investor tracker for Sample Advisory Private Limited",
  "author": "Sample Advisory Private Limited",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win-portable": "electron-builder --win zip --x64",
    "test": "electron test/smoke.js"
  },
  "dependencies": {
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.leadtracker",
    "productName": "Sample Advisory Lead and Meeting Tracker",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "app/**/*",
      "package.json",
      "!test/**",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/*.zip",
      "!node_modules/sql.js/dist/*debug*",
      "!node_modules/sql.js/dist/*browser*",
      "!node_modules/sql.js/dist/worker*",
      "!node_modules/sql.js/.devcontainer/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sample Advisory Tracker"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Office"
    },
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ]
  }
}
