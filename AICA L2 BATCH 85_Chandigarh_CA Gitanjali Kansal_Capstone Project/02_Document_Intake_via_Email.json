    {
      "parameters": {
        "jsCode": "const folder = $input.all()[0].json;\nconst crm = $('Pick Most Recent Client Match').first().json;\nconst triggerItem = $('Watch Inbox for Client Documents').first();\n\nconst clientName = crm.name || 'Unknown';\nconst clientEmail = crm.email || '';\nconst itrType = crm.itr_type || 'ITR-1';\nconst clientDob = crm.date_of_birth != null ? String(crm.date_of_birth) : '';\nconst panNumber = crm.pan_number || '';\nconst assessmentYear = crm.assessment_year || '';\nconst financialYear = crm.financial_year || '';\nconst deduction80c = crm.deduction_80c != null ? String(crm.deduction_80c) : '0';\nconst deduction80d = crm.deduction_80d != null ? String(crm.deduction_80d) : '0';\nconst deduction80ttaTtb = crm.deduction_80tta_ttb != null ? String(crm.deduction_80tta_ttb) : '0';\nconst hraAmount = crm.hra_amount != null ? String(crm.hra_amount) : '0';\nconst homeLoanInterest24b = crm.home_loan_interest_24b != null ? String(crm.home_loan_interest_24b) : '0';\nconst deduction80ccd1b = crm.deduction_80ccd_1b != null ? String(crm.deduction_80ccd_1b) : '0';\nconst folderId = folder.id;\n\nconst binaryKeys = Object.keys(triggerItem.binary || {}).filter(k => k.startsWith('attachment_'));\n\nconst output = [];\nfor (const key of binaryKeys) {\n  const bin = triggerItem.binary[key];\n  const originalName = bin.fileName || (key + '.pdf');\n  output.push({\n    json: {\n      client_name: clientName,\n      client_email: clientEmail,\n      itr_type: itrType,\n      client_dob: clientDob,\n      pan_number: panNumber,\n      assessment_year: assessmentYear,\n      financial_year: financialYear,\n      deduction_80c: deduction80c,\n      deduction_80d: deduction80d,\n      deduction_80tta_ttb: deduction80ttaTtb,\n      hra_amount: hraAmount,\n      home_loan_interest_24b: homeLoanInterest24b,\n      deduction_80ccd_1b: deduction80ccd1b,\n      folder_id: folderId,\n      drive_filename: clientEmail + '__' + itrType + '__' + originalName\n    },\n    binary: { data: bin }\n  });\n}\n\nif (output.length === 0) {\n  return [{ json: { skipped: true, reason: 'No attachments found on this message' } }];\n}\n\nreturn output;"
      },
