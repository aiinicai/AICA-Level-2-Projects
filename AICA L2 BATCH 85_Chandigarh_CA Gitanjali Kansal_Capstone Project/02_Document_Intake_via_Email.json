    {
      "parameters": {
        "jsCode": "const matches = $input.all().map(i => i.json);\nif (matches.length === 0) {\n  return [{ json: { no_match: true } }];\n}\nmatches.sort((a, b) => {\n  const aTime = new Date(a.classified_at || 0).getTime();\n  const bTime = new Date(b.classified_at || 0).getTime();\n  return bTime - aTime;\n});\nreturn [{ json: matches[0] }];"
      },
