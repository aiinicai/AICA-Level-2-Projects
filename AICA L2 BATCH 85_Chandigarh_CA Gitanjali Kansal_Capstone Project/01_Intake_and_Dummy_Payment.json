    {
      "parameters": {
        "jsCode": "const item = $input.all()[0].json;\nconst intake = $('Log Intake to CRM Sheet').first().json;\n\nfunction isYes(v) { return (v || '').toString().toLowerCase() === 'yes'; }\nfunction amt(v) {\n  const n = parseFloat(v);\n  return isNaN(n) ? 0 : n;\n}\n\nconst hasSalary = isYes(intake.has_salary);\nconst houseCount = intake.house_property_count || '0';\nconst hasCapGains = isYes(intake.has_capital_gains);\nconst hasBusiness = isYes(intake.has_business_income);\nconst presumptive = isYes(intake.presumptive_scheme);\nconst foreignAssets = isYes(intake.foreign_assets);\n\nconst deduction80c = amt(intake.deduction_80c);\nconst deduction80d = amt(intake.deduction_80d);\nconst deduction80ttaTtb = amt(intake.deduction_80tta_ttb);\nconst hraAmount = amt(intake.hra_amount);\nconst homeLoanInterest = amt(intake.home_loan_interest_24b);\nconst deduction80ccd1b = amt(intake.deduction_80ccd_1b);\n\nconst docs = [];\n\nif (hasSalary) {\n  docs.push('Form 16 from your employer(s)');\n}\n\nif (houseCount !== '0') {\n  docs.push('Rent agreement / rent receipts if the property is let out, and municipal tax receipts');\n}\n\nif (homeLoanInterest > 0) {\n  docs.push('Home loan interest certificate from your bank/lender (for Section 24(b) claim)');\n}\n\nif (hasCapGains) {\n  docs.push('Capital Gains / Tax P&L Statement from your stock broker (e.g. Zerodha, Groww, Upstox, Angel One) covering the full financial year');\n  docs.push('Mutual Fund Capital Gains Statement (from CAMS or KFintech, if you hold mutual funds)');\n  docs.push('Property sale deed AND purchase deed (only if you sold a house property this year)');\n}\n\nif (hasBusiness) {\n  if (presumptive) {\n    docs.push('Turnover / gross receipts summary for the year');\n  } else {\n    docs.push('Profit & Loss statement');\n    docs.push('Balance Sheet');\n    docs.push('GST returns (if applicable)');\n  }\n}\n\nif (foreignAssets) {\n  docs.push('Foreign bank/brokerage statements and details of foreign assets held or income earned abroad (for Schedule FA disclosure)');\n}\n\nif (deduction80c > 0) {\n  docs.push('Proof of Section 80C investments (PF statement, ELSS/mutual fund statement, LIC premium receipts, PPF passbook, etc.)');\n}\nif (deduction80d > 0) {\n  docs.push('Health insurance premium payment receipt (Section 80D)');\n}\nif (deduction80ttaTtb > 0) {\n  docs.push('Bank savings account / FD interest certificate (for Section 80TTA/80TTB claim)');\n}\nif (hraAmount > 0) {\n  docs.push('Rent receipts and rental agreement (for HRA exemption claim)');\n}\nif (deduction80ccd1b > 0) {\n  docs.push('NPS contribution statement (for Section 80CCD(1B) claim)');\n}\n\nif (docs.length === 0) {\n  docs.push('Please contact us directly for the document list');\n}\n\nconst docList = docs.map(d => '- ' + d).join('<br>');\n\nreturn [{\n  json: {\n    ...item,\n    name: intake.name,\n    email: intake.email,\n    itr_type: intake.itr_type,\n    price_inr: intake.price_inr,\n    doc_checklist_html: docList\n  }\n}];"
      },
