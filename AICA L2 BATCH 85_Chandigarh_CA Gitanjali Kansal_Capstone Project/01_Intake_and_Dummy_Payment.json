{
  "name": "Digital ITR Consultancy — Intake & Dummy Payment",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Digital ITR Consultancy — Get Started",
        "formDescription": "Answer a few quick questions so we can determine your ITR type and price.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Full Name",
              "fieldName": "name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "fieldName": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Phone Number",
              "fieldName": "phone",
              "requiredField": true
            },
            {
              "fieldLabel": "Date of Birth (DDMMYYYY, e.g. 05041990)",
              "fieldName": "date_of_birth",
              "requiredField": true
            },
            {
              "fieldLabel": "PAN Number",
              "fieldName": "pan_number",
              "placeholder": "10 characters, e.g. ABCDE1234F (all capitals)",
              "requiredField": true
            },
            {
              "fieldLabel": "Assessment Year (the year you are filing FOR — usually one year after your income year)",
              "fieldType": "dropdown",
              "fieldName": "assessment_year",
              "fieldOptions": {
                "values": [
                  {
                    "option": "AY 2025-26"
                  },
                  {
                    "option": "AY 2026-27"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Financial Year (the year you EARNED this income)",
              "fieldType": "dropdown",
              "fieldName": "financial_year",
              "fieldOptions": {
                "values": [
                  {
                    "option": "FY 2024-25"
                  },
                  {
                    "option": "FY 2025-26"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Are you filing as an Individual, Firm/LLP, Company, or Trust?",
              "fieldType": "dropdown",
              "fieldName": "entity_type",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Individual"
                  },
                  {
                    "option": "Firm/LLP"
                  },
                  {
                    "option": "Company"
                  },
                  {
                    "option": "Trust"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Do you have salary income?",
              "fieldType": "dropdown",
              "fieldName": "has_salary",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Yes"
                  },
                  {
                    "option": "No"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "How many house properties do you own? (Count only properties you own — self-occupied, rented out, or vacant. Do not count a place you rent to live in.)",
              "fieldType": "dropdown",
              "fieldName": "house_property_count",
              "fieldOptions": {
                "values": [
                  {
                    "option": "0"
                  },
                  {
                    "option": "1"
                  },
                  {
                    "option": "2 or more"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Did you sell shares, mutual funds, or property this year (capital gains)?",
              "fieldType": "dropdown",
              "fieldName": "has_capital_gains",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Yes"
                  },
                  {
                    "option": "No"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Do you have business or professional income? (Includes freelancing, consulting, tutoring, trading as a business, or running a shop/practice. Salary + rental income alone = No.)",
              "fieldType": "dropdown",
              "fieldName": "has_business_income",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Yes"
                  },
                  {
                    "option": "No"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "If yes to business income, are you under the presumptive scheme (44AD/44ADA/44AE)? (This means declaring a flat % of turnover as profit instead of maintaining detailed books. If unsure, select No — we'll assess it.)",
              "fieldType": "dropdown",
              "fieldName": "presumptive_scheme",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Yes"
                  },
                  {
                    "option": "No"
                  },
                  {
                    "option": "Not applicable"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Do you hold foreign assets/income or are you a director/partner in a company? (Includes foreign bank accounts, foreign stocks/RSUs/ESOPs, overseas property, or being a director/partner in any company, Indian or foreign.)",
              "fieldType": "dropdown",
              "fieldName": "foreign_assets",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Yes"
                  },
                  {
                    "option": "No"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Total 80C investments (PF, ELSS, life insurance, PPF, etc.)",
              "fieldType": "number",
              "fieldName": "deduction_80c",
              "placeholder": "Max eligible ₹1,50,000 — enter actual amount, enter 0 if none",
              "requiredField": true
            },
            {
              "fieldLabel": "Health insurance premium paid (Section 80D)",
              "fieldType": "number",
              "fieldName": "deduction_80d",
              "placeholder": "₹25,000 self/family, ₹50,000 if senior citizen — enter 0 if none",
              "requiredField": true
            },
            {
              "fieldLabel": "Savings/FD interest income claimed (Section 80TTA/80TTB)",
              "fieldType": "number",
              "fieldName": "deduction_80tta_ttb",
              "placeholder": "80TTA max ₹10,000 (under 60), 80TTB max ₹50,000 (60+) — enter 0 if none",
              "requiredField": true
            },
            {
              "fieldLabel": "Annual HRA received (if you pay rent and want HRA exemption)",
              "fieldType": "number",
              "fieldName": "hra_amount",
              "placeholder": "Only if you have salary income and pay rent — enter 0 if not applicable",
              "requiredField": true
            },
            {
              "fieldLabel": "Home loan interest paid this year (Section 24(b))",
              "fieldType": "number",
              "fieldName": "home_loan_interest_24b",
              "placeholder": "For self-occupied or let-out property with active home loan — enter 0 if none",
              "requiredField": true
            },
            {
              "fieldLabel": "Additional NPS contribution (Section 80CCD(1B), over and above 80C)",
              "fieldType": "number",
              "fieldName": "deduction_80ccd_1b",
              "placeholder": "Max ₹50,000, separate from 80C limit — enter 0 if none",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false
        }
      },
      "id": "9c217851-16a1-4ad4-92ee-a67cee846084",
      "name": "ITR Intake Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        -896,
        96
      ],
      "webhookId": "08292df1-deb1-4ace-8052-3b5f5faa5fa9"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.all()[0].json;\n\n// FIX: normalize email to lowercase at the point of intake. Without this,\n// whatever casing the client (or their form-autofill) typed -- e.g.\n// 'GEETGOEL05@GMAIL.COM' -- gets written into the CRM as-is, but the\n// Document Intake workflow always lowercases the sender address it reads\n// from the reply email before looking it up. A case mismatch between the\n// two makes 'Lookup Client in CRM' return zero rows -- silently, with no\n// error -- so the client's reply and attachments never reach the report\n// generation step at all. Normalizing here keeps every downstream lookup\n// consistent.\nconst normalizedEmail = (item.email || '').trim().toLowerCase();\n\nlet itrType = 'MANUAL-REVIEW';\nlet price = 0;\n\nconst entity = (item.entity_type || '').toLowerCase();\nconst salary = (item.has_salary || '').toLowerCase() === 'yes';\nconst houseCount = item.house_property_count || '0';\nconst capGains = (item.has_capital_gains || '').toLowerCase() === 'yes';\nconst business = (item.has_business_income || '').toLowerCase() === 'yes';\nconst presumptive = (item.presumptive_scheme || '').toLowerCase() === 'yes';\nconst foreign = (item.foreign_assets || '').toLowerCase() === 'yes';\n\nif (entity !== 'individual') {\n  itrType = 'MANUAL-REVIEW';\n} else if (business && !presumptive) {\n  itrType = 'ITR-3';\n  price = 1199;\n} else if (business && presumptive) {\n  itrType = 'ITR-4';\n  price = 1199;\n} else if (capGains || houseCount === '2 or more' || foreign) {\n  itrType = 'ITR-2';\n  price = 749;\n} else if (salary && houseCount !== '2 or more') {\n  itrType = 'ITR-1';\n  price = 399;\n} else {\n  itrType = 'MANUAL-REVIEW';\n  price = 0;\n}\n\nconst submissionId = (normalizedEmail || 'unknown') + '__' + Date.now();\n\nreturn [{\n  json: {\n    ...item,\n    email: normalizedEmail,\n    submission_id: submissionId,\n    itr_type: itrType,\n    price_inr: price,\n    classified_at: new Date().toISOString()\n  }\n}];\n"
      },
      "id": "7391fd77-464e-4576-a8ab-fc0b2ba390aa",
      "name": "Classify ITR Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -672,
        96
      ]
