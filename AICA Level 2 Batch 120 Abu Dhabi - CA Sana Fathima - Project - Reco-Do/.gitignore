# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/

# ── Build output (regenerated by `npm run build` / `npm run dist`) ──
out/
dist/
release/
coverage/
*.tsbuildinfo
.vite/
.cache/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Secrets: never commit ────────────────────────────────────
.env
.env.*
!.env.example
.npmrc
# Code-signing certificates and private keys.
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
*.jks
*.keystore
# Encrypted AI keys the app writes to its user-data folder (in case a copy lands here).
ai-keys/
claude-api-key.bin
custom-endpoint.json

# ── Editor / tooling local state ─────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.claude/settings.local.json

# ── OS clutter ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
~$*
