# Copy to .env and edit. Never commit .env.

# --- Application ---------------------------------------------------------
AUDITCRAFT_ENV=development
AUDITCRAFT_HOST=127.0.0.1
AUDITCRAFT_PORT=8000
AUDITCRAFT_SECRET_KEY=change-me-before-first-run

# --- Database ------------------------------------------------------------
# SQLite for a single firm. Swap for PostgreSQL without changing the models:
#   AUDITCRAFT_DATABASE_URL=postgresql+psycopg://auditcraft:pw@localhost:5432/auditcraft
AUDITCRAFT_DATABASE_URL=sqlite:///data/auditcraft.db

# --- Content -------------------------------------------------------------
# Clause repository root. Version-controlled YAML; see docs/CONTENT_AUTHORING.md
AUDITCRAFT_CONTENT_DIR=content

# --- Storage -------------------------------------------------------------
AUDITCRAFT_DATA_DIR=data
AUDITCRAFT_DOCUMENT_DIR=data/documents

# --- Optional PDF --------------------------------------------------------
# Absolute path to LibreOffice. Leave blank to disable PDF export; the
# application degrades gracefully and offers DOCX only.
AUDITCRAFT_SOFFICE_PATH=
