{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taxflow",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "taxflow"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    {
      "pattern": "taxflow.lucid-exp.com",
      "zone_name": "lucid-exp.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://gqtdpuxgyncyffljbypq.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdxdGRwdXhneW5jeWZmbGpieXBxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM5NTEzNzYsImV4cCI6MjA5OTUyNzM3Nn0.a_TycrDqTZiI77QDkKq_tOU-kDOBqJrY95cNPEkpz7k",
    "NEXT_PUBLIC_LUCIDSHARE_SUPABASE_URL": "https://osupitxzfdcetyvcunqi.supabase.co",
    "NEXT_PUBLIC_LUCIDSHARE_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9zdXBpdHh6ZmRjZXR5dmN1bnFpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM0OTgxNzMsImV4cCI6MjA4OTA3NDE3M30.BImUTZxauMPAbK2UXGKcrGLM9E3RaPSxY6teXBHsjxI"
  },
  "observability": {
