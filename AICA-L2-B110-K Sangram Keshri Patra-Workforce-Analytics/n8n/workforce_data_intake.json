  {
   "parameters": {
    "mode": "runOnceForEachItem",
    "jsCode": "const COUNTRIES = ['India', 'UK', 'US', 'France', 'China'];\nconst MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\nconst subject = String($json.subject || ($json.headers && $json.headers.subject) || '').trim();\nconst sender = ($json.from && $json.from.value && $json.from.value[0] && $json.from.value[0].address) || '';\nconst issues = [];\nlet country = '';\nlet period = '';\nconst m = subject.match(/WF-DATA\\s*\\|\\s*([A-Za-z]+)\\s*\\|\\s*([A-Za-z]{3})-(\\d{4})/i);\nif (!m) {\n  issues.push('Subject must follow the format: WF-DATA | <Country> | <Mon-YYYY>  (e.g. WF-DATA | India | Nov-2026)');\n} else {\n  country = COUNTRIES.find(c => c.toLowerCase() === m[1].toLowerCase()) || '';\n  if (!country) issues.push('Country \"' + m[1] + '\" is not recognised. Use one of: ' + COUNTRIES.join(', '));\n  const mon = m[2].charAt(0).toUpperCase() + m[2].slice(1).toLowerCase();\n  if (!MONTHS.includes(mon)) issues.push('Month \"' + m[2] + '\" is not valid. Use Jan, Feb, ... Dec');\n  else period = mon + '-' + m[3];\n}\nconst bin = $input.item.binary || {};\nconst xl = Object.keys(bin).filter(k => String(bin[k].fileName || '').toLowerCase().endsWith('.xlsx'));\nif (xl.length === 0) issues.push('No Excel (.xlsx) attachment found. Please attach the workforce template.');\nif (xl.length > 1) issues.push('More than one Excel file attached. Send one file per country per month.');\nif (xl.length === 1 && country && !String(bin[xl[0]].fileName).toLowerCase().includes(country.toLowerCase()))\n  issues.push('Attachment name \"' + bin[xl[0]].fileName + '\" does not mention ' + country + '. Check you attached the right file.');\nconst valid = issues.length === 0;\nconst out = { json: {\n  messageId: $json.id, threadId: $json.threadId, sender, subject, country, period,\n  originalFileName: xl.length ? bin[xl[0]].fileName : '',\n  fileName: valid ? 'Workforce_' + country + '_' + period + '.xlsx' : '',\n  valid, issues: issues.join(' | '),\n  receivedAt: $json.date || new Date().toISOString()\n} };\nif (xl.length) out.binary = { data: bin[xl[0]] };\nreturn out;"
   },
