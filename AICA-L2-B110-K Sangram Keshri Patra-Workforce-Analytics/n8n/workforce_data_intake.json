  {
   "parameters": {
    "jsCode": "const COUNTRIES = ['India', 'UK', 'US', 'France', 'China'];\nconst period = $now.toFormat('MMM-yyyy');\nconst rows = $input.all().map(i => i.json).filter(r => r.period === period);\nconst lines = COUNTRIES.map(c => {\n  const acc = rows.filter(r => r.country === c && r.status === 'Accepted');\n  const rej = rows.filter(r => r.country === c && r.status === 'Rejected');\n  const status = acc.length ? 'Received' : (rej.length ? 'Rejected – awaiting resubmission' : 'Pending');\n  const last = acc.length ? acc[acc.length - 1] : null;\n  return { country: c, status, when: last ? String(last.receivedAt).slice(0, 10) : '-', file: last ? last.fileName : '-' };\n});\nconst received = lines.filter(l => l.status === 'Received').length;\nconst colour = s => s === 'Received' ? '#1a7f37' : (s === 'Pending' ? '#9a6700' : '#cf222e');\nconst table = '<table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse;font-family:Arial;font-size:13px\">' +\n  '<tr style=\"background:#1F3864;color:#fff\"><th>Country</th><th>Status</th><th>Received on</th><th>File</th></tr>' +\n  lines.map(l => '<tr><td>' + l.country + '</td><td style=\"color:' + colour(l.status) + '\"><b>' + l.status + '</b></td><td>' + l.when + '</td><td>' + l.file + '</td></tr>').join('') + '</table>';\nconst next = received === COUNTRIES.length ? 'All five countries are in. Run the consolidation script.' : 'Follow up with: ' + lines.filter(l => l.status !== 'Received').map(l => l.country).join(', ') + '.';\nreturn [{ json: { period, received, total: COUNTRIES.length, html: table, next } }];"
   },
