    {
      "id": "385fd750-f85b-413e-9dd2-828fbe030c7d",
      "name": "Build Findings Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const clean = function (n) { try { return $(n).all().map(function (i) { return i.json; }).filter(function (r) { return r && (r.finding_id || r.run_id); }); } catch (e) { return []; } };\nconst findings = clean('Read Findings').filter(function (f) { return f.finding_id; });\nconst runs = clean('Read Audit Runs').filter(function (r) { return r.run_id; });\nconst q = ($('GET Findings').first().json.query) || {};\nconst latest = runs.length ? runs[runs.length - 1].run_id : (findings.length ? findings[findings.length - 1].run_id : '');\nconst runId = q.run_id || latest;\nconst sel = q.all === 'true' ? findings : findings.filter(function (f) { return f.run_id === runId; });\nconst by = function (k) { const o = {}; sel.forEach(function (f) { o[f[k]] = (o[f[k]] || 0) + 1; }); return o; };\nreturn [{ json: { ok: true, run_id: runId, runs: runs.slice().reverse(), findings: sel, summary: { total: sel.length, by_risk: by('risk'), by_regulator: by('regulator'), by_status: by('status') } } }];"
      }
    },
