        "jsCode": "const g = function (n) { try { return $(n).all().map(function (i) { const o = Object.assign({}, i.json); delete o.row_number; return o; }).filter(function (r) { return Object.keys(r).length > 0; }); } catch (e) { return []; } };\nreturn [{ json: { ok: true, parameters: g('Data - Parameters'), deals: g('Data - Deals'), investments: g('Data - Investments'), counterparties: g('Data - Counterparties'), dealers: g('Data - Dealers'), positions: g('Data - Positions'), restricted_list: g('Data - Restricted List') } }];"
