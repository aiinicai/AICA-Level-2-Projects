{
  "type": "OBJECT",
  "properties": {
    "document_type": {
      "type": "STRING",
      "enum": [
        "tax_invoice",
        "bill_of_supply",
        "credit_note",
        "debit_note",
        "utility_bill",
        "receipt",
        "proforma",
        "other"
      ]
    },
    "supplier_name": {
      "type": "STRING"
    },
    "supplier_gstin": {
      "type": "STRING"
    },
    "buyer_name": {
      "type": "STRING"
    },
    "buyer_gstin": {
      "type": "STRING"
    },
    "invoice_no": {
      "type": "STRING",
      "description": "invoice / credit note / debit note number"
    },
    "invoice_date": {
      "type": "STRING",
      "description": "DD-MM-YYYY"
    },
    "original_invoice_no": {
      "type": "STRING",
      "description": "credit/debit note only: the invoice number it is issued against"
    },
    "place_of_supply_state_code": {
      "type": "STRING",
      "description": "2-digit GST state code"
    },
    "reverse_charge": {
      "type": "BOOLEAN"
    },
    "tax_summary": {
      "type": "ARRAY",
      "description": "one row per GST rate",
      "items": {
        "type": "OBJECT",
        "properties": {
          "gst_rate": {
            "type": "NUMBER"
          },
          "taxable": {
            "type": "NUMBER"
          },
          "igst": {
            "type": "NUMBER"
          },
          "cgst": {
            "type": "NUMBER"
          },
          "sgst": {
            "type": "NUMBER"
          },
          "cess": {
            "type": "NUMBER"
          }
        },
        "required": [
          "gst_rate",
          "taxable"
        ]
      }
    },
    "taxable_total": {
      "type": "NUMBER"
    },
    "igst_total": {
      "type": "NUMBER"
    },
    "cgst_total": {
      "type": "NUMBER"
    },
    "sgst_total": {
      "type": "NUMBER"
    },
    "cess_total": {
      "type": "NUMBER"
    },
    "tcs": {
      "type": "NUMBER"
    },
    "round_off": {
      "type": "NUMBER",
      "description": "negative if deducted"
    },
    "grand_total": {
      "type": "NUMBER",
      "description": "final amount payable on this invoice"
    },
    "lines": {
      "type": "ARRAY",
      "items": {
        "type": "OBJECT",
        "properties": {
          "description": {
            "type": "STRING"
          },
          "hsn": {
            "type": "STRING"
          },
          "qty": {
            "type": "NUMBER"
          },
          "uom": {
            "type": "STRING"
          },
          "rate": {
            "type": "NUMBER"
          },
          "taxable": {
            "type": "NUMBER"
          },
          "gst_rate": {
            "type": "NUMBER"
          }
        }
      }
    },
    "notes": {
      "type": "STRING",
      "description": "anything unclear or illegible"
    }
  },
  "required": [
    "document_type",
    "supplier_gstin",
    "invoice_no",
    "invoice_date",
    "taxable_total",
    "grand_total"
  ]
}