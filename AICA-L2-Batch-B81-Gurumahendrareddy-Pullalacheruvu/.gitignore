__pycache__/
*.py[cod]
node_modules/
.DS_Store
.env
*.log

# The database and the per-installation signing key never go into source
# control. data/ holds both.
backend/data/

# Build output is ignored by default...
dist/
# ...except the frontend bundle, which MUST be committed. The application
# serves it directly and the README promises the project runs with no Node and
# no npm install. Ignore it and anyone who clones this gets a backend with no
# interface, and instructions that do not work.
!frontend/dist/
!frontend/dist/**
