# ─────────────────────────────────────────────────────────────────────
#  CREDENTIALS — never commit. If any of these reaches a remote, the
#  key must be revoked; deleting the file does not remove it from
#  the commit history.
# ─────────────────────────────────────────────────────────────────────
key.json
*service-account*.json
*credentials*.json
client_secret*.json
.env
.env.*

# Launcher scripts hold the Gmail application password in plain text
*.bat
*.cmd
*.ps1

# ─────────────────────────────────────────────────────────────────────
#  BUILD ARTEFACTS
# ─────────────────────────────────────────────────────────────────────
build/
dist/
*.spec
*.exe
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ─────────────────────────────────────────────────────────────────────
#  RUNTIME OUTPUT — contains live vendor and guarantee data
# ─────────────────────────────────────────────────────────────────────
*.log
bg_run.log
bg_monitor_run.log
BG_Dashboard.html

# ─────────────────────────────────────────────────────────────────────
#  EDITOR AND OS
# ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*
