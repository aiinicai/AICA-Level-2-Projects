OPENAI_API_KEY=your_api_key_here
# Select a model available to your account that supports structured outputs.
OPENAI_MODEL=gpt-4.1-mini
# Optional override: must support Responses web_search and structured output.
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
# Optional: a trusted OpenAI-compatible endpoint supporting chat.completions.parse.
# OPENAI_BASE_URL=https://your-provider.example/v1
# Optional: full path if Tesseract is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGE=eng
