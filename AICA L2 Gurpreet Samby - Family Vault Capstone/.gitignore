# ---------------------------------------------------------------------------
# SECURITY GUARD - keep secrets out of a public repository.
# These patterns come first so they are never shadowed by a later rule.
# See docs/decisions-and-risks.md, risk R-006.
# ---------------------------------------------------------------------------
*.fvault
*.vault
*.kdbx
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
key.properties
secrets.dart
secrets.json
*.env
.env
.env.*
recovery-sheet*
# Real exported data must never be committed, in any form.
*passwords*.csv
*vault-export*

# ---------------------------------------------------------------------------
# Dart and Flutter
# ---------------------------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
build/
# pubspec.lock is deliberately NOT ignored: this is an application, so the
# lockfile is committed for reproducible builds. It is added once CI has
# resolved dependencies for the first time.
.flutter-plugins
.flutter-plugins-dependencies
.metadata
coverage/
doc/api/

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
android/captures/
*.apk.idsig

# ---------------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------------
windows/flutter/ephemeral/
x64/
Debug/
Release/

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*~
*.swp
