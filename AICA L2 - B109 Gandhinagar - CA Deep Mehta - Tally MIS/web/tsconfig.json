{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "isolatedModules": true, "types": ["vite/client"], "baseUrl": ".", "paths": { "@shared/*": ["src/shared/*"] }
  },
  "include": ["src"]
}
