{ border: 0.75pt solid #C9A45A; background: #FCF6E9; padding: 7pt 9pt; margin: 0 0 10pt 0; font-size: 8.5pt; color: #4A3C18; }.quote { border-left: 3pt solid #14304F; padding-left: 8pt; margin: 0 0 6pt 0; font-size: 9pt; }.missing { border: 0.75pt dashed #C9A45A; background: #FCF6E9; padding: 5pt 7pt; font-size: 8pt; color: #5A4718; }.pagebreak { page-break-before: always; mso-special-character: line-break; }.disclaimer { font-size: 8pt; color: #5A6672; border-top: 0.75pt solid #B9C2CA; padding-top: 7pt; }</style></head><body><div class="WordSection1">
