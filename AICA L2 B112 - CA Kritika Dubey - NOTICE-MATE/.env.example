# Copy to .env (never commit .env). All values are read from the environment.

# Local workspace (database, documents, exports, logs). Keep on an encrypted disk.
NOTICEMATE_DATA_DIR=./workspace

# Optional at-rest encryption for stored documents. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes encrypted documents unrecoverable.
NOTICEMATE_ENCRYPTION_KEY=

NOTICEMATE_MAX_UPLOAD_MB=25
NOTICEMATE_SESSION_HOURS=8
NOTICEMATE_MAX_FAILED_LOGINS=5

# ---- Local AI on this computer (LM Studio / Ollama). Switched on in Settings → AI drafting, not here. ----
NOTICEMATE_LOCAL_AI_URL=http://127.0.0.1:1234/v1
NOTICEMATE_LOCAL_AI_MODEL=
NOTICEMATE_LOCAL_AI_TIMEOUT_S=600

# ---- Cloud AI provider (OFF by default) ----
# IMPORTANT: A Claude Pro / Max / Team subscription does NOT include API usage.
# The API needs a separate account and key from https://console.anthropic.com and is billed per token.
NOTICEMATE_AI_ENABLED=false
NOTICEMATE_AI_PROVIDER=anthropic          # anthropic | gemini | offline-echo (test only, no network)
ANTHROPIC_API_KEY=
NOTICEMATE_ANTHROPIC_MODEL=claude-sonnet-5-5
NOTICEMATE_AI_MAX_TOKENS=4000
NOTICEMATE_AI_TIMEOUT_S=120
NOTICEMATE_AI_MAX_PAYLOAD_CHARS=60000
# Optional live web research (provider-side; extra cost; must be enabled on your provider account). Default off.
NOTICEMATE_ANTHROPIC_WEB_SEARCH=false

# ---- Optional: Google Gemini (separate key; Anthropic keeps working unchanged) ----
# Set NOTICEMATE_AI_PROVIDER=gemini to make it the default, or pick it per request in the UI.
GEMINI_API_KEY=
NOTICEMATE_GEMINI_MODEL=gemini-3.8-flash
NOTICEMATE_GEMINI_GROUNDING=false

# Keep the exact redacted payload after sending (default false = wiped after send; hash kept)
NOTICEMATE_RETAIN_AI_PAYLOADS=false

# ---- Network binding ----
NOTICEMATE_API_HOST=127.0.0.1
NOTICEMATE_API_PORT=8000
NOTICEMATE_UI_ORIGIN=http://localhost:8501
NOTICEMATE_API_URL=http://127.0.0.1:8000/api
NOTICEMATE_LOG_LEVEL=INFO

# Local OCR tools (keep paths local; these values are not secrets)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\Tools\Release-26.09.0-0\poppler-26.09.0\Library\bin
