{
  "name": "finaudit-ind-as-verifier",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs server.ts",
    "offline": "node node_modules/vite/bin/vite.js --port 3000 --open",
    "build": "node node_modules/vite/bin/vite.js build",
    "desktop": "node node_modules/electron/cli.js electron/main.cjs",
    "package": "node node_modules/vite/bin/vite.js build && node node_modules/electron-builder/cli.js --win --dir",
    "dist": "node node_modules/vite/bin/vite.js build && node node_modules/electron-builder/cli.js --win",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "lint": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "build": {
    "appId": "com.finaudit.verifier",
    "productName": "FinAudit AI - Ind AS Compliance Verifier",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FinAudit AI Auditor"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
