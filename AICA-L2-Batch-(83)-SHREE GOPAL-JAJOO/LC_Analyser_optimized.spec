    noarchive=False,
    optimize=2,  # Strip docstrings & asserts
)

# Strip unnecessary heavy C-extension binaries collected by PyInstaller hooks
# (e.g. PIL._avif is 7.5MB raw / 4.2MB compressed and not needed for PDF/Word exports)
excluded_binary_patterns = [
    '_avif',
    '_webp',
    '_imagingcms',
    '_imagingmath',
    '_imagingtk',
    'objectify',
    'diff',
    '_difflib',
    'sax',
    'builder',
]

a.binaries = [
    b for b in a.binaries
    if not any(pat in b[0].lower() for pat in excluded_binary_patterns)
]

# Strip unnecessary datas (e.g. lxml schematron schemas, cyclonedx sboms)
a.datas = [
    d for d in a.datas
    if not any(pat in d[0].lower() for pat in ['isoschematron', 'cyclonedx', 'sbom'])
]

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name='LC_Analyser',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,      # Strip is not available on Windows
    upx=True,         # Compress with UPX if available
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,     # Windowed app (no console)
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
