        'cryptography.hazmat.primitives.ciphers.algorithms',
        'cryptography.hazmat.primitives.ciphers.modes',
        '_cffi_backend',
        # lxml (required by python-docx / docx.oxml)
        'lxml',
        'lxml.etree',
        'lxml._elementpath',
        # PIL / Pillow (required by reportlab)
        'PIL',
        'PIL.Image',
        'PIL.PngImagePlugin',
