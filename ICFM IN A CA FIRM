# --------------------------------------------------------------------------- money & dates
class M(int):
    """Money in paise (integer arithmetic only - no floating-point errors)."""


def paise(s):
    try:
        d = Decimal(str(s or "0").replace(",", "").replace("₹", "").strip() or "0")
    except InvalidOperation:
        raise ValueError("Invalid amount: %r" % s)
    if d < 0:
        raise ValueError("Amount cannot be negative")
    return int((d * 100).quantize(Decimal(1), ROUND_HALF_UP))


def rupees(p):
    return "%.2f" % (Decimal(int(p or 0)) / 100)


def inr(p):
    p = int(p or 0)
    neg, p = p < 0, abs(p)
    r, ps = divmod(p, 100)
    s = str(r)
    if len(s) > 3:
        head = re.sub(r"(\d)(?=(\d\d)+$)", r"\1,", s[:-3])
        s = head + "," + s[-3:]
    return "%s₹%s.%02d" % ("-" if neg else "", s, ps)


def fy_of(d):
    y, m = int(d[:4]), int(d[5:7])
    s = y if m >= 4 else y - 1
    return "%d-%02d" % (s, (s + 1) % 100)


def fy_range(fy):
    s = int(fy[:4])
    return "%d-04-01" % s, "%d-03-31" % (s + 1)


def today():
    return dt.date.today().isoformat()


def check_date(s):
    try:
        return dt.date.fromisoformat(s).isoformat()
    except Exception:
        raise ValueError("Invalid date: %r" % s)


def now():
    return dt.datetime.now().isoformat(timespec="seconds")

