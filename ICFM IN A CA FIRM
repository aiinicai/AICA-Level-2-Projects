@app.route("/admin/matrix", methods=["POST"])
@admin_post
def admin_matrix():
    c, f = db(), request.form
    old = [dict(r) for r in c.execute("SELECT up_to,role FROM approval_matrix ORDER BY id")]
    rows = []
    for i in range(1, 7):
        role, lim = f.get("role%d" % i, ""), f.get("limit%d" % i, "").strip()
        if role:
            rows.append((paise(lim) if lim else None, role))
    if not rows or rows[-1][0] is not None:
        raise ValueError("The last slab must have a blank limit (= above all previous limits)")
    lims = [r[0] for r in rows[:-1]]
    if any(x is None for x in lims) or lims != sorted(lims):
        raise ValueError("Limits must be filled and ascending; only the last slab may be blank")
    c.execute("DELETE FROM approval_matrix")
    for up, role in rows:
        c.execute("INSERT INTO approval_matrix(up_to,role) VALUES(?,?)", (up, role))
    audit(c, uname(), "approval_matrix", "settings", "matrix", old, [dict(up_to=u_, role=r_) for u_, r_ in rows])
    flash("Approval matrix saved.")


