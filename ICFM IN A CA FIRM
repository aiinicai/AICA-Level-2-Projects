def build_export(rep, fmt, name):
    H, R, title = rep["headers"], rep["rows"], rep["title"]
    stamp = "Generated %s by %s" % (now().replace("T", " "), uname())
    fn = "%s_%s" % (name, dt.date.today().isoformat())
    if fmt == "csv":
        o = io.StringIO()
        w = csv.writer(o)
        w.writerow([title]); w.writerow([stamp]); w.writerow(H)
        for r in R:
            w.writerow([rupees(x) if isinstance(x, M) else safe(x) for x in r])
        return Response("\ufeff" + o.getvalue(), mimetype="text/csv", headers={"Content-Disposition": "attachment; filename=%s.csv" % fn})
    if fmt == "xlsx":
        from openpyxl import Workbook
        from openpyxl.styles import Font
        wb = Workbook(); ws = wb.active; ws.title = "Report"
        ws.append([title]); ws["A1"].font = Font(bold=True, size=13); ws.append([stamp]); ws.append([])
        ws.append(H)
        for cell in ws[4]:
            cell.font = Font(bold=True)
        for r in R:
            ws.append([float(Decimal(x) / 100) if isinstance(x, M) else safe(x) for x in r])
            for cell, x in zip(ws[ws.max_row], r):
                if isinstance(x, M):
                    cell.number_format = "#,##0.00"
        for i, h in enumerate(H, 1):
            ws.column_dimensions[chr(64 + i)].width = max(14, min(50, max([len(str(h))] + [len(str(r[i - 1])) for r in R if len(r) >= i]) + 2))
        o = io.BytesIO(); wb.save(o); o.seek(0)
        return send_file(o, as_attachment=True, download_name=fn + ".xlsx", mimetype="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet")
    if fmt == "pdf":
        from reportlab.lib.pagesizes import A4, landscape
        from reportlab.lib import colors
        from reportlab.lib.styles import getSampleStyleSheet
        from reportlab.platypus import SimpleDocTemplate, Table, TableStyle, Paragraph, Spacer
        o = io.BytesIO()
        doc = SimpleDocTemplate(o, pagesize=landscape(A4), leftMargin=24, rightMargin=24, topMargin=24, bottomMargin=24)
        st = getSampleStyleSheet()
        data = [H] + [[("Rs. " + inr(x)[1:]) if isinstance(x, M) else Paragraph(str(x if x is not None else "")[:200].replace("&", "&amp;").replace("<", "&lt;"), st["BodyText"]) for x in r] for r in R]
        t = Table(data, repeatRows=1)
        t.setStyle(TableStyle([("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#1f3a5f")), ("TEXTCOLOR", (0, 0), (-1, 0), colors.white),
                               ("FONTSIZE", (0, 0), (-1, -1), 8), ("GRID", (0, 0), (-1, -1), 0.25, colors.grey), ("VALIGN", (0, 0), (-1, -1), "TOP"),
                               ("ROWBACKGROUNDS", (0, 1), (-1, -1), [colors.white, colors.HexColor("#f2f5f9")])]))
        doc.build([Paragraph(setting(conn(), "firm_name", ""), st["Title"]), Paragraph(title, st["Heading2"]), Paragraph(stamp, st["Normal"]), Spacer(1, 8), t]
                  + ([Spacer(1, 8), Paragraph(rep["note"], st["Italic"])] if rep.get("note") else []))
        o.seek(0)
        return send_file(o, as_attachment=True, download_name=fn + ".pdf", mimetype="application/pdf")
    abort(404)


