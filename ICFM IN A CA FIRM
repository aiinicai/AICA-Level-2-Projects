    c.executescript(SCHEMA)
    with tx(c):
        if c.execute("SELECT COUNT(*) n FROM roles").fetchone()["n"] == 0:
            for n, r in ROLES:
                c.execute("INSERT INTO roles VALUES(?,?)", (n, r))
                for m, a in default_perms(n):
                    c.execute("INSERT INTO perms VALUES(?,?,?)", (n, m, a))
            for k, v in dict(firm_name="CA Firm", sod="1", credit_days="30", min_pw="10", session_minutes="60",
                             max_fails="5", lock_minutes="5").items():
                set_setting(c, k, v)
            for up, role in [(500000, "Accounts Manager"), (2500000, "Department Manager"), (10000000, "Partner"), (None, "Managing Partner")]:
                c.execute("INSERT INTO approval_matrix(up_to,role) VALUES(?,?)", (up, role))
            for code, name, typ in [("1100", "Trade Receivables", "Asset"), ("1150", "TDS Receivable", "Asset"),
                                    ("1200", "GST Input Credit", "Asset"), ("2001", "Trade Payables", "Liability"),
                                    ("2100", "GST Output Payable", "Liability"), ("2200", "TDS Payable", "Liability"),
                                    ("2300", "Advances from Clients", "Liability"), ("3001", "Partners' Capital", "Equity")]:
                c.execute("INSERT INTO accounts(code,name,type) VALUES(?,?,?)", (code, name, typ))
