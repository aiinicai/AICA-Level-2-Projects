@app.route("/setup", methods=["GET", "POST"])
def setup():
    c = db()
    if c.execute("SELECT COUNT(*) n FROM users").fetchone()["n"]:
        return redirect("/login")
    if request.method == "POST":
        f = request.form
        try:
            pw_ok(c, f["password"])
            if f["password"] != f["password2"]:
                raise ValueError("Passwords do not match")
            if not f["username"].strip() or not f["full_name"].strip():
                raise ValueError("Name and username are required")
            set_setting(c, "firm_name", f["firm"].strip() or "CA Firm")
            uid = c.execute("INSERT INTO users(username,full_name,pw,role,created_at) VALUES(?,?,?,?,?)",
                            (f["username"].strip().lower(), f["full_name"].strip(), generate_password_hash(f["password"]),
                             "Super Administrator", now())).lastrowid
            audit(c, f["username"], "setup", "users", uid, None, {"role": "Super Administrator"})
            flash("Setup complete. Please log in.")
            return redirect("/login")
        except ValueError as e:
            flash(str(e), "err")
    return render_template("setup.html", title="First-time setup")


def pw_ok(c, pw):
    n = int(setting(c, "min_pw", "10"))
    if len(pw) < n or not re.search(r"[A-Za-z]", pw) or not re.search(r"\d", pw):
        raise ValueError("Password must be at least %d characters and contain letters and digits" % n)


@app.route("/login", methods=["GET", "POST"])
def login():
    c = db()
    if request.method == "POST":
        u = c.execute("SELECT * FROM users WHERE username=?", (request.form.get("username", "").strip().lower(),)).fetchone()
        if u and u["locked_until"] and u["locked_until"] > now():
            flash("Account temporarily locked. Try again later.", "err")
        elif u and u["active"] and check_password_hash(u["pw"], request.form.get("password", "")):
            c.execute("UPDATE users SET fails=0, locked_until=NULL WHERE id=?", (u["id"],))
            session.clear()
            session["uid"] = u["id"]
            csrf()
            audit(c, u["username"], "login", "users", u["id"])
            return redirect("/")
        else:
            if u:
                fails = u["fails"] + 1
                lock = None
                if fails >= int(setting(c, "max_fails", "5")):
                    lock = (dt.datetime.now() + dt.timedelta(minutes=int(setting(c, "lock_minutes", "5")))).isoformat(timespec="seconds")
                    fails = 0
                c.execute("UPDATE users SET fails=?, locked_until=? WHERE id=?", (fails, lock, u["id"]))
                audit(c, u["username"], "login_failed", "users", u["id"])
            flash("Invalid username or password.", "err")
    return render_template("login.html", title="Sign in")


@app.route("/logout")
def logout():
