def outstanding(c, inv_id):
    inv = c.execute("SELECT net FROM txns WHERE id=? AND type='invoice' AND status='Approved'", (inv_id,)).fetchone()
    if not inv:
        return 0
    got = c.execute("SELECT COALESCE(SUM(amount),0) s FROM txns WHERE type='receipt' AND invoice_id=? AND status='Approved'", (inv_id,)).fetchone()["s"]
    return inv["net"] - got


def required_role(c, gross):
    for r in c.execute("SELECT * FROM approval_matrix ORDER BY CASE WHEN up_to IS NULL THEN 1 ELSE 0 END, up_to"):
        if r["up_to"] is None or gross <= r["up_to"]:
            return r["role"]
    return "Managing Partner"


def can_approve(c, t, u):
    """Returns (bool, reason)."""
    if t["status"] != "Pending Approval":
        return False, "Not pending approval"
    if not can(t["type"], "approve"):
        return False, "No approval permission for this module"
    if setting(c, "sod", "1") == "1" and t["maker_id"] == u["id"]:
        return False, "Segregation of duties: the maker cannot approve their own transaction"
    req = required_role(c, t["amount"] + t["gst"])
    if rank_of(u["role"]) < rank_of(req):
        return False, "Amount requires approval by %s or higher" % req
    return True, ""


def parse_txn(typ, f, existing=None):
    c = db()
    d = dict(date=check_date(f.get("date", "")), amount=paise(f.get("amount")), gst=paise(f.get("gst")), tds=paise(f.get("tds")),
             mode=f.get("mode", ""), ref=f.get("ref", "").strip(), narration=f.get("narration", "").strip())
    if d["amount"] <= 0:
        raise ValueError("Amount must be greater than zero")
    if d["mode"] not in PAY_MODES:
        raise ValueError("Select a payment mode")
    d["fy"] = fy_of(d["date"])
    pid = int(f.get("party_id") or 0)
    if not c.execute("SELECT 1 FROM %s WHERE id=? AND active=1" % TX[typ]["party"], (pid,)).fetchone():
        raise ValueError("Select a valid %s" % ("client" if typ != "expense" else "vendor"))
    d["party_id"] = pid
    d.update(head=None, bank_id=None, invoice_id=None, dept=None, partner=None, due=None)
    if typ == "invoice":
        if f.get("head") not in masters("income"):
            raise ValueError("Select a service category")
        d["head"] = f["head"]
        d["partner"] = f.get("partner", "")
        d["due"] = check_date(f.get("due") or (dt.date.fromisoformat(d["date"]) + dt.timedelta(days=int(setting(c, "credit_days", "30")))).isoformat())
        d["tds"] = 0
        d["net"] = d["amount"] + d["gst"]
        d["bank_id"] = None
    else:
        if d["tds"] > d["amount"]:
            raise ValueError("TDS cannot exceed the amount")
        bid = f.get("bank_id")
        if typ == "receipt" and not bid:
            raise ValueError("Select the bank/cash account where the money was received")
        d["bank_id"] = int(bid) if bid else None
        if d["bank_id"] and not c.execute("SELECT 1 FROM bank_accounts WHERE id=?", (d["bank_id"],)).fetchone():
            raise ValueError("Invalid bank account")
    if typ == "receipt":
        d["gst"] = 0
        d["net"] = d["amount"] - d["tds"]
        iid = int(f.get("invoice_id") or 0)
        if iid:
            inv = c.execute("SELECT * FROM txns WHERE id=? AND type='invoice' AND status='Approved'", (iid,)).fetchone()
            if not inv or inv["party_id"] != pid:
                raise ValueError("Invoice must be an approved invoice of the same client")
            if d["amount"] > outstanding(c, iid):
                raise ValueError("Receipt exceeds the outstanding balance of the invoice (%s)" % inv_fmt(outstanding(c, iid)))
            d["invoice_id"] = iid
    if typ == "expense":
        if f.get("head") not in masters("expense"):
            raise ValueError("Select an expense head")
        d["head"], d["dept"] = f["head"], f.get("dept", "")
        if not d["ref"]:
            raise ValueError("Vendor invoice number is required (supporting document reference)")
        if d["tds"] > d["amount"] + d["gst"]:
            raise ValueError("TDS cannot exceed the invoice value")
        d["net"] = d["amount"] + d["gst"] - d["tds"]
        dup = c.execute("SELECT no FROM txns WHERE type='expense' AND party_id=? AND lower(ref)=lower(?) AND status NOT IN('Rejected','Cancelled') AND id IS NOT ?",
                        (pid, d["ref"], existing["id"] if existing else None)).fetchone()
        if dup:
            raise ValueError("Duplicate: this vendor invoice number is already booked in %s" % dup["no"])
    return d


def inv_fmt(p):
    return inr(p)


def txn_fields(typ, v=None):
    v = v or {}
    c = db()
    banks = sel(c.execute("SELECT id,name FROM bank_accounts ORDER BY is_cash DESC,name").fetchall())
    modes = [(m, m) for m in PAY_MODES]
    fields = [F("date", "Date", "date", v.get("date") or today(), True)]
    if typ == "expense":
        fields += [F("party_id", "Vendor", "select", v.get("party_id"), True, sel(c.execute("SELECT id,name FROM vendors WHERE active=1 ORDER BY name").fetchall())),
                   F("head", "Expense head", "select", v.get("head"), True, [(x, x) for x in masters("expense")]),
                   F("ref", "Vendor invoice no.", "text", v.get("ref"), True), F("dept", "Department", "select", v.get("dept"), False, [("", "--")] + [(x, x) for x in masters("department")])]
    else:
        fields.append(F("party_id", "Client", "select", v.get("party_id"), True, sel(c.execute("SELECT id,name FROM clients WHERE active=1 ORDER BY name").fetchall())))
    if typ == "invoice":
        fields += [F("head", "Service category", "select", v.get("head"), True, [(x, x) for x in masters("income")]),
                   F("partner", "Responsible partner", "select", v.get("partner"), False, [("", "--")] + [(p, p) for p in partners()]),
                   F("due", "Due date", "date", v.get("due"), False, hint="Blank = invoice date + default credit days")]
    if typ == "receipt":
        invs = c.execute("SELECT t.id,t.no,t.net,c.name FROM txns t JOIN clients c ON c.id=t.party_id WHERE t.type='invoice' AND t.status='Approved' ORDER BY t.date DESC").fetchall()
        o = [("", "-- advance / not against an invoice --")] + [(r["id"], "%s | %s | outstanding %s" % (r["no"], r["name"], inr(outstanding(c, r["id"])))) for r in invs if outstanding(c, r["id"]) > 0]
        fields.append(F("invoice_id", "Against invoice", "select", v.get("invoice_id"), False, o))
    lab = {"invoice": "Fee amount (excl. GST)", "receipt": "Gross amount received/settled (incl. GST)", "expense": "Amount (excl. GST)"}[typ]
    fields.append(F("amount", lab, "money", rupees(v["amount"]) if v.get("amount") else "", True))
    if typ != "receipt":
        fields.append(F("gst", "GST amount", "money", rupees(v["gst"]) if v.get("gst") else ""))
    if typ != "invoice":
        fields.append(F("tds", "TDS deducted", "money", rupees(v["tds"]) if v.get("tds") else ""))
        fields.append(F("bank_id", "Received in" if typ == "receipt" else "Paid from", "select", v.get("bank_id"), typ == "receipt",
                        banks if typ == "receipt" else [("", "-- on credit (payable) --")] + banks[1:]))
    fields += [F("mode", "Payment mode", "select", v.get("mode"), True, modes)]
    if typ == "receipt":
        fields.append(F("ref", "Cheque / UTR no.", "text", v.get("ref")))
    fields.append(F("narration", "Narration", "textarea", v.get("narration")))
    return fields


def next_no(c, typ, fy):
    n = c.execute("SELECT COUNT(*) n FROM txns WHERE type=? AND fy=?", (typ, fy)).fetchone()["n"] + 1
    return "%s/%s/%04d" % (TX[typ]["pre"], fy, n)


def txn_list_query(typ, fy, q="", status=""):
    sql = ("SELECT t.*, COALESCE(c.name,v.name) party FROM txns t LEFT JOIN clients c ON t.type IN('invoice','receipt') AND c.id=t.party_id "
           "LEFT JOIN vendors v ON t.type='expense' AND v.id=t.party_id WHERE t.type=? AND t.fy=?")
    args = [typ, fy]
    if not can(typ, "view_all"):
        sql += " AND t.maker_id=?"
        args.append(cur()["id"])
    if status:
        sql += " AND t.status=?"
        args.append(status)
    if q:
        sql += " AND (t.no LIKE ? OR party LIKE ? OR t.ref LIKE ? OR t.head LIKE ?)"
        args += ["%" + q + "%"] * 4
    return db().execute(sql + " ORDER BY t.date DESC, t.id DESC LIMIT 300", args).fetchall()


