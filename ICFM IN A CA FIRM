def chart_svg(months, inc, exp):
    mx = max(inc + exp + [1])
    W, H, pad = 760, 250, 30
    bw = (W - 2 * pad) / 12
    out = ['<svg viewBox="0 0 %d %d" class="chart" role="img" aria-label="Monthly income and expenditure">' % (W, H)]
    for i, m in enumerate(months):
        x = pad + i * bw
        hi, he = (H - 50) * inc[i] / mx, (H - 50) * exp[i] / mx
        out.append('<rect class="bi" x="%.1f" y="%.1f" width="%.1f" height="%.1f"><title>%s income %s</title></rect>' % (x + 4, H - 25 - hi, bw / 2 - 5, hi, m, inr(inc[i])))
        out.append('<rect class="be" x="%.1f" y="%.1f" width="%.1f" height="%.1f"><title>%s expenditure %s</title></rect>' % (x + bw / 2, H - 25 - he, bw / 2 - 5, he, m, inr(exp[i])))
        out.append('<text x="%.1f" y="%d" text-anchor="middle">%s</text>' % (x + bw / 2, H - 8, dt.date.fromisoformat(m + "-01").strftime("%b")))
    out.append('</svg>')
    return Markup("".join(out))


