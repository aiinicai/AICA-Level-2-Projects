# --------------------------------------------------------------------------- self-tests
def run_tests():
    import unittest
    tmp = tempfile.mkdtemp()
    global DATA_DIR, DB_PATH
    DATA_DIR, DB_PATH = tmp, os.path.join(tmp, "icfms.db")
    configure()
    app.config["TESTING"] = True
    PW = "Secret12345"

    class T_(unittest.TestCase):
        @classmethod
        def setUpClass(cls):
            init_db()
            cls.cl = app.test_client()
            cls.post(cls.cl, "/setup", firm="Test Firm", full_name="Admin", username="admin", password=PW, password2=PW)
            cls.login(cls.cl, "admin")
            for uname_, role in [("exec", "Accounts Executive"), ("mgr", "Accounts Manager"), ("ptr", "Partner"), ("emp", "Employee"), ("aud", "Internal Auditor"), ("mp", "Managing Partner")]:
                cls.post(cls.cl, "/admin/user/add", full_name=uname_.title(), username=uname_, role=role, password=PW)
            cls.post(cls.cl, "/clients/new", name="Test Client", constitution="Company", pan="ABCDE1234F")
            cls.post(cls.cl, "/vendors/new", name="Test Vendor", pan="")
            cls.post(cls.cl, "/admin/bank/add", name="Test Bank", opening="100000.00", opening_date="2025-04-01")

        @staticmethod
        def post(cl, url, **data):
            with cl.session_transaction() as s:
                s.setdefault("csrf", "tok")
                data["_csrf"] = s["csrf"]
            return cl.post(url, data=data, follow_redirects=True)

        @staticmethod
        def login(cl, user):
            cl.get("/login")
            return T_.post(cl, "/login", username=user, password=PW)

        def client_as(self, user):
            cl = app.test_client()
            self.login(cl, user)
            return cl

        def q(self, sql, *a):
            c = conn(); r = c.execute(sql, a).fetchall(); c.close(); return r

        def new_txn(self, cl, typ, **kw):
            base = dict(date="2025-06-10", party_id=1, mode="Bank Transfer", action="submit")
            base.update(kw)
            self.post(cl, "/t/%s/new" % typ, **base)
            return self.q("SELECT * FROM txns WHERE type=? ORDER BY id DESC LIMIT 1", typ)[0]

        # ---- unit tests
        def test_01_money(self):
            self.assertEqual(paise("1,23,456.789"), 12345679)
            self.assertEqual(inr(12345678900), "₹12,34,56,789.00")
            self.assertEqual(fy_of("2026-03-31"), "2025-26")
            self.assertEqual(fy_of("2026-04-01"), "2026-27")
            with self.assertRaises(ValueError): paise("abc")
            with self.assertRaises(ValueError): paise("-5")

        def test_02_journal_must_balance_and_immutable(self):
            c = conn()
            with self.assertRaises(ValueError):
                with tx(c): post_journal(c, "2025-06-01", "x", "x", [(1, 100, 0), (2, 0, 99)], "t", 0, 1)
            with self.assertRaises(sqlite3.IntegrityError):
                c.execute("UPDATE jlines SET debit=1 WHERE id=1")
            with self.assertRaises(sqlite3.IntegrityError):
                c.execute("DELETE FROM journals")
            c.close()

        def test_03_auth_and_csrf(self):
            cl = app.test_client()
            self.assertEqual(cl.get("/t/invoice").status_code, 302)
            self.assertEqual(cl.post("/login", data={"username": "admin", "password": PW}).status_code, 400)
            r = self.post(cl, "/login", username="admin", password="wrong")
            self.assertIn(b"Invalid username", r.data)

        def test_04_permissions(self):
            emp = self.client_as("emp")
            self.assertEqual(emp.get("/t/invoice").status_code, 403)
            self.assertEqual(emp.get("/admin").status_code, 403)
            self.assertEqual(emp.get("/r/trial_balance").status_code, 403)
            aud = self.client_as("aud")
            self.assertEqual(aud.get("/t/invoice/new").status_code, 403)
            self.assertEqual(aud.get("/r/trial_balance").status_code, 200)

        def test_05_invoice_maker_checker_and_posting(self):
            ex, mg = self.client_as("exec"), self.client_as("mgr")
            t = self.new_txn(ex, "invoice", head="Tax audit fees", amount="4000", gst="720", partner="")
            self.assertEqual(t["status"], "Pending Approval")
            ex.get("/t/invoice/%d" % t["id"])
            self.post(ex, "/t/invoice/%d/act" % t["id"], act="approve")
            self.assertEqual(self.q("SELECT status FROM txns WHERE id=?", t["id"])[0][0], "Pending Approval")  # no approve permission
            self.post(mg, "/t/invoice/%d/act" % t["id"], act="approve")
            t2 = self.q("SELECT * FROM txns WHERE id=?", t["id"])[0]
            self.assertEqual(t2["status"], "Approved")
            lines = self.q("SELECT SUM(debit) d, SUM(credit) c FROM jlines WHERE journal_id=?", t2["journal_id"])[0]
            self.assertEqual((lines["d"], lines["c"]), (472000, 472000))

        def test_06_sod_and_limits(self):
            mg, pt, mp = self.client_as("mgr"), self.client_as("ptr"), self.client_as("mp")
            t = self.new_txn(mg, "expense", head="Rent", amount="50000", gst="0", ref="R-1", party_id=1, bank_id="")
            self.post(mg, "/t/expense/%d/act" % t["id"], act="approve")  # own txn
            self.assertEqual(self.q("SELECT status FROM txns WHERE id=?", t["id"])[0][0], "Pending Approval")
            ex = self.client_as("exec")
            t2 = self.new_txn(ex, "expense", head="Rent", amount="50000", gst="0", ref="R-2")
            self.post(mg, "/t/expense/%d/act" % t2["id"], act="approve")  # needs Partner (>25,000)
            self.assertEqual(self.q("SELECT status FROM txns WHERE id=?", t2["id"])[0][0], "Pending Approval")
            self.post(pt, "/t/expense/%d/act" % t2["id"], act="approve")
            self.assertEqual(self.q("SELECT status FROM txns WHERE id=?", t2["id"])[0][0], "Approved")
            t3 = self.new_txn(ex, "expense", head="Rent", amount="200000", ref="R-3")
            self.post(pt, "/t/expense/%d/act" % t3["id"], act="approve")  # needs Managing Partner
            self.assertEqual(self.q("SELECT status FROM txns WHERE id=?", t3["id"])[0][0], "Pending Approval")
            self.post(mp, "/t/expense/%d/act" % t3["id"], act="approve")
            self.assertEqual(self.q("SELECT status FROM txns WHERE id=?", t3["id"])[0][0], "Approved")

        def test_07_duplicate_vendor_invoice_blocked(self):
            ex = self.client_as("exec")
            self.new_txn(ex, "expense", head="Stationery", amount="100", ref="DUP-1")
            n1 = len(self.q("SELECT 1 FROM txns WHERE ref='DUP-1'"))
            self.new_txn(ex, "expense", head="Stationery", amount="100", ref="dup-1")
            self.assertEqual(len(self.q("SELECT 1 FROM txns WHERE lower(ref)='dup-1'")), n1)

        def test_08_receipt_rules_and_ageing(self):
            ex, mg = self.client_as("exec"), self.client_as("mgr")
            inv = self.new_txn(ex, "invoice", head="GST consultancy", amount="1000", gst="180")
            self.post(mg, "/t/invoice/%d/act" % inv["id"], act="approve")
            bank = self.q("SELECT id FROM bank_accounts WHERE name='Test Bank'")[0][0]
            self.post(ex, "/t/receipt/new", date="2025-06-10", party_id=1, mode="Bank Transfer", action="submit", amount="2000", tds="0", bank_id=bank, invoice_id=inv["id"])  # exceeds outstanding
            self.assertEqual(len(self.q("SELECT 1 FROM txns WHERE type='receipt' AND invoice_id=?", inv["id"])), 0)
            r = self.new_txn(ex, "receipt", amount="1180", tds="10", bank_id=bank, invoice_id=inv["id"])
            self.post(mg, "/t/receipt/%d/act" % r["id"], act="approve")
            c = conn(); self.assertEqual(outstanding(c, inv["id"]), 0); c.close()

        def test_09_approved_not_editable_and_reversal(self):
            ex, mg = self.client_as("exec"), self.client_as("mgr")
            t = self.new_txn(ex, "invoice", head="Project reports", amount="500", gst="0")
            self.post(mg, "/t/invoice/%d/act" % t["id"], act="approve")
            self.assertEqual(ex.get("/t/invoice/%d/edit" % t["id"]).status_code, 403)
            self.post(mg, "/t/invoice/%d/act" % t["id"], act="cancel", comment="Billed in error")
            row = self.q("SELECT status FROM txns WHERE id=?", t["id"])[0]
            self.assertEqual(row[0], "Cancelled")
            net = self.q("SELECT SUM(l.debit-l.credit) FROM jlines l JOIN journals j ON j.id=l.journal_id WHERE j.source IN('txn','reversal') AND j.source_id=?", t["id"])[0][0]
            self.assertEqual(net, 0)

        def test_10_trial_balance_balances_and_reports_export(self):
            ad = self.client_as("admin")
            c = conn()
            tb = r_trial_balance(c, "2025-26")
            self.assertEqual(tb["rows"][-1][3], tb["rows"][-1][4])
            self.assertIn("Balanced", tb["note"])
            c.close()
            for name in REPORTS:
                self.assertEqual(ad.get("/r/%s" % name).status_code, 200, name)
            for fmt, mt in (("csv", b"Trial"), ("xlsx", b"PK"), ("pdf", b"%PDF")):
                r = ad.get("/r/trial_balance/export/" + fmt)
                self.assertEqual(r.status_code, 200)
                self.assertIn(mt, r.data[:200] if fmt != "csv" else r.data)

        def test_11_audit_chain_detects_tampering(self):
            c = conn()
            self.assertTrue(verify_audit(c)[0])
            c.execute("DROP TRIGGER a_upd")
            c.execute("UPDATE audit SET new='tampered' WHERE id=(SELECT MAX(id) FROM audit)")
            self.assertFalse(verify_audit(c)[0])
            c.close()

        def test_12_login_lockout(self):
            cl = app.test_client()
            for _ in range(5):
                cl.get("/login"); self.post(cl, "/login", username="emp", password="bad")
            r = self.post(cl, "/login", username="emp", password=PW)
            self.assertIn(b"locked", r.data)

    suite = unittest.defaultTestLoader.loadTestsFromTestCase(T_)
    res = unittest.TextTestRunner(verbosity=2).run(suite)
    shutil.rmtree(tmp, ignore_errors=True)
    return res.wasSuccessful()


# --------------------------------------------------------------------------- main
def main():
    if "--test" in sys.argv:
        sys.exit(0 if run_tests() else 1)
    os.makedirs(DATA_DIR, exist_ok=True)
    init_db()
    daily_backup()
    url = "http://%s:%d" % (HOST, PORT)
    print("=" * 60, "\n  CA Firm ICFMS is running at", url, "\n  Keep this window open while using the application.\n  Press Ctrl+C to stop.\n", "=" * 60)
    threading.Timer(1.2, lambda: webbrowser.open(url)).start()
    app.run(host=HOST, port=PORT, debug=False, threaded=True)


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except BaseException as e:
        import traceback
        traceback.print_exc()
        if not isinstance(e, KeyboardInterrupt):
            input("\nThe application stopped because of an error. Press Enter to close...")
