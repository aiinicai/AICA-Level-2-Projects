def pl_total(c, typ, fy, month=None):
    q = "SELECT COALESCE(SUM(l.credit-l.debit),0) v FROM jlines l JOIN journals j ON j.id=l.journal_id JOIN accounts a ON a.id=l.account_id WHERE a.type=? AND j.fy=?"
    a = [typ, fy]
    if month:
        q += " AND substr(j.date,1,7)=?"
        a.append(month)
    v = c.execute(q, a).fetchone()["v"]
    return v if typ == "Income" else -v


