    u = cur()
    d = dict(user=u, csrf=csrf, can=can, inr=inr, M=M, firm=setting(db(), "firm_name", "CA Firm"), fy=current_fy())
    if u:
        fys = {r["fy"] for r in db().execute("SELECT DISTINCT fy FROM journals")} | {fy_of(today()), current_fy()}
