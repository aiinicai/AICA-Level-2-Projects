app = Flask(__name__)


def get_secret():
    os.makedirs(DATA_DIR, exist_ok=True)
    p = os.path.join(DATA_DIR, "secret.key")
    if not os.path.exists(p):
        with open(p, "w") as f:
            f.write(secrets.token_hex(32))
        try:
            os.chmod(p, 0o600)
        except Exception:
            pass
    return open(p).read().strip()


def configure():
    app.secret_key = get_secret()
    app.config.update(SESSION_COOKIE_HTTPONLY=True, SESSION_COOKIE_SAMESITE="Lax", MAX_CONTENT_LENGTH=5 * 1024 * 1024)


def db():
    if "db" not in g:
        g.db = conn()
    return g.db


def cur():
    if "user" not in g:
        g.user = None
        uid = session.get("uid")
        if uid:
            r = db().execute("SELECT * FROM users WHERE id=? AND active=1", (uid,)).fetchone()
            g.user = r
    return g.user


def rank_of(role):
    r = db().execute("SELECT rank FROM roles WHERE name=?", (role,)).fetchone()
    return r["rank"] if r else 0


def can(mod, act):
    u = cur()
    if not u:
        return False
    if u["role"] == "Super Administrator":
        return True
    if "perms" not in g:
        g.perms = {(r["module"], r["action"]) for r in db().execute("SELECT module,action FROM perms WHERE role=?", (u["role"],))}
    return (mod, act) in g.perms


def need(mod, act):
    def deco(f):
        @wraps(f)
        def w(*a, **k):
            if not cur():
                return redirect("/login")
            if not can(mod, act):
                abort(403)
            return f(*a, **k)
        return w
    return deco


def login_required(f):
    @wraps(f)
    def w(*a, **k):
        if not cur():
            return redirect("/login")
        return f(*a, **k)
    return w


def uname():
    u = cur()
    return u["username"] if u else "system"


@app.before_request
def _before():
    if not os.path.exists(DB_PATH):
        init_db()
    if request.method == "POST":
        tok = session.get("csrf", "")
        if not tok or not hmac.compare_digest(tok, request.form.get("_csrf", "")):
            abort(400, "Security token missing or expired. Go back, refresh the page and retry.")
        db().execute("BEGIN IMMEDIATE")
    if request.endpoint not in ("login", "setup", "static") and cur() is None and request.endpoint:
        if db().execute("SELECT COUNT(*) n FROM users").fetchone()["n"] == 0 and request.endpoint != "setup":
            return redirect("/setup")
    app.permanent_session_lifetime = dt.timedelta(minutes=int(setting(db(), "session_minutes", "60")))
    session.permanent = True


@app.teardown_request
def _teardown(exc):
    c = g.pop("db", None)
    if c is not None:
        try:
            if c.in_transaction:
                c.execute("ROLLBACK" if exc else "COMMIT")
        finally:
            c.close()


@app.after_request
def _headers(r):
    r.headers["X-Frame-Options"] = "DENY"
    r.headers["X-Content-Type-Options"] = "nosniff"
    r.headers["Referrer-Policy"] = "same-origin"
    r.headers["Cache-Control"] = "no-store"
    r.headers["Content-Security-Policy"] = "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    return r


@app.errorhandler(403)
