# --------------------------------------------------------------------------- database helpers
def conn():
    os.makedirs(DATA_DIR, exist_ok=True)
    c = sqlite3.connect(DB_PATH, timeout=30, isolation_level=None)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA foreign_keys=ON")
    c.execute("PRAGMA journal_mode=WAL")
    return c


@contextmanager
def tx(c):
    c.execute("BEGIN IMMEDIATE")
    try:
        yield c
        c.execute("COMMIT")
    except BaseException:
        if c.in_transaction:
            c.execute("ROLLBACK")
        raise


def setting(c, key, default=None):
    r = c.execute("SELECT value FROM settings WHERE key=?", (key,)).fetchone()
    return r["value"] if r else default


def set_setting(c, key, value):
    c.execute("INSERT INTO settings(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value", (key, str(value)))


def _h(prev, ts, user, action, entity, eid, o, n):
    return hashlib.sha256("|".join([prev, ts, user or "", action, entity, str(eid), o, n]).encode()).hexdigest()


def audit(c, user, action, entity, eid, old=None, new=None):
    """Append to the hash-chained audit trail (each row commits to the previous one)."""
    row = c.execute("SELECT hash FROM audit ORDER BY id DESC LIMIT 1").fetchone()
    prev = row["hash"] if row else "GENESIS"
    ts = now()
    o = json.dumps(old, default=str, sort_keys=True) if old is not None else ""
    n = json.dumps(new, default=str, sort_keys=True) if new is not None else ""
    c.execute("INSERT INTO audit(ts,user,action,entity,entity_id,old,new,prev_hash,hash) VALUES(?,?,?,?,?,?,?,?,?)",
              (ts, user, action, entity, str(eid), o, n, prev, _h(prev, ts, user, action, entity, eid, o, n)))


def verify_audit(c):
    prev = "GENESIS"
    for r in c.execute("SELECT * FROM audit ORDER BY id"):
        if r["prev_hash"] != prev or r["hash"] != _h(prev, r["ts"], r["user"], r["action"], r["entity"], r["entity_id"], r["old"], r["new"]):
            return False, r["id"]
        prev = r["hash"]
    return True, None


def A(c, code):
    r = c.execute("SELECT id FROM accounts WHERE code=?", (code,)).fetchone()
    if not r:
        raise ValueError("Account %s missing from chart of accounts" % code)
    return r["id"]


def new_account(c, name, typ, prefix):
    r = c.execute("SELECT MAX(CAST(code AS INTEGER)) m FROM accounts WHERE code LIKE ?", (prefix + "%",)).fetchone()["m"]
    code = str((r or int(prefix) * 1000) + 1) if len(prefix) == 1 else str((r or int(prefix + "00")) + 1)
    return c.execute("INSERT INTO accounts(code,name,type) VALUES(?,?,?)", (code, name, typ)).lastrowid


def post_journal(c, date, ref, narration, lines, source, sid, uid, reverses=None):
    lines = [(a, d, k) for a, d, k in lines if d or k]
    dr, cr = sum(l[1] for l in lines), sum(l[2] for l in lines)
    if dr != cr or dr <= 0:
        raise ValueError("Journal not balanced (Dr %s, Cr %s)" % (dr, cr))
    jid = c.execute("INSERT INTO journals(date,fy,ref,narration,source,source_id,reverses,created_by,created_at) VALUES(?,?,?,?,?,?,?,?,?)",
                    (date, fy_of(date), ref, narration, source, sid, reverses, uid, now())).lastrowid
    for a, d, k in lines:
        c.execute("INSERT INTO jlines(journal_id,account_id,debit,credit) VALUES(?,?,?,?)", (jid, a, d, k))
    return jid


def init_db():
