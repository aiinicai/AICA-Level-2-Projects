def mk(title, headers, rows, note=""):
    return dict(title=title, headers=headers, rows=rows, note=note)


def r_trial_balance(c, fy, **k):
    s, e = fy_range(fy)
    q = """SELECT a.code,a.name,a.type,
      COALESCE(SUM(CASE WHEN (a.type IN('Income','Expense') AND j.fy=?) OR (a.type NOT IN('Income','Expense') AND j.date<=?) THEN l.debit END),0) dr,
      COALESCE(SUM(CASE WHEN (a.type IN('Income','Expense') AND j.fy=?) OR (a.type NOT IN('Income','Expense') AND j.date<=?) THEN l.credit END),0) cr
      FROM accounts a LEFT JOIN jlines l ON l.account_id=a.id LEFT JOIN journals j ON j.id=l.journal_id GROUP BY a.id ORDER BY a.code"""
    rows, td, tc = [], 0, 0
    for r in c.execute(q, (fy, e, fy, e)):
        n = r["dr"] - r["cr"]
        if n == 0 and r["dr"] == 0:
            continue
        d_, c_ = (n, 0) if n > 0 else (0, -n)
        rows.append([r["code"], r["name"], r["type"], M(d_), M(c_)])
        td += d_; tc += c_
    ps = c.execute("SELECT COALESCE(SUM(l.credit-l.debit),0) s FROM jlines l JOIN journals j ON j.id=l.journal_id JOIN accounts a ON a.id=l.account_id "
                   "WHERE a.type IN('Income','Expense') AND j.date<?", (s,)).fetchone()["s"]
    if ps:
        d_, c_ = (0, ps) if ps > 0 else (-ps, 0)
        rows.append(["-", "Accumulated surplus/(deficit) b/f from prior years", "Equity", M(d_), M(c_)])
        td += d_; tc += c_
    rows.append(["", "TOTAL", "", M(td), M(tc)])
    return mk("Trial Balance - FY %s" % fy, ["Code", "Account", "Type", "Debit", "Credit"], rows,
              "Balanced: debits equal credits." if td == tc else "WARNING: trial balance does not agree - investigate immediately.")


def r_income_exp(c, fy, **k):
    def tot(typ):
        return c.execute("""SELECT a.code,a.name,COALESCE(SUM(l.credit-l.debit),0) v FROM accounts a JOIN jlines l ON l.account_id=a.id JOIN journals j ON j.id=l.journal_id
                            WHERE a.type=? AND j.fy=? GROUP BY a.id ORDER BY a.code""", (typ, fy)).fetchall()
    inc, exp = tot("Income"), tot("Expense")
    rows = [["INCOME", "", ""]] + [[r["code"], r["name"], M(r["v"])] for r in inc]
    ti = sum(r["v"] for r in inc)
    rows += [["", "Total income", M(ti)], ["EXPENDITURE", "", ""]] + [[r["code"], r["name"], M(-r["v"])] for r in exp]
    te = -sum(r["v"] for r in exp)
    rows += [["", "Total expenditure", M(te)], ["", "NET SURPLUS / (DEFICIT)", M(ti - te)]]
    return mk("Income & Expenditure Statement - FY %s" % fy, ["Code", "Particulars", "Amount"], rows, "Derived directly from approved ledger postings (accrual basis).")


def r_ageing(c, fy, **k):
    td = dt.date.today()
    buckets = [30, 60, 90, 180]
    per = {}
    for r in c.execute("SELECT t.id,t.date,t.party_id,c.name FROM txns t JOIN clients c ON c.id=t.party_id WHERE t.type='invoice' AND t.status='Approved'"):
        o = outstanding(c, r["id"])
        if o <= 0:
            continue
        days = (td - dt.date.fromisoformat(r["date"])).days
        i = next((i for i, b in enumerate(buckets) if days <= b), 4)
        row = per.setdefault(r["name"], [0] * 5)
        row[i] += o
    rows = [[n] + [M(x) for x in v] + [M(sum(v))] for n, v in sorted(per.items())]
    tot = [sum(v[i] for v in per.values()) for i in range(5)]
    rows.append(["TOTAL"] + [M(x) for x in tot] + [M(sum(tot))])
    return mk("Client Receivables Ageing (as on %s)" % td.isoformat(), ["Client", "0-30 days", "31-60", "61-90", "91-180", "Above 180", "Total"], rows,
              "Age counted from invoice date; only approved invoices net of approved receipts.")


def r_ledger(c, fy, acct=None, **k):
    if not acct:
        return mk("Ledger", ["Date", "Reference", "Narration", "Debit", "Credit", "Balance"], [], "Choose an account.")
    a = c.execute("SELECT * FROM accounts WHERE id=?", (acct,)).fetchone() or abort(404)
    s, e = fy_range(fy)
    pl = a["type"] in ("Income", "Expense")
    lo = s if pl else "0000-00-00"
    op = c.execute("SELECT COALESCE(SUM(l.debit-l.credit),0) b FROM jlines l JOIN journals j ON j.id=l.journal_id WHERE l.account_id=? AND j.date<?", (acct, s)).fetchone()["b"] if not pl else 0
    rows, bal = [], op
    if op:
        rows.append([s, "", "Opening balance", M(max(op, 0)), M(max(-op, 0)), M(op)])
    for r in c.execute("SELECT j.date,j.ref,j.narration,l.debit,l.credit FROM jlines l JOIN journals j ON j.id=l.journal_id WHERE l.account_id=? AND j.date BETWEEN ? AND ? ORDER BY j.date,j.id,l.id", (acct, s, e)):
        bal += r["debit"] - r["credit"]
        rows.append([r["date"], r["ref"], r["narration"], M(r["debit"]), M(r["credit"]), M(bal)])
    return mk("Ledger: %s %s - FY %s" % (a["code"], a["name"], fy), ["Date", "Reference", "Narration", "Debit", "Credit", "Running balance (Dr+/Cr-)"], rows)


def r_register(typ):
