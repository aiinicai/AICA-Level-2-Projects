@app.route("/t/<typ>/<int:tid>/act", methods=["POST"])
@login_required
def txn_act(typ, tid):
    if typ not in TX:
        abort(404)
    c, u = db(), cur()
    t = get_txn(typ, tid)
    act, comment = request.form.get("act"), request.form.get("comment", "").strip()
    try:
        if act == "submit":
            if t["status"] not in EDITABLE or not can(typ, "submit") or t["maker_id"] != u["id"]:
                raise ValueError("Cannot submit this transaction")
            new = "Pending Approval"
            log_step(c, tid, "Submitted", comment)
        elif act in ("approve", "reject", "return"):
            ok, why = can_approve(c, t, u)
            if not ok:
                raise ValueError(why)
            if act != "approve" and not comment:
                raise ValueError("A comment is mandatory when rejecting or returning a transaction")
            if act == "approve":
                if typ == "receipt" and t["invoice_id"] and t["amount"] > outstanding(c, t["invoice_id"]):
                    raise ValueError("Receipt now exceeds the invoice's outstanding balance")
                jid = post_journal(c, t["date"], t["no"], "%s %s - %s" % (TX[typ]["label"], t["no"], t["narration"] or ""), build_lines(c, t), "txn", tid, u["id"])
                c.execute("UPDATE txns SET status='Approved', approver_id=?, approved_at=?, journal_id=? WHERE id=?", (u["id"], now(), jid, tid))
                log_step(c, tid, "Approved", comment)
                audit(c, uname(), "approve", "txn:" + typ, tid, {"status": t["status"]}, {"status": "Approved", "journal": jid})
                flash("Approved and posted to the ledger.")
                return redirect("/t/%s/%d" % (typ, tid))
            new = "Rejected" if act == "reject" else "Returned for Correction"
            log_step(c, tid, new, comment)
        elif act == "cancel":
            if t["status"] in EDITABLE and t["maker_id"] == u["id"]:
                new = "Cancelled"
                log_step(c, tid, "Cancelled", comment)
            elif t["status"] == "Approved" and can(typ, "cancel"):
                if not comment:
                    raise ValueError("A reason is mandatory to reverse an approved transaction")
                if typ == "invoice" and c.execute("SELECT 1 FROM txns WHERE type='receipt' AND invoice_id=? AND status IN('Approved','Pending Approval')", (tid,)).fetchone():
                    raise ValueError("Cancel the receipts adjusted against this invoice first")
                lines = [(a, k, d) for a, d, k in build_lines(c, t)]
                post_journal(c, today(), "REV-" + t["no"], "Reversal of %s: %s" % (t["no"], comment), lines, "reversal", tid, u["id"], t["journal_id"])
                new = "Cancelled"
                log_step(c, tid, "Cancelled (ledger reversed)", comment)
            else:
                raise ValueError("Cannot cancel this transaction")
            c.execute("UPDATE txns SET reason=? WHERE id=?", (comment, tid))
        else:
            raise ValueError("Unknown action")
        c.execute("UPDATE txns SET status=? WHERE id=?", (new, tid))
        audit(c, uname(), act, "txn:" + typ, tid, {"status": t["status"]}, {"status": new, "comment": comment})
        flash("Status: %s." % new)
    except ValueError as e:
        flash(str(e), "err")
    return redirect("/t/%s/%d" % (typ, tid))


