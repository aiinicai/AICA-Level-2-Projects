def r_exceptions(c, fy, **k):
    rows = []
    for r in c.execute("SELECT v.name,t.ref,GROUP_CONCAT(t.no) nos FROM txns t JOIN vendors v ON v.id=t.party_id WHERE t.type='expense' AND t.status NOT IN('Rejected','Cancelled') GROUP BY t.party_id,lower(t.ref) HAVING COUNT(*)>1"):
        rows.append(["Duplicate vendor invoice", r["nos"], "%s - invoice %s booked more than once" % (r["name"], r["ref"])])
    for r in c.execute("SELECT t.id,t.no,t.date,c.name FROM txns t JOIN clients c ON c.id=t.party_id WHERE t.type='invoice' AND t.status='Approved' AND t.due<?", (today(),)):
        o = outstanding(c, r["id"])
        if o > 0:
            rows.append(["Overdue receivable", r["no"], "%s - %s outstanding, invoice dated %s" % (r["name"], inr(o), r["date"])])
    for r in c.execute("SELECT t.no,t.amount,c.name FROM txns t JOIN clients c ON c.id=t.party_id WHERE t.type='receipt' AND t.status='Approved' AND t.invoice_id IS NULL"):
        rows.append(["Unadjusted advance", r["no"], "%s - %s received without invoice" % (r["name"], inr(r["amount"]))])
    for r in c.execute("SELECT no FROM txns WHERE status='Approved' AND maker_id=approver_id"):
        rows.append(["Segregation-of-duties breach", r["no"], "Maker and approver are the same user"])
    limit = (dt.date.today() - dt.timedelta(days=7)).isoformat()
    for r in c.execute("SELECT t.no,t.date FROM txns t WHERE t.status='Pending Approval' AND t.created_at<?", (limit,)):
        rows.append(["Approval pending > 7 days", r["no"], "Created before %s" % limit])
    for r in c.execute("SELECT t.no FROM txns t JOIN journals j ON j.id=t.journal_id WHERE t.status='Approved' AND (SELECT SUM(debit)-SUM(credit) FROM jlines WHERE journal_id=j.id)<>0"):
        rows.append(["Unbalanced journal", r["no"], "Debit and credit differ"])
    ok, bad = verify_audit(c)
    rows.append(["Audit trail integrity", "-", "Hash chain intact" if ok else "TAMPERING DETECTED at audit record %s" % bad])
    return mk("Exception Report", ["Exception", "Reference", "Details"], rows)


