def save_party(kind, pid=None):
    c, f = db(), request.form
    name = f["name"].strip()
    if not name:
        raise ValueError("Name is required")
    pan, gstin = f.get("pan", "").strip().upper(), f.get("gstin", "").strip().upper()
    if pan and not re.fullmatch(r"[A-Z]{5}\d{4}[A-Z]", pan):
        raise ValueError("PAN format is invalid (e.g. ABCDE1234F)")
    if gstin and not re.fullmatch(r"\d{2}[A-Z]{5}\d{4}[A-Z][A-Z\d]Z[A-Z\d]", gstin):
        raise ValueError("GSTIN format is invalid")
    if pan and c.execute("SELECT 1 FROM %s WHERE pan=? AND id IS NOT ?" % kind, (pan, pid)).fetchone():
        raise ValueError("Another record already has this PAN")
    vals = dict(name=name, pan=pan, gstin=gstin)
    if kind == "clients":
        vals.update(constitution=f.get("constitution", ""), partner=f.get("partner", ""), email=f.get("email", "").strip(), mobile=f.get("mobile", "").strip())
    if pid:
        old = dict(c.execute("SELECT * FROM %s WHERE id=?" % kind, (pid,)).fetchone())
        c.execute("UPDATE %s SET %s WHERE id=?" % (kind, ",".join(k + "=?" for k in vals)), list(vals.values()) + [pid])
        audit(c, uname(), "update", kind, pid, {k: old[k] for k in vals}, vals)
    else:
        n = c.execute("SELECT COUNT(*) n FROM %s" % kind).fetchone()["n"] + 1
        vals["code"] = ("CL" if kind == "clients" else "VN") + "%04d" % n
        pid = c.execute("INSERT INTO %s(%s) VALUES(%s)" % (kind, ",".join(vals), ",".join("?" * len(vals))), list(vals.values())).lastrowid
        audit(c, uname(), "create", kind, pid, None, vals)
    return pid


