@app.route("/admin/backup")
@need("admin", "manage")
def admin_backup():
    p = make_backup("manual")
    audit(db(), uname(), "backup", "system", os.path.basename(p))
    return send_file(p, as_attachment=True, download_name=os.path.basename(p))


def make_backup(tag):
    d = os.path.join(DATA_DIR, "backups")
    os.makedirs(d, exist_ok=True)
    p = os.path.join(d, "icfms_%s_%s.db" % (tag, dt.datetime.now().strftime("%Y%m%d_%H%M%S")))
    src, dst = sqlite3.connect(DB_PATH), sqlite3.connect(p)
    with dst:
        src.backup(dst)
    src.close(); dst.close()
    return p


def daily_backup():
    d = os.path.join(DATA_DIR, "backups")
    if os.path.exists(DB_PATH) and not any(x.startswith("icfms_auto_" + dt.date.today().strftime("%Y%m%d")) for x in (os.listdir(d) if os.path.isdir(d) else [])):
        make_backup("auto")
        files = sorted(x for x in os.listdir(d) if x.startswith("icfms_auto_"))
        for x in files[:-30]:
            os.remove(os.path.join(d, x))


