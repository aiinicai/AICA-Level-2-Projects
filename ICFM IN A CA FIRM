def build_lines(c, t):
    amt, gst, tds, typ = t["amount"], t["gst"], t["tds"], t["type"]
    if typ == "invoice":
        inc = c.execute("SELECT account_id FROM masters WHERE kind='income' AND name=?", (t["head"],)).fetchone()["account_id"]
        return [(A(c, "1100"), amt + gst, 0), (inc, 0, amt), (A(c, "2100"), 0, gst)]
    bank = c.execute("SELECT account_id FROM bank_accounts WHERE id=?", (t["bank_id"],)).fetchone()["account_id"] if t["bank_id"] else None
    if typ == "receipt":
        return [(bank, amt - tds, 0), (A(c, "1150"), tds, 0), (A(c, "1100") if t["invoice_id"] else A(c, "2300"), 0, amt)]
    exp = c.execute("SELECT account_id FROM masters WHERE kind='expense' AND name=?", (t["head"],)).fetchone()["account_id"]
    return [(exp, amt, 0), (A(c, "1200"), gst, 0), (A(c, "2200"), 0, tds), (bank or A(c, "2001"), 0, amt + gst - tds)]


