{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": false,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "lib": ["ES2022"], "types": []
  },
  "include": ["src/**/*.ts"]
}
