{
  "name": "dra-career-portal",
  "private": true,
  "version": "0.1.0",
  "description": "CollectSaarthi - India's Collection Careers & Training Platform",
  "workspaces": [
    "shared",
    "web",
    "functions"
  ],
  "scripts": {
    "test:shared": "npm --workspace shared test",
    "typecheck:shared": "npm --workspace shared run typecheck",
    "build:web": "npm --workspace web run build",
    "build:functions": "npm --workspace functions run build",
    "test:rules": "firebase emulators:exec --only firestore,storage \"tsx --test tests/rules/*.test.ts\"",
    "ci": "npm run typecheck:shared && npm run test:shared && npm run build:functions && npm run build:web",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/seed-site-config.ts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^14.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}