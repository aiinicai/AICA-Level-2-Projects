# Copy this file to .env and fill in real values before deploying to a server.
# For local/dev use, the defaults below (SQLite, DEBUG on) work with no changes.

# --- Core ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-this-to-a-random-50-character-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database -------------------------------------------------------------
# Leave DJANGO_DB_ENGINE unset (or anything other than "postgresql") to use
# the bundled SQLite file — zero setup, fine for a single-machine / demo run.
# Set DJANGO_DB_ENGINE=postgresql and fill these in for a real deployment:
DJANGO_DB_ENGINE=
DJANGO_DB_NAME=far_db
DJANGO_DB_USER=far_user
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# --- Security (set True once served over HTTPS) --------------------------
DJANGO_SECURE_COOKIES=False

# --- FAR policy -----------------------------------------------------------
FAR_COMPANY_NAME=Demo Listed Company Ltd.
FAR_QR_BASE_URL=https://far.yourcompany.com
