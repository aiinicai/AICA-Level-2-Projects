# ---- LLM provider ----
# Options: gemini | stub
AMG_OFFLINE=1
AMG_LLM_PROVIDER=gemini
GEMINI_API_KEY=
AMG_GEMINI_MODEL=gemini-3.5-flash

# ---- Embeddings provider ----
# Options: voyage | local
AMG_EMBED_PROVIDER=voyage
VOYAGE_API_KEY=
AMG_VOYAGE_MODEL=voyage-4-lite

# ---- Quota protection ----
# Options: live_first | read_write | read_only | off | refresh
# live_first tries the provider, then uses a pre-warmed real response on error.
AMG_CACHE_MODE=live_first
AMG_DAILY_LIVE_CALL_CAP=100

# ---- Governance tuning (Section 9 open questions) ----
AMG_CONTEXTUAL_TOP_K=6
AMG_CONTRADICTION_MIN_CONFIDENCE=0.70
AMG_CHECKER_STRICTNESS=balanced
AMG_EXPORT_PASSPHRASE=capstone-demo-2026

# ---- Storage ----
AMG_DB_PATH=amg_memory.db
