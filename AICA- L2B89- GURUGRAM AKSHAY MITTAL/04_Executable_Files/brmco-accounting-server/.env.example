# BRMCo Accounting Hub — Server Host configuration
# Copy to .env and fill in. Never commit .env. These values stay on the server.

ENVIRONMENT=development
LOG_LEVEL=INFO
MIN_LOCAL_VERSION=1.0.0

# Comma-separated browser origins allowed to call this API (empty = none)
CORS_ORIGINS=

# memory (Phase 1) | mongodb (Phase 5)
REPOSITORY_BACKEND=memory

# ---- Future-phase secrets. Server only. Never copy into a Local Host. ----
SECRET_KEY=
AI_API_KEY=
MONGODB_URI=
MONGODB_DATABASE=brmco
