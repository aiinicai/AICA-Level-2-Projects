# BRMCo Accounting Hub — Local Host configuration
# Copy to .env (optional). These are first-run defaults; after that, values saved
# in the Settings screen take precedence.
#
# This file must NEVER contain AI provider keys, MongoDB credentials or any
# other server secret. Those belong to the Server Host only.

# Where the SQLite database, logs, generated XML and uploaded files are kept
# DATA_DIR=C:\BRMCo\data

LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

# TallyPrime XML server (TallyPrime: F1 > Settings > Connectivity)
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_TIMEOUT_SECONDS=30

# BRMCo Server Host. Use https:// for any non-local server.
SERVER_BASE_URL=http://127.0.0.1:8001
SERVER_TIMEOUT_SECONDS=10

# Start in demo mode (simulated Tally, nothing posted)
DEMO_MODE=true
