# Copy this file to ".env" to change the defaults.

# Port the app listens on (Audit Working Paper Pro uses 3000, so this suite uses 3100)
PORT=3100

# 127.0.0.1 = this computer only, 0.0.0.0 = whole network (the BAT files set this for you)
# HOST=0.0.0.0

# Full path of the SQLite database file (default: <app folder>\data\gstr2b_recon.db)
# GSR_DB_PATH=D:\GST Data\gstr2b_recon.db
