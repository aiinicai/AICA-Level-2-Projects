# Replace ticktrail.example.in with your own web address (for example ticktrail.yourfirm.in).
# That name must point to this office's public IP address, and the router must forward ports 80 and 443 to this computer.
# Caddy gets and renews the HTTPS certificate by itself.

ticktrail.example.in {
	encode gzip
	reverse_proxy 127.0.0.1:8080 {
		# keep live updates flowing to each browser without delay
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	request_body {
		max_size 25MB
	}
}
