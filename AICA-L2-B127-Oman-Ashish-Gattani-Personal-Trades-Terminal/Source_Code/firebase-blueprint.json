{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated ArthaTerminal investor profile, watchlist, theme, and risk preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the owner."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "Display name from Google Sign-In."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Verified email address (strictly owner-only PII)."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 512,
          "description": "Optional profile avatar URL."
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "description": "UI color theme preference."
        },
        "watchlist": {
          "type": "array",
          "description": "Bounded list of NSE ticker symbols watched by the user (max 60)."
        },
        "accountCapitalInr": {
          "type": "number",
          "description": "Account equity capital in INR for Minervini position sizing."
        },
        "defaultRiskPct": {
          "type": "number",
          "description": "Default risk percentage per trade (0.1 to 10)."
        },
        "nseConnectorEnabled": {
          "type": "boolean",
          "description": "Whether the NSE India direct feed connector is enabled."
        },
        "bseConnectorEnabled": {
          "type": "boolean",
          "description": "Whether the BSE Star & Corporate Filings connector is enabled."
        },
        "brokerConnectorName": {
          "type": "string",
          "enum": ["Zerodha Kite", "Dhan HQ", "Upstox Pro", "Disconnected"],
          "description": "Selected Indian execution broker bridge."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "photoURL",
        "theme",
        "watchlist",
        "accountCapitalInr",
        "defaultRiskPct",
        "nseConnectorEnabled",
        "bseConnectorEnabled",
        "brokerConnectorName",
        "createdAt",
        "updatedAt"
      ]
    },
    "PortfolioHolding": {
      "title": "PortfolioHolding",
      "description": "An NSE/BSE equity position in the user's portfolio with target rebalancing weight.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ticker": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[A-Z0-9&\\-]+$"
        },
        "shares": {
          "type": "number"
        },
        "avgCostInr": {
          "type": "number"
        },
        "targetWeightPct": {
          "type": "number"
        },
        "stopLossInr": {
          "type": "number",
          "description": "Optional user-defined stop-loss price in INR (0 when unset)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "ticker",
        "shares",
        "avgCostInr",
        "targetWeightPct",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedScan": {
      "title": "SavedScan",
      "description": "Saved 52-week high breakout scanner configuration and daily IST schedule.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "lookbackMonths": {
          "type": "number"
        },
        "priceBasis": {
          "type": "string",
          "enum": ["close", "high"]
        },
        "minVolumeRatio": {
          "type": "number"
        },
        "minPriceInr": {
          "type": "number"
        },
        "minTurnoverCr": {
          "type": "number"
        },
        "capBucket": {
          "type": "string",
          "maxLength": 20
        },
        "sector": {
          "type": "string",
          "maxLength": 40
        },
        "scheduleEnabled": {
          "type": "boolean"
        },
        "scheduleTimeIst": {
          "type": "string",
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "name",
        "lookbackMonths",
        "priceBasis",
        "minVolumeRatio",
        "minPriceInr",
        "minTurnoverCr",
        "capBucket",
        "sector",
        "scheduleEnabled",
        "scheduleTimeIst",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomIndicatorDoc": {
      "title": "CustomIndicatorDoc",
      "description": "User-defined custom technical indicator formula, parameters, and signal rules.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[A-Z0-9_]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "formula": {
          "type": "string",
          "maxLength": 600
        },
        "buyRule": {
          "type": "string",
          "maxLength": 400
        },
        "sellRule": {
          "type": "string",
          "maxLength": 400
        },
        "plotType": {
          "type": "string",
          "enum": ["overlay", "subchart"]
        },
        "color": {
          "type": "string",
          "maxLength": 16
        },
        "param1Name": {
          "type": "string",
          "maxLength": 24
        },
        "param1Value": {
          "type": "number"
        },
        "param2Name": {
          "type": "string",
          "maxLength": 24
        },
        "param2Value": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "code",
        "name",
        "description",
        "formula",
        "buyRule",
        "sellRule",
        "plotType",
        "color",
        "param1Name",
        "param1Value",
        "param2Name",
        "param2Value",
        "createdAt",
        "updatedAt"
      ]
    },
    "AlertItem": {
      "title": "AlertItem",
      "description": "User notification or alert for 52W breakouts, Trend Template shifts, VCP pivots, custom indicators, or watchlist price/news.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ticker": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[A-Z0-9&\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": [
            "breakout_52w",
            "trend_template",
            "vcp_pivot",
            "custom_indicator",
            "price",
            "news"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "maxLength": 400
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "ticker",
        "category",
        "title",
        "message",
        "read",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomWatchlist": {
      "title": "CustomWatchlist",
      "description": "Named NSE/BSE equity watchlist (up to 5 per user) for comparative TechnoFunda and risk analysis.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 48
        },
        "slotIndex": {
          "type": "number",
          "description": "Watchlist slot index between 1 and 5."
        },
        "notes": {
          "type": "string",
          "maxLength": 240
        },
        "tickers": {
          "type": "array",
          "description": "Bounded list of NSE ticker symbols in this watchlist (max 60)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "name",
        "slotIndex",
        "notes",
        "tickers",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated user profile, watchlist, theme, connector flags, and risk parameters."
    },
    "/users/{userId}/holdings/{holdingId}": {
      "schema": { "$ref": "#/entities/PortfolioHolding" },
      "description": "User portfolio holdings with shares, average cost in INR, and target weight %."
    },
    "/users/{userId}/savedScans/{scanId}": {
      "schema": { "$ref": "#/entities/SavedScan" },
      "description": "User-saved 52-week breakout scan definitions and IST schedules."
    },
    "/users/{userId}/customIndicators/{indicatorId}": {
      "schema": { "$ref": "#/entities/CustomIndicatorDoc" },
      "description": "User-created custom technical indicators with formulas and buy/sell signal rules."
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/AlertItem" },
      "description": "User alerts and notifications for watchlisted NSE/BSE stocks."
    },
    "/users/{userId}/watchlists/{watchlistId}": {
      "schema": { "$ref": "#/entities/CustomWatchlist" },
      "description": "User-managed named watchlists (up to 5 slots, max 60 tickers each) analyzed inside Portfolio & Risk Management."
    }
  }
}
