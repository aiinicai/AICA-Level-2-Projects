# Copy this file to .env.local (same folder) and paste your key after the = sign. Never share .env.local.
# Used ONLY by `npm run dev` on this computer for AI testing; production keeps the key in Supabase secrets.
GEMINI_API_KEY=
# free = TESTING WITH DUMMY DATA ONLY (Google may use free-tier content to improve its products). Change to paid once billing is on.
GEMINI_TIER=free
# Optional: stronger model for reading bills/audio/notices, fast model for text-only tasks
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
AI_DAILY_LIMIT_PER_CLIENT=200
