{
  "name": "vouchr-expense-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "test:db": "node supabase/tests/db-check.mjs",
    "build:file": "tsc --noEmit && vite build --mode file && node scripts/make-demo-file.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/manrope": "5.2.8",
    "@fontsource-variable/noto-sans-devanagari": "5.2.8",
    "@supabase/supabase-js": "2.46.1",
    "@tesseract.js-data/eng": "1.0.0",
    "jsqr": "1.4.0",
    "pdfjs-dist": "4.4.168",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "read-excel-file": "9.3.12",
    "tesseract.js": "5.1.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vite-plugin-singlefile": "2.2.0",
    "vitest": "2.1.8"
  }
}
