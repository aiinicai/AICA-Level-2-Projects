# CompanyVal AI — environment configuration (placeholders only; never commit real secrets)

# Database — defaults to SQLite for local development.
# For PostgreSQL use e.g. postgresql+psycopg://user:pass@localhost:5432/companyval
DATABASE_URL=sqlite:///../storage/companyval.db

# Application secret (sessions / signing)
SECRET_KEY=

# Master key used to encrypt stored AI provider API keys (Fernet key).
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COMPANYVAL_MASTER_KEY=

# Storage locations (relative to backend/ or absolute)
UPLOAD_DIR=../storage/uploads
RENDER_DIR=../storage/rendered_pages
REPORT_DIR=../storage/reports

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# The Gemini API key is NOT configured here.
# It is entered in the app Settings screen, validated, encrypted with
# COMPANYVAL_MASTER_KEY and stored server-side. It is never sent to the browser.
