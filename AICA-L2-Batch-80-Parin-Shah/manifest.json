{
  "manifest_version": 3,
  "name": "BioLock Web",
  "version": "1.0",
  "description": "Lock specific websites with a password or biometrics.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}