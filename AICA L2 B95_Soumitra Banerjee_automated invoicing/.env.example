# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Database Configuration (SQLite for Prototype, can be replaced with PostgreSQL)
DATABASE_URL="file:./prisma/dev.db"

# Mail server port (server/index.mjs) - the Vite dev server proxies /api to this port
API_PORT=5174

# SMTP Configuration
# Leave DEMO_EMAIL_MODE=true to keep emails simulated in the Email Outbox only
# (nothing is actually sent). Set it to false once SMTP_PASS below is filled in
# with a real Gmail App Password to have the app dispatch real emails.
DEMO_EMAIL_MODE=true
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="soumitrabanerjee2001@gmail.com"
# Gmail requires a 16-character App Password (Google Account > Security > 2-Step
# Verification > App Passwords), NOT your normal Gmail login password.
SMTP_PASS="your_gmail_app_password_here"
SMTP_SENDER="soumitrabanerjee2001@gmail.com"

# IMAP Configuration - used to detect a client's actual "CONFIRMED" reply
# (Confirmations screen) instead of only the manual Simulate button.
# Reuses the same Gmail account and App Password above.
# IMPORTANT: in Gmail, go to Settings -> See all settings -> Forwarding and
# POP/IMAP -> enable IMAP access, or this will fail to connect.
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993

