# Copy this file into a folder named .streamlit (inside 03_Code) and name the copy secrets.toml, then fill in what you need.
# NEVER upload secrets.toml to GitHub. Only this .example file is uploaded.
# Anything left out uses the safe default shown in brackets.

# ---------- Database ----------
# Leave empty to use a local SQLite file (default, easiest for testing).
# For Supabase / PostgreSQL paste the connection string, for example:
# DATABASE_URL = "postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
DATABASE_URL = ""
SQLITE_PATH = "audit_tracker.db"

# ---------- E-mail ----------
# EMAIL_MODE: "log" (nothing is sent) | "gmail" | "smtp" | "graph"
EMAIL_MODE = "log"

# While testing, send EVERY e-mail to this one address only (recommended):
# TEST_EMAIL_OVERRIDE = "your.own.address@gmail.com"

# Variant A - Gmail (needs 2-step verification and an "app password")
# GMAIL_USER = "your.test.account@gmail.com"
# GMAIL_APP_PASSWORD = "xxxx xxxx xxxx xxxx"

# Any SMTP server or company relay
# SMTP_HOST = "smtp.office365.com"
# SMTP_PORT = "587"
# SMTP_USER = ""
# SMTP_PASSWORD = ""
# SMTP_FROM = "audit.followup@yourcompany.com"

# Variant B - Microsoft 365 through Microsoft Graph (IT registers the app)
# GRAPH_TENANT_ID = ""
# GRAPH_CLIENT_ID = ""
# GRAPH_CLIENT_SECRET = ""
# GRAPH_SENDER = "audit.followup@yourcompany.com"

# ---------- Rules ----------
# REMINDER_DAYS = "7"            # reminder is sent this many days after the response due date
# ESCALATION_ENABLED = "false"   # "true" sends a second e-mail to the department head
# ESCALATION_DAYS = "14"

# ---------- Screens ----------
# APP_URL = "http://audit-tracker:8501"        # link placed in the e-mails
# SHOW_TEST_LOGIN_HINT = "true"                # set "false" in production
# DEFAULT_PASSWORD = "Test@123"                # password given to the 30 users when the database is first created
