# Copy to .env for local development, and set the same two variables on Railway
# (Service -> Variables). Vite inlines them at BUILD time, so changing them on
# Railway requires a redeploy, not just a restart.
#
# Supabase dashboard -> Project Settings -> Data API / API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Both values are safe in the browser: the anon key only ever acts through
# row-level security. Never put the service_role key in this file.
