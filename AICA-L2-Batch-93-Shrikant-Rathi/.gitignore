# Local Python environment
.venv/
__pycache__/
*.pyc

# Downloaded / generated data (rebuilt by Refresh_Data.bat)
data/cache/*
data/live/*
!data/cache/_README.txt
!data/live/_README.txt

# AMC files are downloaded by the user from each AMC's website
data/amc_portfolios/*
!data/amc_portfolios/_README.txt
!data/amc_portfolios/_sources.csv

# Logs
logs/*
!logs/_README.txt

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Verify tooling and outputs
verify/node_modules/
verify/shots/
verify/reference_metrics.json

# Local secrets
.env

# User data entered in the app (entities, transactions, users, audit) - never committed
data/user/
# companies fetched by older versions (now kept in data/user) - never committed
data/config/user_universe.json
