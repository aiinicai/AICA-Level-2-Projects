# Copy to .env and adjust. .env is git-ignored. Never commit real values.
# Every variable is optional; defaults are shown.

# --- Server ---
CFF_HOST=127.0.0.1
CFF_PORT=8000
# Set both to serve HTTPS on the intranet (required when CFF_HOST is not 127.0.0.1)
CFF_SSL_CERTFILE=
CFF_SSL_KEYFILE=

# --- Paths (relative paths are resolved from the project folder) ---
CFF_INSTANCE_DIR=instance

# --- Secrets ---
# Leave empty to auto-generate instance/secret.key on first run.
CFF_SECRET_KEY=
# Passphrase used to encrypt backups. Leave empty to auto-generate instance/backup.key.
CFF_BACKUP_PASSPHRASE=

# --- Sessions ---
CFF_SESSION_MAX_AGE_MINUTES=480

# --- Uploads ---
CFF_UPLOAD_MAX_MB=10

# --- Backups (encrypted; one a day automatically while the app runs) ---
CFF_AUTO_BACKUP=true
CFF_BACKUP_KEEP=30
# A second place for every backup (network share or another disk), e.g. \\fileserver\finance\cff_backups
CFF_BACKUP_COPY_DIR=

# --- Excel export formula check (LibreOffice). Empty: found automatically ---
CFF_SOFFICE_PATH=
CFF_RECALC_TIMEOUT_SECONDS=180

# --- Display: times are stored in UTC and shown at this offset (Oman = 4) ---
CFF_UTC_OFFSET_HOURS=4

# --- Business defaults (seeded into the database on first run; editable later by Admin) ---
CFF_BASE_CURRENCY=OMR
CFF_CURRENCY_DECIMALS=3
CFF_LOT_SCHEME=month_thirds
CFF_LOT_LENGTH_DAYS=10
CFF_HORIZON_MONTHS=3
CFF_HORIZON_LOTS=3
CFF_SHOW_MONTH_TOTALS=true
CFF_APPROVER_ENABLED=false
