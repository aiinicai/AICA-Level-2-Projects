# Runtime data - never commit (databases, uploads, exports, backups, keys)
instance/*
!instance/.gitkeep
.env
*.db
*.sqlite3
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# never commit backups, offline wheels or saved .env copies
*.cffbak
*.csr
wheels/
.env.bak
