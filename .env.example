# Copy this file to ".env" and fill in your key. NEVER commit .env (it is in .gitignore).

# Which provider the dashboard uses by default: anthropic | openai | groq
LLM_PROVIDER=anthropic

# Model name. Leave blank for the defaults (claude-sonnet-5-5 / gpt-4o-mini / openai/gpt-oss-120b).
LLM_MODEL=claude-sonnet-5-5

ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GROQ_API_KEY=your_groq_key_here

# Optional tuning
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
