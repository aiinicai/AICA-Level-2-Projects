# LexSecure India Pro - Environment Configuration
# Copy this file to .env or set environment variables in your system

# (Optional) Google Gemini Flash API Key
# If omitted, LexSecure India Pro automatically utilizes its built-in Indian Statutory Heuristic Rule Engine
GEMINI_API_KEY=your_gemini_api_key_here

# Django Secret Key (Preconfigured for local development)
SECRET_KEY=django-insecure-lexsecure-india-pro-super-secret-enterprise-key

# Debug Mode (True for development, False for production)
DEBUG=True
