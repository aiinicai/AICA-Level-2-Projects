APP_NAME="Restaurant Sales & Reconciliation System"
APP_ENV="development"
SECRET_KEY="secret-key-for-jwt-session-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

DATABASE_URL="sqlite:///./data/restaurant_reconcile.db"
UPLOAD_DIR="./uploads"
EXPORT_DIR="./exports"
LOG_DIR="./logs"

DEFAULT_DATE_TOLERANCE_DAYS=3
DEFAULT_AMOUNT_TOLERANCE=0.05
DEFAULT_CURRENCY="INR"

# Day-book photos only (Excel/bank files stay on this PC).
