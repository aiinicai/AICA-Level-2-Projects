{
  "entities": {
    "User": {
      "path": "/users/{userId}",
      "fields": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "lastLoginAt": { "type": "timestamp" }
      }
    },
    "SavedSolve": {
      "path": "/users/{userId}/saved_solves/{solveId}",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "kociembaString": { "type": "string" },
        "solutionMoves": { "type": "string" },
        "moveCount": { "type": "number" },
        "solveTimeMs": { "type": "number" },
        "timestamp": { "type": "timestamp" }
      }
    }
  }
}
