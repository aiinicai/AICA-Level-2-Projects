{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated hospital enterprise user with RBAC role and department assignment",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["CFO", "Finance/Billing Manager", "Department Manager", "Auditor"] },
        "department": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "lastLoginAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "email", "name", "role"]
    },
    "Department": {
      "title": "Department",
      "description": "Hospital clinical and diagnostic department entity",
      "type": "object",
      "properties": {
        "departmentId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 20 },
        "hodName": { "type": "string", "maxLength": 100 },
        "hodEmail": { "type": "string", "maxLength": 128 },
        "bedCount": { "type": "number" },
        "budgetAnnual": { "type": "number" },
        "operatingStatus": { "type": "string", "enum": ["Active", "Maintenance", "Expanded"] }
      },
      "required": ["departmentId", "name", "code"]
    },
    "Encounter": {
      "title": "Encounter",
      "description": "Patient hospital stay or outpatient clinical encounter record",
      "type": "object",
      "properties": {
        "Encounter_ID": { "type": "string", "maxLength": 64 },
        "Patient_ID": { "type": "string", "maxLength": 64 },
        "Patient_Name": { "type": "string", "maxLength": 100 },
        "Age": { "type": "number" },
        "Gender": { "type": "string", "maxLength": 10 },
        "Department": { "type": "string", "maxLength": 100 },
        "Ward": { "type": "string", "maxLength": 50 },
        "Bed_Category": { "type": "string", "maxLength": 50 },
        "Admission_DateTime": { "type": "string", "maxLength": 50 },
        "Discharge_DateTime": { "type": "string", "maxLength": 50 },
        "Length_Of_Stay_Hours": { "type": "number" },
        "Discharge_Status": { "type": "string", "maxLength": 50 },
        "Financial_Gate_Pass_Status": { "type": "string", "maxLength": 50 },
        "Primary_Diagnosis": { "type": "string", "maxLength": 200 },
        "Treating_Consultant": { "type": "string", "maxLength": 100 },
        "Payer_Type": { "type": "string", "maxLength": 50 },
        "TPA_Name": { "type": "string", "maxLength": 100 },
        "Policy_Number": { "type": "string", "maxLength": 50 }
      },
      "required": ["Encounter_ID", "Patient_ID", "Patient_Name", "Department", "Admission_DateTime"]
    },
    "Service": {
      "title": "Service",
      "description": "Clinical or diagnostic procedure, medication or bed charge performed",
      "type": "object",
      "properties": {
        "Service_ID": { "type": "string", "maxLength": 64 },
        "Encounter_ID": { "type": "string", "maxLength": 64 },
        "Service_DateTime": { "type": "string", "maxLength": 50 },
        "Revenue_Centre": { "type": "string", "maxLength": 100 },
        "Department": { "type": "string", "maxLength": 100 },
        "Service_Code": { "type": "string", "maxLength": 50 },
        "Service_Description": { "type": "string", "maxLength": 200 },
        "Quantity_Ordered": { "type": "number" },
        "Tariff_Rate": { "type": "number" },
        "Expected_Total": { "type": "number" },
        "Clinician_ID": { "type": "string", "maxLength": 64 },
        "Performing_Nurse_ID": { "type": "string", "maxLength": 64 },
        "Service_Status": { "type": "string", "maxLength": 50 },
        "Department_Clearance_Status": { "type": "string", "maxLength": 50 }
      },
      "required": ["Service_ID", "Encounter_ID", "Service_DateTime", "Revenue_Centre", "Department", "Service_Code"]
    },
    "Billing": {
      "title": "Billing",
      "description": "Itemized billed invoice charges generated by billing desk",
      "type": "object",
      "properties": {
        "Bill_ID": { "type": "string", "maxLength": 64 },
        "Encounter_ID": { "type": "string", "maxLength": 64 },
        "Bill_DateTime": { "type": "string", "maxLength": 50 },
        "Revenue_Centre": { "type": "string", "maxLength": 100 },
        "Service_Code": { "type": "string", "maxLength": 50 },
        "Service_Description": { "type": "string", "maxLength": 200 },
        "Billed_Quantity": { "type": "number" },
        "Unit_Rate": { "type": "number" },
        "Gross_Amount": { "type": "number" },
        "Discount_Amount": { "type": "number" },
        "Net_Amount": { "type": "number" },
        "Billed_By": { "type": "string", "maxLength": 100 },
        "Bill_Type": { "type": "string", "maxLength": 50 },
        "Invoice_Number": { "type": "string", "maxLength": 50 }
      },
      "required": ["Bill_ID", "Encounter_ID", "Bill_DateTime", "Revenue_Centre", "Gross_Amount", "Net_Amount"]
    },
    "Claim": {
      "title": "Claim",
      "description": "Insurance / TPA claim submission and adjudication ledger",
      "type": "object",
      "properties": {
        "Claim_ID": { "type": "string", "maxLength": 64 },
        "Encounter_ID": { "type": "string", "maxLength": 64 },
        "Payer_Type": { "type": "string", "maxLength": 50 },
        "TPA_Name": { "type": "string", "maxLength": 100 },
        "Pre_Auth_Amount": { "type": "number" },
        "Claim_Amount": { "type": "number" },
        "Approved_Amount": { "type": "number" },
        "Disallowed_Amount": { "type": "number" },
        "Claim_Submission_Date": { "type": "string", "maxLength": 50 },
        "Adjudication_Date": { "type": "string", "maxLength": 50 },
        "Claim_Status": { "type": "string", "maxLength": 50 },
        "Disallowance_Reason": { "type": "string", "maxLength": 200 },
        "Settlement_Reference": { "type": "string", "maxLength": 100 }
      },
      "required": ["Claim_ID", "Encounter_ID", "Claim_Amount", "Claim_Status"]
    },
    "Collection": {
      "title": "Collection",
      "description": "Cash, card, UPI and NEFT patient or sponsor payments received",
      "type": "object",
      "properties": {
        "Receipt_ID": { "type": "string", "maxLength": 64 },
        "Encounter_ID": { "type": "string", "maxLength": 64 },
        "Receipt_DateTime": { "type": "string", "maxLength": 50 },
        "Payer_Type": { "type": "string", "maxLength": 50 },
        "Payment_Mode": { "type": "string", "maxLength": 50 },
        "Amount_Collected": { "type": "number" },
        "Collected_By": { "type": "string", "maxLength": 100 },
        "Bank_Reference": { "type": "string", "maxLength": 100 },
        "Receipt_Type": { "type": "string", "maxLength": 50 },
        "Outstanding_Balance_Post_Payment": { "type": "number" }
      },
      "required": ["Receipt_ID", "Encounter_ID", "Receipt_DateTime", "Amount_Collected"]
    },
    "TariffMaster": {
      "title": "TariffMaster",
      "description": "Approved hospital tariff schedule by department and revenue centre",
      "type": "object",
      "properties": {
        "tariffId": { "type": "string", "maxLength": 64 },
        "serviceCode": { "type": "string", "maxLength": 50 },
        "revenueCentre": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "maxLength": 100 },
        "serviceName": { "type": "string", "maxLength": 200 },
        "standardRate": { "type": "number" },
        "tpaRates": { "type": "object" },
        "effectiveFrom": { "type": "string", "maxLength": 50 },
        "effectiveTo": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["tariffId", "serviceCode", "serviceName", "standardRate"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Annual and monthly financial operating revenue and cost budgets",
      "type": "object",
      "properties": {
        "budgetId": { "type": "string", "maxLength": 64 },
        "department": { "type": "string", "maxLength": 100 },
        "revenueCentre": { "type": "string", "maxLength": 100 },
        "annualBudget": { "type": "number" },
        "monthlyBudget": { "type": "number" },
        "quarterlyBudget": { "type": "number" },
        "costCentreCode": { "type": "string", "maxLength": 50 },
        "year": { "type": "number" }
      },
      "required": ["budgetId", "department", "annualBudget", "monthlyBudget"]
    },
    "ControlRun": {
      "title": "ControlRun",
      "description": "Execution timestamp and summary metrics of C01-C08 control engine",
      "type": "object",
      "properties": {
        "runId": { "type": "string", "maxLength": 64 },
        "executedAt": { "type": "string", "maxLength": 50 },
        "executedBy": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 50 },
        "recordsProcessed": { "type": "number" },
        "exceptionsGenerated": { "type": "number" },
        "grossBilling": { "type": "number" },
        "potentialExposure": { "type": "number" },
        "totalExpectedAmount": { "type": "number" },
        "outstandingCollections": { "type": "number" },
        "tpaPendingAmount": { "type": "number" }
      },
      "required": ["runId", "executedAt", "recordsProcessed", "exceptionsGenerated"]
    },
    "FinancialException": {
      "title": "FinancialException",
      "description": "Discovered financial revenue leakage exception item",
      "type": "object",
      "properties": {
        "Exception_ID": { "type": "string", "maxLength": 64 },
        "Encounter_ID": { "type": "string", "maxLength": 64 },
        "Patient_Name": { "type": "string", "maxLength": 100 },
        "Department": { "type": "string", "maxLength": 100 },
        "Revenue_Centre": { "type": "string", "maxLength": 100 },
        "Control_ID": { "type": "string", "maxLength": 20 },
        "Severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "Exposure_Amount": { "type": "number" },
        "Description": { "type": "string", "maxLength": 500 },
        "Detected_At": { "type": "string", "maxLength": 50 },
        "Status": { "type": "string", "enum": ["OPEN", "INVESTIGATING", "RESOLVED", "ACCEPTED_RISK", "DISPUTED"] },
        "Assigned_To": { "type": "string", "maxLength": 100 },
        "Resolution": { "type": "string", "maxLength": 500 },
        "Resolved_Date": { "type": "string", "maxLength": 50 }
      },
      "required": ["Exception_ID", "Encounter_ID", "Control_ID", "Severity", "Exposure_Amount", "Status"]
    },
    "DepartmentClearance": {
      "title": "DepartmentClearance",
      "description": "Clinical department financial verification record for an encounter",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "encounterId": { "type": "string", "maxLength": 64 },
        "patientName": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "maxLength": 100 },
        "admissionDate": { "type": "string", "maxLength": 50 },
        "dischargeDate": { "type": "string", "maxLength": 50 },
        "unbilledExposure": { "type": "number" },
        "varianceExposure": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING_VERIFICATION", "VERIFIED", "DISPUTED", "CORRECTION_REQUIRED", "UNABLE_TO_VERIFY"] },
        "servicesCount": { "type": "number" },
        "totalValue": { "type": "number" },
        "comment": { "type": "string", "maxLength": 500 },
        "evidenceRef": { "type": "string", "maxLength": 100 },
        "reviewedBy": { "type": "string", "maxLength": 100 },
        "reviewedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "encounterId", "department", "status"]
    },
    "ExceptionResolution": {
      "title": "ExceptionResolution",
      "description": "Historical resolution ledger for exception modifications",
      "type": "object",
      "properties": {
        "resolutionId": { "type": "string", "maxLength": 64 },
        "exceptionId": { "type": "string", "maxLength": 64 },
        "encounterId": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "assignedTo": { "type": "string", "maxLength": 100 },
        "resolutionNote": { "type": "string", "maxLength": 500 },
        "resolvedBy": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "financialAdjustment": { "type": "number" }
      },
      "required": ["resolutionId", "exceptionId", "action", "resolvedBy", "timestamp"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable forensic audit event trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "user": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 50 },
        "entityType": { "type": "string", "maxLength": 50 },
        "entityId": { "type": "string", "maxLength": 64 },
        "details": { "type": "string", "maxLength": 500 },
        "previousValue": { "type": "string", "maxLength": 200 },
        "newValue": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "timestamp", "user", "role", "action", "entityType", "entityId"]
    },
    "CfoReport": {
      "title": "CfoReport",
      "description": "Executive CFO Boardroom Dossier and Governance snapshot",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "maxLength": 64 },
        "generatedAt": { "type": "string", "maxLength": 50 },
        "generatedBy": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 50 },
        "runId": { "type": "string", "maxLength": 64 },
        "grossBilling": { "type": "number" },
        "potentialExposure": { "type": "number" },
        "outstandingAr": { "type": "number" },
        "departmentClearancePct": { "type": "number" },
        "title": { "type": "string", "maxLength": 200 }
      },
      "required": ["reportId", "generatedAt", "generatedBy", "runId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles with role and department information"
    },
    "/departments/{departmentId}": {
      "schema": "Department",
      "description": "Hospital clinical and diagnostic department master records"
    },
    "/encounters/{encounterId}": {
      "schema": "Encounter",
      "description": "Patient hospital stay or outpatient clinical encounter records"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Clinical or diagnostic procedure, medication or bed charges"
    },
    "/billing/{billingId}": {
      "schema": "Billing",
      "description": "Itemized billed invoice charges generated by billing desk"
    },
    "/claims/{claimId}": {
      "schema": "Claim",
      "description": "Insurance / TPA claim submission and adjudication records"
    },
    "/collections/{collectionId}": {
      "schema": "Collection",
      "description": "Cash, card, UPI and NEFT patient or sponsor payments received"
    },
    "/tariff_master/{tariffId}": {
      "schema": "TariffMaster",
      "description": "Approved hospital tariff schedule by department and revenue centre"
    },
    "/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "Annual and monthly financial operating revenue and cost budgets"
    },
    "/control_runs/{runId}": {
      "schema": "ControlRun",
      "description": "Execution timestamp and summary metrics of C01-C08 control engine"
    },
    "/exceptions/{exceptionId}": {
      "schema": "FinancialException",
      "description": "Discovered financial revenue leakage exception items"
    },
    "/department_clearances/{clearanceId}": {
      "schema": "DepartmentClearance",
      "description": "Clinical department financial verification records for encounters"
    },
    "/exception_resolutions/{resolutionId}": {
      "schema": "ExceptionResolution",
      "description": "Historical resolution ledger for exception modifications"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable forensic audit event trail"
    },
    "/cfo_reports/{reportId}": {
      "schema": "CfoReport",
      "description": "Executive CFO Boardroom Dossier and Governance snapshots"
    }
  }
}
