model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SampleDataFile", "Fact_SC_PL", "Dim_Date", "Dim_OpCo", "Dim_SC_Function", "Dim_Account", "Dim_Scenario", "Dim_KPI", "PL_Layout", "User_Access", "Publish_Control", "DQ_Exceptions", "Refresh_Log", "Refresh_Stamp", "Period Mode", "_Measures", "Display Unit", "DQ_Rules"]

annotation PBI_ProTooling = ["DevMode"]

ref table Fact_SC_PL
ref table Dim_Date
ref table Dim_OpCo
ref table Dim_SC_Function
ref table Dim_Account
ref table Dim_Scenario
ref table Dim_KPI
ref table PL_Layout
ref table User_Access
ref table Publish_Control
ref table DQ_Exceptions
ref table Refresh_Log
ref table Refresh_Stamp
ref table 'Period Mode'
ref table _Measures
ref table 'Display Unit'
ref table DQ_Rules
ref table 'CG Scenario'
ref table 'CG Period'

ref role 'SC Viewer'
ref role 'SC Admin'

ref cultureInfo en-US

