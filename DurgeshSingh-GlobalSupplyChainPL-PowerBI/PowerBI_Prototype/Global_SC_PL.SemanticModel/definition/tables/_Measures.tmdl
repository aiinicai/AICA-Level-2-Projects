	measure 'SVG Page Title' =
			VAR _t = SUBSTITUTE ( [Report Subtitle], "%", "%25" )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='660' height='58' viewBox='0 0 660 58' font-family='Segoe UI, Arial, sans-serif'><text x='0' y='26' font-size='24' font-weight='700' fill='%23333333'>Supply Chain P&%2338;L  |  Summary</text><text x='0' y='52' font-size='14' fill='%236B7280'>"
			    & _t
			    & "</text></svg>"
		displayFolder: 9 SVG Visuals
		lineageTag: 5c985023-5c87-4913-a89b-189eae1c7ef4
		dataCategory: ImageUrl

	measure 'SVG Refresh' =
			VAR _t = FORMAT ( [Last Refresh (UTC)], "dd-MMM-yyyy  hh:mm" ) & " UTC"
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='48' viewBox='0 0 200 48' font-family='Segoe UI, Arial, sans-serif'><text x='0' y='14' font-size='11' font-weight='600' fill='%236B7280'>Last Refresh Time:</text><text x='0' y='38' font-size='13' font-weight='700' fill='%23333333'>"
			    & _t
			    & "</text></svg>"
		displayFolder: 9 SVG Visuals
		lineageTag: 1e449398-4c5e-461a-9be4-72d5cd832993
		dataCategory: ImageUrl

	measure 'Flag GP' = COUNTROWS ( FILTER ( VALUES ( Dim_OpCo[OpCo Code] ), [GP Margin Alert] = "Red" ) ) + 0
		formatString: 0
		displayFolder: 9 SVG Visuals
		lineageTag: fea6ce60-424d-4968-8420-669d30b111e3

	measure 'Flag EBITDA' = COUNTROWS ( FILTER ( VALUES ( Dim_OpCo[OpCo Code] ), [EBITDA Alert] = "Red" ) ) + 0
		formatString: 0
		displayFolder: 9 SVG Visuals
		lineageTag: 3c59061b-52c6-4936-97ff-bf879f69595d

	measure 'Flag Freight' = COUNTROWS ( FILTER ( VALUES ( Dim_OpCo[OpCo Code] ), [Freight Alert] = "Amber" ) ) + 0
		formatString: 0
		displayFolder: 9 SVG Visuals
		lineageTag: 054a45e9-4df6-45a8-9f4b-db76792f6f15

	measure 'Flag PPV' = COUNTROWS ( FILTER ( VALUES ( Dim_OpCo[OpCo Code] ), [PPV Alert] = "Amber" ) ) + 0
		formatString: 0
		displayFolder: 9 SVG Visuals
		lineageTag: e18cc8a6-cd77-4934-821a-740431f2ea1e

	measure 'Flag Recovery' = COUNTROWS ( FILTER ( VALUES ( Dim_OpCo[OpCo Code] ), [Recovery Alert] = "Red" ) ) + 0
		formatString: 0
		displayFolder: 9 SVG Visuals
		lineageTag: f0a14625-a8b9-4416-98d6-8822fbc2e6c8

	measure 'SVG Alert Strip' =
			VAR _0 = [Flag GP]
			VAR _0c = IF ( _0 = 0, "%231E8E3E", "%23C62828" )
			VAR _1 = [Flag EBITDA]
			VAR _1c = IF ( _1 = 0, "%231E8E3E", "%23C62828" )
			VAR _2 = [Flag Freight]
			VAR _2c = IF ( _2 = 0, "%231E8E3E", "%23E0A100" )
			VAR _3 = [Flag PPV]
			VAR _3c = IF ( _3 = 0, "%231E8E3E", "%23E0A100" )
			VAR _4 = [Flag Recovery]
			VAR _4c = IF ( _4 = 0, "%231E8E3E", "%23C62828" )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1374' height='34' viewBox='0 0 1374 34' font-family='Segoe UI, Arial, sans-serif'><rect x='0.5' y='0.5' width='1373' height='33' rx='8' fill='white' stroke='%23D0D7DE'/><text x='12' y='22' font-size='12' font-weight='700' fill='%23333333'>Alerts (OpCos flagged):</text>"
			    & "<circle cx='206' cy='17' r='6' fill='"
			    & _0c
			    & "'/><text x='218' y='22' font-size='11.5' fill='%23333333'>GP Margin decline &gt;1%25: "
			    & _0
			    & "</text>"
			    & "<circle cx='406' cy='17' r='6' fill='"
			    & _1c
			    & "'/><text x='418' y='22' font-size='11.5' fill='%23333333'>EBITDA negative: "
			    & _1
			    & "</text>"
			    & "<circle cx='566' cy='17' r='6' fill='"
			    & _2c
			    & "'/><text x='578' y='22' font-size='11.5' fill='%23333333'>Freight increase &gt;10%25: "
			    & _2
			    & "</text>"
			    & "<circle cx='766' cy='17' r='6' fill='"
			    & _3c
			    & "'/><text x='778' y='22' font-size='11.5' fill='%23333333'>PPV adverse &gt;5%25: "
			    & _3
			    & "</text>"
			    & "<circle cx='936' cy='17' r='6' fill='"
			    & _4c
			    & "'/><text x='948' y='22' font-size='11.5' fill='%23333333'>Recovery variance &gt;10%25: "
			    & _4
			    & "</text>"
			    & "<text x='1362' y='22' text-anchor='end' font-size='11' font-weight='700' fill='%23C62828'>SAMPLE DATA - illustrative</text></svg>"
		displayFolder: 9 SVG Visuals
		lineageTag: 645a7697-519f-460a-b327-c9d1250df2a8
		dataCategory: ImageUrl

	measure 'Latest Run ID' = MAX ( Refresh_Log[Run ID] )
		displayFolder: 8 Data Quality
		lineageTag: 211aad27-e32f-4160-ab9e-efb33a6260c5

	measure 'Critical Latest Run' =
			VAR _run = [Latest Run ID]
			RETURN CALCULATE ( COUNTROWS ( DQ_Exceptions ), DQ_Exceptions[Run ID] = _run, DQ_Exceptions[Severity] = "Critical" ) + 0
		formatString: 0
		displayFolder: 8 Data Quality
		lineageTag: ac36d495-463b-4f2f-ba63-db37c22b4824

	measure 'Warnings Latest Run' =
			VAR _run = [Latest Run ID]
			RETURN CALCULATE ( COUNTROWS ( DQ_Exceptions ), DQ_Exceptions[Run ID] = _run, DQ_Exceptions[Severity] <> "Critical" ) + 0
		formatString: 0
		displayFolder: 8 Data Quality
		lineageTag: 32cc78dd-8461-4759-83d8-b879f791c088

	measure 'Published On Latest' =
			VAR _p = [Latest Published Period]
			RETURN CALCULATE ( MAX ( Publish_Control[Approved On] ), Publish_Control[Period] = _p )
		formatString: dd-mmm hh:nn
		displayFolder: 8 Data Quality
		lineageTag: dda1a9b7-806d-4164-8c10-d72a76fd2d00

	measure 'Missing OpCos Text' =
			VAR _p = [Latest Published Period]
			VAR _t =
			    CONCATENATEX (
			        FILTER ( Dim_OpCo, Dim_OpCo[Active] = "Y" && ISBLANK ( CALCULATE ( COUNTROWS ( Fact_SC_PL ), Dim_Date[Period] = _p, Dim_Scenario[Scenario] = "Actual" ) ) ),
			        Dim_OpCo[OpCo Code] & " " & Dim_OpCo[Country], ", " )
			RETURN IF ( _t = "", "None", _t )
		displayFolder: 8 Data Quality
		lineageTag: 4b475246-e7b1-4d0c-b972-c6665fdac785

	measure 'Actual Loaded' =
			VAR _p = [Latest Published Period]
			RETURN IF ( ISBLANK ( CALCULATE ( COUNTROWS ( Fact_SC_PL ), Dim_Date[Period] = _p, Dim_Scenario[Scenario] = "Actual" ) ), "✗", "✓" )
		displayFolder: 8 Data Quality
		lineageTag: bcde3995-f239-4cb4-945e-2ed97a755cc2

	measure 'Budget Loaded' =
			VAR _p = [Latest Published Period]
			RETURN IF ( ISBLANK ( CALCULATE ( COUNTROWS ( Fact_SC_PL ), Dim_Date[Period] = _p, Dim_Scenario[Scenario] = "Budget" ) ), "✗", "✓" )
		displayFolder: 8 Data Quality
		lineageTag: bc70cb5a-f275-4518-aa4b-c8e97762ba71

	measure 'Rows Latest' =
			VAR _p = [Latest Published Period]
			RETURN CALCULATE ( COUNTROWS ( Fact_SC_PL ), Dim_Date[Period] = _p, REMOVEFILTERS ( Dim_Scenario ) ) + 0
		formatString: #,0
		displayFolder: 8 Data Quality
		lineageTag: 40fd66ee-c632-4db3-91f1-d497d2200523

	measure 'Load Status' = IF ( [Actual Loaded] = "✓", "Loaded", "Missing" )
		displayFolder: 8 Data Quality
		lineageTag: f242ae8c-0c3a-457a-a3a5-cd5d0d65f709

	measure 'Rule Status' =
			VAR _r = SELECTEDVALUE ( DQ_Rules[Rule ID] )
			VAR _run = [Latest Run ID]
			VAR _n = CALCULATE ( COUNTROWS ( DQ_Exceptions ), DQ_Exceptions[Rule ID] = _r, DQ_Exceptions[Run ID] = _run )
			VAR _c = CALCULATE ( COUNTROWS ( DQ_Exceptions ), DQ_Exceptions[Rule ID] = _r, DQ_Exceptions[Run ID] = _run, DQ_Exceptions[Severity] = "Critical" )
			RETURN IF ( ISBLANK ( _r ), BLANK (), IF ( _c > 0, "✗ Fail", IF ( _n > 0, "● Warning", "● Pass" ) ) )
		displayFolder: 8 Data Quality
		lineageTag: a8e20b11-9fb4-47ae-b39c-3e1939b32db2

	measure 'Rule Exceptions' =
			VAR _r = SELECTEDVALUE ( DQ_Rules[Rule ID] )
			VAR _run = [Latest Run ID]
			RETURN IF ( ISBLANK ( _r ), BLANK (), CALCULATE ( COUNTROWS ( DQ_Exceptions ), DQ_Exceptions[Rule ID] = _r, DQ_Exceptions[Run ID] = _run ) + 0 )
		formatString: 0
		displayFolder: 8 Data Quality
		lineageTag: a007c65c-feb0-4735-a123-8c21f6877a8f

	measure 'SVG DQ Tiles' =
			VAR _v0 = SUBSTITUTE ( FORMAT ( [Last Refresh (UTC)], "dd-MMM-yyyy hh:mm" ), "%", "%25" )
			VAR _s0 = SUBSTITUTE ( "UTC  |  Run " & [Latest Run ID], "%", "%25" )
			VAR _c0 = "%231E8E3E"
			VAR _v1 = SUBSTITUTE ( [Latest Month Published], "%", "%25" )
			VAR _s1 = SUBSTITUTE ( "Published by Admin " & FORMAT ( [Published On Latest], "dd-MMM hh:mm" ), "%", "%25" )
			VAR _c1 = "%23008F94"
			VAR _v2 = SUBSTITUTE ( IF ( [Critical Latest Run] > 0, "FAILED", "PASSED" ), "%", "%25" )
			VAR _s2 = SUBSTITUTE ( [Critical Latest Run] & " critical  |  " & [Warnings Latest Run] & " warnings reviewed", "%", "%25" )
			VAR _c2 = IF ( [Critical Latest Run] > 0, "%23C62828", IF ( [Warnings Latest Run] > 0, "%23E0A100", "%231E8E3E" ) )
			VAR _v3 = SUBSTITUTE ( [OpCos Loaded] & " / " & [OpCos Expected], "%", "%25" )
			VAR _s3 = SUBSTITUTE ( "Missing: " & [Missing OpCos Text], "%", "%25" )
			VAR _c3 = IF ( [OpCos Loaded] < [OpCos Expected], "%23E0A100", "%231E8E3E" )
			VAR _v4 = SUBSTITUTE ( FORMAT ( [Records Loaded (Latest)], "#,0" ), "%", "%25" )
			VAR _s4 = SUBSTITUTE ( "Actual + Budget  |  " & [Latest Month Published], "%", "%25" )
			VAR _c4 = "%23008F94"
			VAR _v5 = SUBSTITUTE ( FORMAT ( [Data Completeness %], "0.0%" ), "%", "%25" )
			VAR _s5 = SUBSTITUTE ( "Target 100% of active OpCos", "%", "%25" )
			VAR _c5 = IF ( [Data Completeness %] < 1, "%23E0A100", "%231E8E3E" )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1608' height='110' viewBox='0 0 1608 110' font-family='Segoe UI, Arial, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='257' height='109' rx='10' fill='white' stroke='%23D0D7DE'/><rect x='4' y='0.5' width='250' height='6' fill='"
			    & _c0
			    & "'/><text x='14' y='30' font-size='12' font-weight='600' fill='%236B7280'>Last successful refresh</text><text x='14' y='66' font-size='24' font-weight='700' fill='%23333333'>"
			    & _v0
			    & "</text><text x='14' y='94' font-size='11' fill='%236B7280'>"
			    & _s0
			    & "</text>"
			    & "<rect x='270.5' y='0.5' width='257' height='109' rx='10' fill='white' stroke='%23D0D7DE'/><rect x='274' y='0.5' width='250' height='6' fill='"
			    & _c1
			    & "'/><text x='284' y='30' font-size='12' font-weight='600' fill='%236B7280'>Reporting month</text><text x='284' y='66' font-size='24' font-weight='700' fill='%23333333'>"
			    & _v1
			    & "</text><text x='284' y='94' font-size='11' fill='%236B7280'>"
			    & _s1
			    & "</text>"
			    & "<rect x='540.5' y='0.5' width='257' height='109' rx='10' fill='white' stroke='%23D0D7DE'/><rect x='544' y='0.5' width='250' height='6' fill='"
			    & _c2
			    & "'/><text x='554' y='30' font-size='12' font-weight='600' fill='%236B7280'>Validation status</text><text x='554' y='66' font-size='24' font-weight='700' fill='%23333333'>"
			    & _v2
			    & "</text><text x='554' y='94' font-size='11' fill='%236B7280'>"
			    & _s2
			    & "</text>"
			    & "<rect x='810.5' y='0.5' width='257' height='109' rx='10' fill='white' stroke='%23D0D7DE'/><rect x='814' y='0.5' width='250' height='6' fill='"
			    & _c3
			    & "'/><text x='824' y='30' font-size='12' font-weight='600' fill='%236B7280'>OpCos loaded</text><text x='824' y='66' font-size='24' font-weight='700' fill='%23333333'>"
			    & _v3
			    & "</text><text x='824' y='94' font-size='11' fill='%236B7280'>"
			    & _s3
			    & "</text>"
			    & "<rect x='1080.5' y='0.5' width='257' height='109' rx='10' fill='white' stroke='%23D0D7DE'/><rect x='1084' y='0.5' width='250' height='6' fill='"
			    & _c4
			    & "'/><text x='1094' y='30' font-size='12' font-weight='600' fill='%236B7280'>Records loaded</text><text x='1094' y='66' font-size='24' font-weight='700' fill='%23333333'>"
			    & _v4
			    & "</text><text x='1094' y='94' font-size='11' fill='%236B7280'>"
			    & _s4
			    & "</text>"
			    & "<rect x='1350.5' y='0.5' width='257' height='109' rx='10' fill='white' stroke='%23D0D7DE'/><rect x='1354' y='0.5' width='250' height='6' fill='"
			    & _c5
			    & "'/><text x='1364' y='30' font-size='12' font-weight='600' fill='%236B7280'>Data completeness</text><text x='1364' y='66' font-size='24' font-weight='700' fill='%23333333'>"
			    & _v5
			    & "</text><text x='1364' y='94' font-size='11' fill='%236B7280'>"
			    & _s5
			    & "</text>"
			    & "</svg>"
		displayFolder: 9 SVG Visuals
		lineageTag: 2ce948d4-2ae6-4f1e-b4c2-2bbec8773384
		dataCategory: ImageUrl

	column Dummy
		dataType: string
		isHidden
		lineageTag: 142970c9-abbe-47ba-ae1d-91e99ecf5559
		summarizeBy: none
		sourceColumn: Dummy

		annotation SummarizationSetBy = User

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Dummy = text], {})
				in
				    Source

	annotation PBI_ResultType = Table

