	measure 'P&L Row Value' =
			VAR _type = SELECTEDVALUE ( PL_Layout[Row Type] )
			VAR _key = SELECTEDVALUE ( PL_Layout[Key] )
			RETURN
			    SWITCH (
			        TRUE (),
			        _type = "Account" && _key IN { "PURCH_PAIRS", "PROD_PAIRS" }, CALCULATE ( [Pairs], Dim_Account[Account Code] = _key ),
			        _type = "Account", CALCULATE ( [Amount USD], Dim_Account[Account Code] = _key ),
			        _key = "Total Pairs", [Total Pairs],
			        _key = "Gross Margin %", [Gross Margin %],
			        _key = "Channel Cost %", [Channel Cost %],
			        _key = "Channel Operating Margin %", [Channel Operating Margin %],
			        _key = "EBITDA", [EBITDA],
			        _key = "EBITDA Margin %", [EBITDA Margin %],
			        _key = "EBIT BNRI", [EBIT BNRI],
			        _key = "EBIT BNRI Margin %", [EBIT BNRI Margin %],
			        _key = "EBIT", [EBIT],
			        _key = "EBIT Margin %", [EBIT Margin %]
			    )
		displayFolder: 5 Detailed P&L
		lineageTag: 6c2c3238-6fdd-42da-9b80-90084c087542

		formatStringDefinition = IF ( SELECTEDVALUE ( PL_Layout[Format] ) = "%", "0.0%", "#,0" )

	measure 'P&L Actual' =
			VAR _p = [Reporting Period]
			VAR _per = SELECTEDVALUE ( 'Period Mode'[Period], "Monthly" )
			RETURN
			    CALCULATE (
			        [P&L Row Value],
			        'CG Scenario'[Comparison] = "Actual",
			        'CG Period'[Period] = _per,
			        FILTER ( ALL ( Dim_Date ), Dim_Date[Period] = _p )
			    )
		displayFolder: 5 Detailed P&L
		lineageTag: 05c9d6e0-29dd-4713-929f-225112717128

		formatStringDefinition = IF ( SELECTEDVALUE ( PL_Layout[Format] ) = "%", "0.0%", "#,0" )

	measure 'P&L Budget' =
			VAR _p = [Reporting Period]
			VAR _per = SELECTEDVALUE ( 'Period Mode'[Period], "Monthly" )
			RETURN
			    CALCULATE (
			        [P&L Row Value],
			        'CG Scenario'[Comparison] = "Budget",
			        'CG Period'[Period] = _per,
			        FILTER ( ALL ( Dim_Date ), Dim_Date[Period] = _p )
			    )
		displayFolder: 5 Detailed P&L
