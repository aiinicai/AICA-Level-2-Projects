	measure 'NT | Monthly' =
			VAR _p = [Reporting Period]
			RETURN
			    CALCULATE (
			        [Net Turnover SC],
			        'CG Scenario'[Comparison] = "Actual",
			        'CG Period'[Period] = "Monthly",
			        FILTER ( ALL ( Dim_Date ), Dim_Date[Period] = _p )
			    )
		formatString: #,0.00
		displayFolder: 4 Summary Cards
		lineageTag: 95c6df5b-3a18-4e69-ad46-efc835e75e46

	measure 'NT | vs Bud' =
