table _Measures
	lineageTag: 44679a24-68de-422b-a36a-7c16217b789b

	measure 'Amount USD' =
			IF (
			    HASONEVALUE ( Dim_Scenario[Scenario] ),
			    SUM ( Fact_SC_PL[Amount USD] ),
			    CALCULATE ( SUM ( Fact_SC_PL[Amount USD] ), Dim_Scenario[Scenario] = "Actual" )
			)
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: 4702c88d-bef8-4ad7-a93a-b4b5a6cf760d

	measure Pairs =
			IF (
			    HASONEVALUE ( Dim_Scenario[Scenario] ),
			    SUM ( Fact_SC_PL[Volume Pairs] ),
			    CALCULATE ( SUM ( Fact_SC_PL[Volume Pairs] ), Dim_Scenario[Scenario] = "Actual" )
			)
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: 042dbd3c-0924-42f7-aadb-1610c54e6645

	measure 'Latest Published Period' = CALCULATE ( MAX ( Publish_Control[Period] ), Publish_Control[Status] = "Published", Publish_Control[Scenario] = "Actual" )
		formatString: 0
		displayFolder: 1 Base
		lineageTag: 33a20172-20e3-4d61-a221-58e86bf83f5e

	measure 'Reporting Period' =
			VAR _lp = [Latest Published Period]
			VAR _mx = MAX ( Dim_Date[Period] )
			RETURN IF ( ISBLANK ( _lp ), _mx, MIN ( _lp, _mx ) )
		formatString: 0
		displayFolder: 1 Base
		lineageTag: b2839b80-79c5-478a-978b-88edd1eaf774

	measure 'Reporting Month' =
			VAR _p = [Reporting Period]
			RETURN FORMAT ( DATE ( INT ( _p / 100 ), MOD ( _p, 100 ), 1 ), "MMMM yyyy" )
		displayFolder: 1 Base
		lineageTag: 153dbf62-d61e-489c-9328-bf427c12c701

	measure 'Report Subtitle' =
			VAR _scope =
			    SWITCH (
			        TRUE (),
			        ISFILTERED ( Dim_OpCo[OpCo Name] ), CONCATENATEX ( VALUES ( Dim_OpCo[OpCo Name] ), Dim_OpCo[OpCo Name], ", " ),
			        ISFILTERED ( Dim_OpCo[Country] ), CONCATENATEX ( VALUES ( Dim_OpCo[Country] ), Dim_OpCo[Country], ", " ),
			        ISFILTERED ( Dim_OpCo[Region] ), CONCATENATEX ( VALUES ( Dim_OpCo[Region] ), Dim_OpCo[Region], ", " ),
			        "Group - Total Business Unit"
			    )
			RETURN _scope & " - " & [Reporting Month] & "   |   All financial values in USD   |   SAMPLE DATA"
		displayFolder: 1 Base
		lineageTag: bb8e09f2-7391-4250-a3d1-50e58fd513d9

	measure 'Purchase Pairs' = CALCULATE ( [Pairs], Dim_Account[Account Code] = "PURCH_PAIRS" )
		formatString: #,0
		displayFolder: 2 P&L Lines
		lineageTag: d4b51386-d5b2-4553-bd49-696eac9e573d

	measure 'Production Pairs' = CALCULATE ( [Pairs], Dim_Account[Account Code] = "PROD_PAIRS" )
		formatString: #,0
