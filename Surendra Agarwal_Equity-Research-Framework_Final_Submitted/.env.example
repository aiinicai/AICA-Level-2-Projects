# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.

# --- AI provider (Milestone 6) ---
# Two interchangeable providers are supported — configure either or
# both. If BOTH are set, Gemini is tried FIRST and OpenAI is used only
# as an automatic fallback if a live Gemini call fails (e.g. free-tier
# rate limit exceeded) — see get_default_llm_client() in
# app/ai/llm_client.py. This lets a capstone evaluator run entirely on
# Gemini's free tier without needing or being billed against anyone
# else's OpenAI key.

# Google Gemini (recommended for evaluation/free-tier use — get a key
# at https://aistudio.google.com, no credit card required for the free
# tier). Free tier is Flash/Flash-Lite models only, and free-tier
# content is used by Google to improve their products — fine for public
# documents (e.g. a company's published annual report), NOT recommended
# for confidential/proprietary documents; use the paid tier for those.
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Google retires/restricts specific model IDs for new API keys fast —
# if you get a 404 "no longer available to new users" error, check the
# current free-tier list at https://ai.google.dev/gemini-api/docs/pricing

# OpenAI (ChatGPT) API key. Optional if GOOGLE_API_KEY is set; used as
# an automatic fallback, or as the sole provider if GOOGLE_API_KEY is unset.
OPENAI_API_KEY=your_openai_api_key_here

# Model to use for OpenAI AI interpretation calls. Confirm current valid
# model strings at https://platform.openai.com/docs/models before
# deploying; do not assume this string remains current indefinitely.
OPENAI_MODEL=gpt-4o
# Delay (seconds) between sequential per-page LLM calls in batch
# extraction (risk/business/pledge). Reduces how often you hit your
# account's rate limit in the first place. Increase if you're on a
# lower-tier account and see frequent retries; 0 disables pacing entirely.
LLM_REQUEST_DELAY_SECONDS=0.5

# Max tokens for a single LLM completion call.
OPENAI_MAX_TOKENS=4096
GEMINI_MAX_TOKENS=4096

# --- Market data provider ---
# 'csv' (recommended, primary): loads from a pre-downloaded NSE
# historical-data CSV export (see app/data/market_data.py ->
# load_nse_csv_price_history / CSVPriceProvider). More reliable than a
# live network call and does not depend on Yahoo Finance's NSE coverage.
# 'yfinance': live download, no API key required, but has not yet been
# exercised against a live call in the development environment used to
# build this project — first live test happens on your machine.
# 'rediff': same-day snapshot-only fallback for get_current_price(); see
# RediffMoneyProvider's docstring for its scope limits.
MARKET_DATA_PROVIDER=csv
CSV_PRICE_HISTORY_PATH=./data/sample/SONACOMS_NSE_price_history.csv

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=./logs

# Directories (relative to project root unless absolute paths given)
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SAMPLE_DIR=./data/sample
REPORTS_DIR=./reports

# --- Investment score weighting (Module 9) ---
# Must sum to 1.0. Overridable without code changes.
WEIGHT_FUNDAMENTALS=0.30
WEIGHT_CASHFLOW_QUALITY=0.15
WEIGHT_BUSINESS_MANAGEMENT=0.15
WEIGHT_VALUATION=0.20
WEIGHT_TECHNICAL=0.10
WEIGHT_RISK_GOVERNANCE=0.10
